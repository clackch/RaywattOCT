<UserControl x:Class="RaywattOCTFFR.Common.Annotation.DrawLmodeUtil"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattOCTFFR.Common.Annotation"
             xmlns:const="clr-namespace:RaywattOCTFFR.Common.Bases"
             mc:Ignorable="d" 
             x:Name="UserControl"
             d:DesignHeight="180" d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="Canvas">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CommandType, ElementName=UserControl}" Value="1">
                    <Setter Property="Cursor" Value="{StaticResource measureArea}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CommandType, ElementName=UserControl}" Value="2">
                    <Setter Property="Cursor" Value="{StaticResource measureLength}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CommandType, ElementName=UserControl}" Value="3">
                    <Setter Property="Cursor" Value="{StaticResource measureText}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CommandType, ElementName=UserControl}" Value="4">
                    <Setter Property="Cursor" Value="{StaticResource measureErase}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Path" x:Key="StylePath">
            <Setter Property="StrokeThickness" Value="{Binding Zoom.ScaleY, Source={x:Reference UserControl}, Converter={StaticResource ScaleConverter}, ConverterParameter={x:Static const:Constants.AnnotationStrokeThickness}}"/>
        </Style>
        <Style TargetType="Label" x:Key="StyleLabel">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="{Binding Zoom.ScaleY, Source={x:Reference UserControl}, Converter={StaticResource ScaleConverter}, ConverterParameter=20}"/>
        </Style>
        <Style TargetType="Label" x:Key="StyleLabelText">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="{Binding Zoom.ScaleY, Source={x:Reference UserControl}, Converter={StaticResource ScaleConverter}, ConverterParameter=20}"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                        <Condition Binding="{Binding CommandType, ElementName=UserControl}" Value="0"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource Self}, Path=BorderBrush}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                        <Condition Binding="{Binding CommandType, ElementName=UserControl}" Value="4"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource Self}, Path=BorderBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Ellipse" x:Key="StyleEllipse">
            <Setter Property="Width" Value="{Binding Zoom.ScaleX, Source={x:Reference UserControl}, Converter={StaticResource ScaleConverter}, ConverterParameter={x:Static const:Constants.AnnotationTextPointSize}}"/>
            <Setter Property="Height" Value="{Binding Zoom.ScaleY, Source={x:Reference UserControl}, Converter={StaticResource ScaleConverter}, ConverterParameter={x:Static const:Constants.AnnotationTextPointSize}}"/>
            <Setter Property="StrokeThickness" Value="{Binding Zoom.ScaleY, Source={x:Reference UserControl}, Converter={StaticResource ScaleConverter}, ConverterParameter={x:Static const:Constants.AnnotationStrokeThickness}}"/>
            <Setter Property="Fill" Value="White"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                        <Condition Binding="{Binding CommandType, ElementName=UserControl}" Value="0"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="StrokeThickness" Value="{Binding Zoom.ScaleY, ElementName=UserControl, Converter={StaticResource ScaleConverter}, ConverterParameter={x:Static const:Constants.AnnotationStrokeThicknessBold}}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                        <Condition Binding="{Binding CommandType, ElementName=UserControl}" Value="4"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="StrokeThickness" Value="{Binding Zoom.ScaleY, ElementName=UserControl, Converter={StaticResource ScaleConverter}, ConverterParameter={x:Static const:Constants.AnnotationStrokeThicknessBold}}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox" x:Key="StyleTextBox">
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MaxLength" Value="50"/>
            <Setter Property="FontSize" Value="{Binding Zoom.ScaleY, Source={x:Reference UserControl}, Converter={StaticResource ScaleConverter}, ConverterParameter=20}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Canvas Name="canvas" Width="{x:Static const:Constants.LongitudeWidth}" Height="{x:Static const:Constants.LongitudeHeight}">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="{Binding Zoom.ScaleX, ElementName=UserControl}" ScaleY="{Binding Zoom.ScaleY, ElementName=UserControl}"/>
                </TransformGroup>
            </Canvas.RenderTransform>
        </Canvas>
    </Grid>
</UserControl>
