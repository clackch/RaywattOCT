<UserControl x:Class="RaywattOCTFFR.Views.Dialog.PasswordChangeDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:RaywattOCTFFR.Common.Behaviors"
             xmlns:local="clr-namespace:RaywattOCTFFR.Views.Dialog"
             xmlns:ut ="clr-namespace:RaywattOCTFFR.Common.Util"
             xmlns:const="clr-namespace:RaywattOCTFFR.Common.Bases"
             mc:Ignorable="d" 
             Width="{Binding DialogWidth}"
             Height="{Binding DialogHeight}">

    <Border CornerRadius="10" 
            Background="{DynamicResource GrayscaleGray6Brush}" 
            BorderBrush="{DynamicResource GrayscaleGray7Brush}" 
            Width="{x:Static const:Constants.PasswordChangeDialogWidth}" 
            Height="{x:Static const:Constants.PasswordChangeDialogHeight}">

        <StackPanel Margin="32,35,32,36">
            <Label Style="{DynamicResource Pretendard-Bold-32}" 
                   Foreground="{DynamicResource GrayscaleWhiteBrush}" 
                   Content="{Binding [PasswordChange], Source={StaticResource L10N}}"
                   HorizontalContentAlignment="Center"
                   HorizontalAlignment="Center"/>
            <StackPanel Height="20"/>

            <Label Style="{DynamicResource Pretendard-Medium-16}" 
                   Content="Current Password" 
                   Foreground="{DynamicResource GrayscaleWhiteBrush}"/>
            <StackPanel Height="6"/>
            <PasswordBox Style="{DynamicResource PasswordBoxValidator}"
                         MaxLength="50"
                         ut:PasswordBoxHelper.Attach="True"
                         ut:PasswordBoxHelper.BindablePassword="{Binding CurrentPassword}"
                         Background="Transparent"
                         Tag="{Binding [MSG_EnterCurrentPassword], Source={StaticResource L10N}}"/>
            <StackPanel Height="4"/>
            <Separator Height="1" Background="{DynamicResource VerticalSeparatorBrush}"/>
            <StackPanel Height="24"/>

            <Label Style="{DynamicResource Pretendard-Medium-16}" 
                   Content="New Password" 
                   Foreground="{DynamicResource GrayscaleWhiteBrush}"/>
            <StackPanel Height="6"/>
            <PasswordBox Style="{DynamicResource PasswordBoxValidator}"
                         MaxLength="50"
                         ut:PasswordBoxHelper.Attach="True"
                         ut:PasswordBoxHelper.BindablePassword="{Binding NewPassword}"
                         Background="Transparent"
                         Tag="{Binding [MSG_EnterNewPassword], Source={StaticResource L10N}}"/>
            <StackPanel Height="8"/>

            <Label Style="{DynamicResource Pretendard-Medium-16}" 
                   Content="Confirm Password" 
                   Foreground="{DynamicResource GrayscaleWhiteBrush}"/>
            <StackPanel Height="6"/>
            <PasswordBox Style="{DynamicResource PasswordBoxValidator}"
                         MaxLength="50"
                         ut:PasswordBoxHelper.Attach="True"
                         ut:PasswordBoxHelper.BindablePassword="{Binding ConfirmPassword}"
                         Background="Transparent"
                         Tag="{Binding [MSG_ConfirmNewPassword], Source={StaticResource L10N}}"/>

            <Label Style="{DynamicResource Pretendard-Medium-12}" 
               Foreground="{DynamicResource AdditionalColor3Brush}">
                <TextBlock Text="{Binding [MSG_PasswordRequirement], Source={StaticResource L10N}}"
               TextWrapping="Wrap"/>
            </Label>
            <StackPanel Height="28"/>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource OutlinedBtnType3-Large}" 
                        Command="{Binding CancelCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
                        Content="{Binding [Cancel], Source={StaticResource L10N}}"/>
                <StackPanel Width="8"/>
                <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" 
                        Command="{Binding OkCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
                        Content="{Binding [OK], Source={StaticResource L10N}}"/>
            </StackPanel>
        </StackPanel>

    </Border>
</UserControl>
