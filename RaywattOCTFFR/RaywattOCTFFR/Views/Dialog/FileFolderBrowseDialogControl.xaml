<UserControl x:Class="RaywattOCTFFR.Views.Dialog.FileFolderBrowseDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:model="clr-namespace:RaywattOCTFFR.Common.Util"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:RaywattOCTFFR.Common.Behaviors"
             xmlns:const="clr-namespace:RaywattOCTFFR.Common.Bases"
             xmlns:local="clr-namespace:RaywattOCTFFR.Views.Dialog"
             mc:Ignorable="d" 
             Width="{Binding DialogWidth}" Height="{Binding DialogHeight}">

    <Border CornerRadius="10" Background="{DynamicResource GrayscaleGray6Brush}" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray7Brush}" Width="{x:Static const:Constants.FileFolderBrowseDialogWidth}" Height="{x:Static const:Constants.FileFolderBrowseDialogHeight}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="31"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="31"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="58"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="375"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="77"/>
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center">
                <Label Style="{DynamicResource Pretendard-Bold-32}" Content="{Binding [Select Folder], Source={StaticResource L10N}}" Foreground="{DynamicResource GrayscaleWhiteBrush}"/>
            </StackPanel>

            <Border Grid.Row="2" Grid.Column="1" CornerRadius="8,8,0,0" Background="{DynamicResource GrayscaleGray8Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource OutlinedBtnType1-Small-Medium}" HorizontalAlignment="Left" Margin="12,0,0,0" Foreground="{DynamicResource GrayscaleWhiteBrush}" Command="{Binding FolderActionCommand}" CommandParameter="{x:Static const:Constants.FolderActionCreate}" Content="{Binding [New Folder], Source={StaticResource L10N}}" IsEnabled="{Binding SelectedDir, Converter={StaticResource NotNullToEnableConverter}}"/>
                    <Button Grid.Column="1" Style="{StaticResource OutlinedBtnType1-Small-Short}" HorizontalAlignment="Right" Margin="0,0,12,0" Foreground="{DynamicResource GrayscaleWhiteBrush}" Command="{Binding FolderActionCommand}" CommandParameter="{x:Static const:Constants.FolderActionRename}" Content="{Binding [Rename], Source={StaticResource L10N}}" IsEnabled="{Binding SelectedDir, Converter={StaticResource NotNullToEnableConverter}, ConverterParameter=Rename}"/>
                </Grid>
            </Border>

            <Separator Grid.Row="3" Grid.ColumnSpan="3" Background="{DynamicResource GrayscaleGray5Brush}" Width="408" Height="1"/>
            
            <TreeView Grid.Row="4" Grid.Column="1" ItemsSource="{Binding DirItems}">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type model:DirectoryItem}" ItemsSource="{Binding Path=Items, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock Text="{Binding Path=Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="10,6,10,6"/>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
                <i:Interaction.Behaviors>
                    <behaviors:BindableSelectedItemBehavior SelectedItem="{Binding SelectedDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </i:Interaction.Behaviors>
            </TreeView>

            <Grid Grid.Row="6" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Folder], Source={StaticResource L10N}}"/>
                <TextBox Grid.Column="2" Style="{DynamicResource TextBoxReadOnly}" Text="{Binding SelectedDir.Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal"  VerticalAlignment="Top">
                <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding NoCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [Cancel], Source={StaticResource L10N}}"/>
                <StackPanel Width="8"/>
                <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Command="{Binding YesCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [OK], Source={StaticResource L10N}}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
