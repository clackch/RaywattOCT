<UserControl x:Class="RaywattOCTFFR.Views.Dialog.DicomServerDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:const="clr-namespace:RaywattOCTFFR.Common.Bases"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:component="clr-namespace:RaywattOCTFFR.Views.Component"
             mc:Ignorable="d" 
             Width="{Binding DialogWidth}" Height="{Binding DialogHeight}">
    
    <Border CornerRadius="10" Background="{DynamicResource GrayscaleGray6Brush}" Width="{x:Static const:Constants.DicomServerDialogWidth}" Height="{x:Static const:Constants.DicomServerDialogHeight}">
        <Grid IsEnabled="{Binding IsChecking, Converter={StaticResource BoolToEnableReverseConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="409"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="82"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="30,44,30,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [DICOM Server], Source={StaticResource L10N}}"/>
                <component:IconButton Grid.Row="0" Grid.Column="2" Style="{DynamicResource IconButton}" Icon="deletePopup" Command="{Binding DeleteCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" HorizontalAlignment="Right" Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                <Label Grid.Row="2" Grid.Column="0" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [AE Title], Source={StaticResource L10N}}"/>
                <TextBox Grid.Row="3" Grid.Column="0" Style="{DynamicResource TextBoxValidator}" MaxLength="50" Text="{Binding AeTitle.Text, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [Enter AE Title], Source={StaticResource L10N}}" ToolTip="{Binding AeTitle.Msg}" Width="390"/>
                <Label Grid.Row="4" Grid.Column="0" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Hostname], Source={StaticResource L10N}}"/>
                <Grid Grid.Row="5" Grid.Column="0">
                    <Border Height="54" CornerRadius="8" BorderBrush="{DynamicResource GrayscaleGray5Brush}" BorderThickness="1" VerticalAlignment="Top"/>
                    <Grid Visibility="{Binding DicomServer.SpecifyIpAddress, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                        <TextBox Style="{DynamicResource TextBoxValidator}" MaxLength="50" Text="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [Enter Hostname], Source={StaticResource L10N}}" ToolTip="{Binding HostnameMsg}" Width="390" VerticalAlignment="Top">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding UpdateHostnameCommand}"/>
                            </TextBox.InputBindings>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="LostKeyboardFocus">
                                    <i:InvokeCommandAction Command="{Binding UpdateHostnameCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                    </Grid>
                </Grid>
                <CheckBox Grid.Row="4" Grid.Column="2" IsChecked="{Binding DicomServer.SpecifyIpAddress}" Content="{Binding [Specify IP Address], Source={StaticResource L10N}}" Margin="0,-7,0,0"/>
                <Grid Grid.Row="5" Grid.Column="2">
                    <Grid>
                        <component:IpAddressInputControl IsEnabled="{Binding DicomServer.SpecifyIpAddress}" IpAddress="{Binding IpAddress}" ToolTip="{Binding IpAddress.Msg}"/>
                    </Grid>
                </Grid>
                <Label Grid.Row="6" Grid.Column="0" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Port], Source={StaticResource L10N}}"/>
                <TextBox Grid.Row="7" Grid.Column="0" Style="{DynamicResource TextBoxValidator}" MaxLength="10" Text="{Binding Port.Text, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [Enter Port], Source={StaticResource L10N}}" ToolTip="{Binding Port.Msg}" Width="390"/>
                <Label Grid.Row="6" Grid.Column="2" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Comment], Source={StaticResource L10N}}"/>
                <TextBox Grid.Row="7" Grid.Column="2" Style="{DynamicResource TextBoxValidator}" MaxLength="100" Text="{Binding DicomServer.Comment, UpdateSourceTrigger=PropertyChanged}" Width="390"/>
            </Grid>

            <ContentControl Template="{DynamicResource Loading}" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <Separator Grid.Row="1" Background="{DynamicResource GrayscaleGray5Brush}" Height="1"/>

            <Grid Grid.Row="2" Margin="30,0,30,0">
                <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding NoCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [Cancel], Source={StaticResource L10N}}" HorizontalAlignment="Left"/>
                <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Command="{Binding YesCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [Save], Source={StaticResource L10N}}" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
