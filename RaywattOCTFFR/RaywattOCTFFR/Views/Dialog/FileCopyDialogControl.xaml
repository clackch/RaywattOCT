<UserControl x:Class="RaywattOCTFFR.Views.Dialog.FileCopyDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattOCTFFR.Views.Dialog"
             xmlns:const="clr-namespace:RaywattOCTFFR.Common.Bases"
             mc:Ignorable="d" 
             Width="{Binding DialogWidth}" Height="{Binding DialogHeight}">

    <Border CornerRadius="10" Background="{DynamicResource GrayscaleGray6Brush}" BorderThickness="0" Width="{x:Static const:Constants.FileCopyDialogWidth}" Height="{x:Static const:Constants.FileCopyDialogHeight}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="21"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="62"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="66"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                <Label Style="{DynamicResource Pretendard-Medium-12}" Content="{Binding Title}" Foreground="{DynamicResource GrayscaleGray3Brush}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Style="{DynamicResource Pretendard-Medium-22}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Margin="20,0,20,0">
                    <Label.Content>
                        <AccessText TextWrapping="Wrap" Text="{Binding ProgressText}"/>
                    </Label.Content>
                </Label>
            </StackPanel>

            <StackPanel Grid.Row="3" VerticalAlignment="Center">
                <ProgressBar Value="{Binding Progress}" Width="412" Height="24"/>
            </StackPanel>

            <StackPanel Grid.Row="5" Visibility="{Binding IsSkipConfirmation, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                <Button Style="{StaticResource ContainedBtnType1-Large-Short}" Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibilityConverter}}" IsEnabled="{Binding EnableDone}" Command="{Binding OKCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [OK], Source={StaticResource L10N}}"/>
                <Button Style="{StaticResource ContainedBtnType1-Large-Short}" Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibilityReverseConverter}}" IsEnabled="{Binding EnableDone}" Command="{Binding NoCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [OK], Source={StaticResource L10N}}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
