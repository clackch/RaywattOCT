<UserControl x:Class="RaywattOCTFFR.Views.Dialog.CathRoomDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattOCTFFR.Views.Dialog"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"                
             xmlns:behaviors="clr-namespace:RaywattOCTFFR.Common.Behaviors"
             xmlns:const="clr-namespace:RaywattOCTFFR.Common.Bases"
             mc:Ignorable="d" 
             Width="{Binding DialogWidth}" Height="{Binding DialogHeight}">

    <Border CornerRadius="10" Background="{DynamicResource GrayscaleGray6Brush}" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray7Brush}" Width="{x:Static const:Constants.CathRoomDialogWidth}" Height="{x:Static const:Constants.CathRoomDialogHeight}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="31"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="31"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="274"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="71"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center">
                <Label Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Select Cath Room], Source={StaticResource L10N}}"/>
            </StackPanel>

            <DataGrid Grid.Row="2" Grid.Column="1" Name="cathRoomList" ItemsSource="{Binding CathRoomList}" SelectedItem="{Binding SelectedCathRoom}" Style="{StaticResource DataGridDialog}" RowStyle="{StaticResource DataGridRowDialog}" ColumnHeaderStyle="{StaticResource DataGridColumnHeaderDialog}" SelectionMode="Single" Height="274">
                <i:Interaction.Behaviors>
                    <behaviors:DataGridLoadedBehavior />
                </i:Interaction.Behaviors>
                <DataGrid.Columns>
                    <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" Width="*" Binding="{Binding Name}" Header="{Binding [Name], Source={StaticResource L10N}}"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding NoCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [Cancel], Source={StaticResource L10N}}"/>
                <StackPanel Width="8"/>
                <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Command="{Binding YesCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [OK], Source={StaticResource L10N}}" IsEnabled="{Binding SelectedCathRoom, Converter={StaticResource NotNullToEnableConverter}}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
