<UserControl x:Class="RaywattOCTFFR.Views.Dialog.TermsConditionsControl_RV200"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattOCTFFR.Views.Dialog"
             xmlns:const="clr-namespace:RaywattOCTFFR.Common.Bases"
             mc:Ignorable="d" 
             Width="{Binding DialogWidth}" Height="{Binding DialogHeight}">
    <Border Width="{x:Static const:Constants.TermsConditionsDialogWidth}"  Height="{x:Static const:Constants.TermsConditionsDialogHeight}" CornerRadius="10,10,10,10" BorderThickness="0" BorderBrush="Transparent" Background="{DynamicResource GrayscaleGray6Brush}">
        <Grid Width="800">
            <Grid.RowDefinitions>
                <RowDefinition Height="112"/>
                <RowDefinition/>
                <RowDefinition Height="86"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,50,0,0">
                <Label Style="{DynamicResource Pretendard-Bold-32}" Content="{Binding [Terms and Conditions], Source={StaticResource L10N}}" Foreground="{StaticResource GrayscaleWhiteBrush}"/>
            </StackPanel>

            <Border Grid.Row="1" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray7Brush}" Background="{DynamicResource GrayscaleGray8Brush}">
                <TextBox Style="{StaticResource TextBoxReadOnly}" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible" Text="{Binding TermsAndConditions}" Foreground="{StaticResource GrayscaleGray3Brush}" Margin="20,20,5,20"/>
            </Border>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,20,20,0">
                    <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray1Brush}">
                        <Label.Content>
                            <AccessText TextWrapping="Wrap" Text="{Binding [Institute Name], Source={StaticResource L10N}}"/>
                        </Label.Content>
                    </Label>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{DynamicResource TextBoxValidator}" Width="600" MaxLength="50" Text="{Binding TermsConditions.Buffer, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [Enter Institute Name], Source={StaticResource L10N}}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Separator Grid.Row="3" VerticalAlignment="Top" Background="{StaticResource GrayscaleGray5Brush}"/>

            <Grid Grid.Row="4" VerticalAlignment="Top">
                <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding NoCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [Decline], Source={StaticResource L10N}}" HorizontalAlignment="Left"/>
                <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Command="{Binding YesCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [Accept], Source={StaticResource L10N}}" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
