<UserControl x:Class="RaywattOCTFFR.Views.Dialog.NewPatientDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattOCTFFR.Views.Dialog"
             xmlns:const="clr-namespace:RaywattOCTFFR.Common.Bases"
             mc:Ignorable="d" 
             Width="{Binding DialogWidth}" Height="{Binding DialogHeight}">

    <Border CornerRadius="10" Background="{DynamicResource GrayscaleGray6Brush}" BorderThickness="0" Width="{x:Static const:Constants.NewPatientDialogWidth}" Height="{x:Static const:Constants.NewPatientDialogHeight}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="15"/>
                <RowDefinition/>
                <RowDefinition Height="84"/>
                <RowDefinition Height="66"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                <Label Style="{DynamicResource Pretendard-Medium-12}" Content="Information" Foreground="{DynamicResource GrayscaleGray3Brush}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="80,32,80,0">
                <Label Style="{DynamicResource Pretendard-Medium-22}" Foreground="{DynamicResource GrayscaleWhiteBrush}" TextBlock.TextAlignment="Center">
                    <Label.Content>
                        <AccessText TextWrapping="Wrap" Text="Select a method to add a patient"/>
                    </Label.Content>
                </Label>
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <RadioButton IsChecked="{Binding IsManual}" Content="{Binding [Manual], Source={StaticResource L10N}}"/>
                </StackPanel>
                <StackPanel Margin="27,0,0,0">
                    <RadioButton IsChecked="{Binding IsManual, Converter={StaticResource BoolToEnableReverseConverter}}" Content="{Binding [DICOM Server], Source={StaticResource L10N}}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Button Style="{StaticResource OutlinedBtnType3-Large}" Width="150" Command="{Binding NoCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [Cancel], Source={StaticResource L10N}}"/>
                <StackPanel Width="8"/>
                <Button Style="{StaticResource ContainedBtnType1-Large-Short}" Command="{Binding YesCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [OK], Source={StaticResource L10N}}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
