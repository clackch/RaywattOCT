<Page x:Class="RaywattOCTFFR.Views.Setting.SettingDicomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RaywattOCTFFR.Views.Setting"
      xmlns:const="clr-namespace:RaywattOCTFFR.Common.Bases"
      mc:Ignorable="d" 
      Width="{x:Static const:Constants.SettingInsideDialogWidth}" Height="{x:Static const:Constants.SettingInsideDialogHeight}"
      Title="SettingDicomPage">

    <Grid>
        <Border Grid.Row="0" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray7Brush}" Background="{DynamicResource GrayscaleGray8Brush}">
            <StackPanel Margin="28,24,28,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="{Binding [Local Host Info.], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Style="{StaticResource OutlinedBtnType3}" Width="100" Height="26" Command="{Binding LocalHostEditCommand}" Content="{Binding [Edit], Source={StaticResource L10N}}" IsEnabled="{Binding IsEditLocalHost}" HorizontalAlignment="Right"/>
                </Grid>
                <StackPanel Height="10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="17"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="17"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Column="0" Grid.Row="0" Content="{Binding [AE Title], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray3Brush}"/>
                    <Label Grid.Column="0" Grid.Row="2" Content="{Binding LocalHost.AeTitle}" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}"/>
                    <Label Grid.Column="1" Grid.Row="0" Content="{Binding [Hostname], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray3Brush}"/>
                    <Label Grid.Column="1" Grid.Row="2" Content="{Binding LocalHost.Hostname}" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}"/>
                    <Label Grid.Column="2" Grid.Row="0" Content="{Binding [IP], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray3Brush}"/>
                    <Label Grid.Column="2" Grid.Row="2" Content="{Binding LocalHost.IpAddress}" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}"/>
                </Grid>
                <StackPanel Height="28"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="{Binding [DICOM Servers], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Style="{StaticResource OutlinedBtnType3}" Width="100" Height="26" Command="{Binding DicomServerAddCommand}" Content="{Binding [Add], Source={StaticResource L10N}}" IsEnabled="{Binding IsEditDicomServer}" HorizontalAlignment="Right"/>
                </Grid>
                <StackPanel Height="8"/>
                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray5Brush}">
                    <Grid>
                        <DataGrid Height="312" Name="dicomServers" ItemsSource="{Binding DicomServers}" Style="{StaticResource DataGridDialogSmall}" RowStyle="{StaticResource DataGridRowDialog}" ColumnHeaderStyle="{StaticResource DataGridColumnHeaderDialogSmall}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DicomServerEditCommand}" CommandParameter="{Binding ElementName=dicomServers, Path=CurrentItem}"/>
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" MinWidth="100" Binding="{Binding AeTitle}" Header="{Binding [AE Title], Source={StaticResource L10N}}"/>
                                <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" MinWidth="100" Binding="{Binding Hostname}" Header="{Binding [Hostname], Source={StaticResource L10N}}" />
                                <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" MinWidth="80" Binding="{Binding IpAddress}" Header="{Binding [IP], Source={StaticResource L10N}}" />
                                <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" MinWidth="80" Binding="{Binding Port}" Header="{Binding [Port], Source={StaticResource L10N}}" />
                                <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" MinWidth="70" Binding="{Binding ServerType}" Header="{Binding [Server Type], Source={StaticResource L10N}}" />
                                <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" MinWidth="100" Binding="{Binding Comment}" Header="{Binding [Comment], Source={StaticResource L10N}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Page>
