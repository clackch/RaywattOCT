<Window x:Class="RaywattOCTFFR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:RaywattOCTFFR.Common.Behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RaywattOCTFFR"
        xmlns:component="clr-namespace:RaywattOCTFFR.Views.Component"
        xmlns:const="clr-namespace:RaywattOCTFFR.Common.Bases"
        ResizeMode="NoResize"
        WindowStyle="None"
        mc:Ignorable="d"
        Width="1920" Height="1080" Cursor="{DynamicResource arrow}" Left="0" Top="0">

    <Grid Width="1920">
        <Frame NavigationUIVisibility="Hidden">
            <b:Interaction.Behaviors>
                <behaviors:FrameBehavior Parameter="{Binding NavigationParameter, Mode=TwoWay}" Navigation="{Binding NavigationSource, Mode=TwoWay}" />
            </b:Interaction.Behaviors>
        </Frame>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel HorizontalAlignment="Left">
                    <component:IconButton Style="{DynamicResource IconButtonLarge}" Icon="home" Margin="14,9,0,9" Command="{Binding HomeCommand}" Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <component:IconButton Style="{DynamicResource IconButtonLarge}" Icon="setting" Margin="0,9,6,9" Command="{Binding SettingCommand}" Visibility="{Binding IsSetting, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                    <component:IconButton Style="{DynamicResource IconButtonLarge}" Icon="power" Margin="0,9,12,9" Command="{Binding ExitCommand}" Visibility="{Binding IsExit, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2">
                <Image Style="{DynamicResource RaywattSmall_Icon}"/>
            </Grid>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <component:MenuUnableComponent Grid.Column="0" Background="{StaticResource GrayscaleGray7Brush}" Opacity="0.7" IsSaveRawDataDone="{Binding DeviceStatus.IsSaveRawDataDone}" IsLumenLoaded="True" IsLumenSaved="{Binding DeviceStatus.IsLumenSaved}" IsOCTImagingDone="True" IsFfrCalculated="{Binding DeviceStatus.IsFfrCalculated}">
                    <component:MenuUnableComponent.Visibility>
                        <MultiBinding Converter="{StaticResource ComponentVisibilityConverter}">
                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsSaveRawDataDone"/>
                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsLumenLoaded"/>
                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsLumenSaved"/>
                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsOCTImagingDone"/>
                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsFfrCalculated"/>
                        </MultiBinding>
                    </component:MenuUnableComponent.Visibility>
                </component:MenuUnableComponent>
                <component:MenuUnableComponent Grid.Column="1" Background="{StaticResource GrayscaleGray7Brush}" Opacity="0.7" IsSaveRawDataDone="{Binding DeviceStatus.IsSaveRawDataDone}" IsLumenLoaded="{Binding DeviceStatus.IsLumenLoaded}" IsLumenSaved="{Binding DeviceStatus.IsLumenSaved}" IsOCTImagingDone="{Binding DeviceStatus.IsOCTImagingDone}" IsFfrCalculated="{Binding DeviceStatus.IsFfrCalculated}">
                    <component:MenuUnableComponent.Visibility>
                        <MultiBinding Converter="{StaticResource ComponentVisibilityConverter}">
                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsSaveRawDataDone"/>
                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsLumenLoaded"/>
                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsLumenSaved"/>
                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsOCTImagingDone"/>
                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsFfrCalculated"/>
                        </MultiBinding>
                    </component:MenuUnableComponent.Visibility>
                </component:MenuUnableComponent>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="16"/>
                </Grid.ColumnDefinitions>
                <component:MenuUnableComponent Grid.Column="0" Background="{StaticResource GrayscaleGray7Brush}" Opacity="0.7" IsSaveRawDataDone="{Binding DeviceStatus.IsSaveRawDataDone}" IsLumenLoaded="{Binding DeviceStatus.IsLumenLoaded}" IsLumenSaved="{Binding DeviceStatus.IsLumenSaved}" IsOCTImagingDone="{Binding DeviceStatus.IsOCTImagingDone}" IsFfrCalculated="{Binding DeviceStatus.IsFfrCalculated}">
                    <component:MenuUnableComponent.Visibility>
                        <MultiBinding Converter="{StaticResource ComponentVisibilityConverter}">
                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsSaveRawDataDone"/>
                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsLumenLoaded"/>
                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsLumenSaved"/>
                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsOCTImagingDone"/>
                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsFfrCalculated"/>
                        </MultiBinding>
                    </component:MenuUnableComponent.Visibility>
                </component:MenuUnableComponent>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="26"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <component:MenuUnableComponent Grid.Row="0" Background="{StaticResource GrayscaleGray7Brush}" Opacity="0.7" IsSaveRawDataDone="{Binding DeviceStatus.IsSaveRawDataDone}" IsLumenLoaded="{Binding DeviceStatus.IsLumenLoaded}" IsLumenSaved="{Binding DeviceStatus.IsLumenSaved}" IsOCTImagingDone="{Binding DeviceStatus.IsOCTImagingDone}" IsFfrCalculated="{Binding DeviceStatus.IsFfrCalculated}">
                        <component:MenuUnableComponent.Visibility>
                            <MultiBinding Converter="{StaticResource ComponentVisibilityConverter}">
                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsSaveRawDataDone"/>
                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsLumenLoaded"/>
                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsLumenSaved"/>
                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsOCTImagingDone"/>
                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsFfrCalculated"/>
                            </MultiBinding>
                        </component:MenuUnableComponent.Visibility>
                    </component:MenuUnableComponent>
                    <component:MenuUnableComponent Grid.Row="1" Background="{StaticResource GrayscaleGray7Brush}" Opacity="0.7" IsSaveRawDataDone="{Binding DeviceStatus.IsSaveRawDataDone}" IsLumenLoaded="{Binding DeviceStatus.IsLumenLoaded}" IsLumenSaved="{Binding DeviceStatus.IsLumenSaved}" IsOCTImagingDone="True" IsFfrCalculated="{Binding DeviceStatus.IsFfrCalculated}">
                        <component:MenuUnableComponent.Visibility>
                            <MultiBinding Converter="{StaticResource ComponentVisibilityConverter}">
                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsSaveRawDataDone"/>
                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsLumenLoaded"/>
                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsLumenSaved"/>
                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsOCTImagingDone"/>
                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsFfrCalculated"/>
                            </MultiBinding>
                        </component:MenuUnableComponent.Visibility>
                    </component:MenuUnableComponent>
                    <component:MenuUnableComponent Grid.Row="2" Background="{StaticResource GrayscaleGray7Brush}" Opacity="0.7" IsSaveRawDataDone="{Binding DeviceStatus.IsSaveRawDataDone}" IsLumenLoaded="{Binding DeviceStatus.IsLumenLoaded}" IsLumenSaved="{Binding DeviceStatus.IsLumenSaved}" IsOCTImagingDone="{Binding DeviceStatus.IsOCTImagingDone}" IsFfrCalculated="{Binding DeviceStatus.IsFfrCalculated}">
                        <component:MenuUnableComponent.Visibility>
                            <MultiBinding Converter="{StaticResource ComponentVisibilityConverter}">
                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsSaveRawDataDone"/>
                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsLumenLoaded"/>
                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsLumenSaved"/>
                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsOCTImagingDone"/>
                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsFfrCalculated"/>
                            </MultiBinding>
                        </component:MenuUnableComponent.Visibility>
                    </component:MenuUnableComponent>
                </Grid>
                <component:MenuUnableComponent Grid.Column="2" Background="{StaticResource GrayscaleGray7Brush}" Opacity="0.7" IsSaveRawDataDone="{Binding DeviceStatus.IsSaveRawDataDone}" IsLumenLoaded="{Binding DeviceStatus.IsLumenLoaded}" IsLumenSaved="{Binding DeviceStatus.IsLumenSaved}" IsOCTImagingDone="{Binding DeviceStatus.IsOCTImagingDone}" IsFfrCalculated="{Binding DeviceStatus.IsFfrCalculated}">
                    <component:MenuUnableComponent.Visibility>
                        <MultiBinding Converter="{StaticResource ComponentVisibilityConverter}">
                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsSaveRawDataDone"/>
                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsLumenLoaded"/>
                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsLumenSaved"/>
                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsOCTImagingDone"/>
                            <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsFfrCalculated"/>
                        </MultiBinding>
                    </component:MenuUnableComponent.Visibility>
                </component:MenuUnableComponent>
            </Grid>

            <!-- Power Off/Switch User Msg -->
            <StackPanel Grid.Row="0" Grid.RowSpan="3" Background="{StaticResource GrayscaleGray7Brush}" Opacity="0.7" Visibility="{Binding DeviceStatus.IsPowerOff, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding DeviceStatus.IsPowerOff, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border CornerRadius="10" Background="{DynamicResource GrayscaleGray6Brush}" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray7Brush}" Width="{x:Static const:Constants.PowerOffDialogWidth}" Height="{x:Static const:Constants.PowerOffDialogHeight}">
                    <StackPanel HorizontalAlignment="Center" Width="{x:Static const:Constants.PowerOffDialogWidth}">
                        <StackPanel Height="85"/>
                        <ContentControl Template="{DynamicResource Loading}"/>
                        <StackPanel Height="21"/>
                        <Label HorizontalAlignment="Center" Style="{DynamicResource Pretendard-Medium-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding DeviceStatus.PowerOffMsg}"/>
                        <StackPanel Height="60"/>
                        <Image Style="{DynamicResource Raywatt}" Width="49" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,16,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
