<Page x:Class="RaywattOCTFFR.Views.File.FileExportStep2DicomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RaywattOCTFFR.Views.File"
      xmlns:const="clr-namespace:RaywattOCTFFR.Common.Bases"
      mc:Ignorable="d" 
      Width="{x:Static const:Constants.FileExportDialogWidth}" Height="{x:Static const:Constants.FileExportDialogHeight}"
      Title="FileExportStep2DicomPage">

    <Border CornerRadius="10" Background="{DynamicResource GrayscaleGray6Brush}" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray7Brush}">
        <Grid IsEnabled="{Binding IsChecking, Converter={StaticResource BoolToEnableReverseConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="29"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="29"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="66"/>
                <RowDefinition Height="29"/>
                <RowDefinition Height="196"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="29"/>
                <RowDefinition Height="257"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="71" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <Label Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Export], Source={StaticResource L10N}}"/>
                <Label Style="{DynamicResource Pretendard-Medium-22}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Margin="0,12,0,0" Content=" - "/>
                <Label Style="{DynamicResource Pretendard-Medium-22}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Margin="0,12,0,0" Content="{Binding [Step 2.], Source={StaticResource L10N}}"/>
                <Label Style="{DynamicResource Pretendard-Medium-22}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Margin="0,12,0,0" Content=" ("/>
                <Label Style="{DynamicResource Pretendard-Medium-22}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Margin="0,12,0,0" Content="{Binding [DICOM], Source={StaticResource L10N}}"/>
                <Label Style="{DynamicResource Pretendard-Medium-22}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Margin="0,12,0,0" Content=")"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1">
                <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Export Option], Source={StaticResource L10N}}"/>
            </StackPanel>

            <Border Grid.Row="3" Grid.Column="1" CornerRadius="10" Background="{DynamicResource GrayscaleGray7Brush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="188"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Style="{DynamicResource Pretendard-Medium-16}" Margin="20,28,0,20" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [View], Source={StaticResource L10N}}"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,23,0,15">
                        <CheckBox IsChecked="{Binding FileExport.AngioView}" Content="{Binding [Angio Co-Registration], Source={StaticResource L10N}}" IsEnabled="{Binding FileExport.AngioEnabled}"/>
                        <CheckBox IsChecked="{Binding FileExport.Longitude}" Content="{Binding [Longitude], Source={StaticResource L10N}}" Margin="35,0,0,0"/>
                    </StackPanel>
                    <Separator Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource GrayscaleGray5Brush}" Width="760" Height="1"/>
                    <Label Grid.Row="2" Grid.Column="0" Style="{DynamicResource Pretendard-Medium-16}" Margin="20,21,0,20" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Measurements], Source={StaticResource L10N}}"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,16,0,15" >
                        <CheckBox IsChecked="{Binding FileExport.MeasureAuto}" Content="{Binding [Auto], Source={StaticResource L10N}}"/>
                        <CheckBox IsChecked="{Binding FileExport.MeasureManual}" Content="{Binding [Manual], Source={StaticResource L10N}}" Margin="35,0,0,0"/>
                    </StackPanel>
                    <Separator Grid.Row="3" Grid.ColumnSpan="3" Background="{DynamicResource GrayscaleGray5Brush}" Width="760" Height="1"/>
                    <Label Grid.Row="4" Grid.Column="0" Style="{DynamicResource Pretendard-Medium-16}" Margin="20,20,0,0" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Additional Option], Source={StaticResource L10N}}"/>
                    <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding FileExport.PatientInfoAnonymize}" Margin="0,15,0,22" Content="{Binding [Patient Information Anonymize], Source={StaticResource L10N}}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="5" Grid.Column="1">
                <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Output Option], Source={StaticResource L10N}}"/>
            </StackPanel>

            <Border Grid.Row="6" Grid.Column="1" CornerRadius="10" Background="{DynamicResource GrayscaleGray7Brush}">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="59"/>
                        <RowDefinition Height="39"/>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="138"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="192"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Style="{DynamicResource Pretendard-Medium-16}" Margin="20,28,0,8" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Export Size], Source={StaticResource L10N}}"/>
                        <Label Grid.Column="1" Style="{DynamicResource Pretendard-Medium-16}" Margin="0,28,0,8" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Destination], Source={StaticResource L10N}}"/>
                    </Grid>
                    <Grid Grid.Row="1" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="192"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,5,0,0">
                            <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding ExportSize}"/>
                            <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding ExportSizeUnit}" Margin="5,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <StackPanel>
                                <RadioButton IsChecked="{Binding IsPacs, Converter={StaticResource BoolToEnableReverseConverter}}" Content="{Binding [External Drive], Source={StaticResource L10N}}"/>
                            </StackPanel>
                            <StackPanel Margin="39,0,0,0">
                                <RadioButton IsChecked="{Binding IsPacs}" Content="{Binding [PACS], Source={StaticResource L10N}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Separator Grid.Row="2" Background="{DynamicResource GrayscaleGray5Brush}" Width="760" Height="1" VerticalAlignment="Top"/>
                    <Grid Grid.Row="3" Visibility="{Binding IsPacs, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="27"/>
                            <RowDefinition Height="54"/>
                            <RowDefinition Height="57"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <Label Style="{DynamicResource Pretendard-Medium-16}" Margin="20,0,0,8" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Select Drive], Source={StaticResource L10N}}"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" Style="{DynamicResource ComboBoxDialog}" Width="280" ItemsSource="{Binding ExternalDriveComboBox}" SelectedValue="{Binding SelectedExternalDrive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Key" DisplayMemberPath="Value" IsEnabled="{Binding IsEnableExternalDrive}" Tag="{Binding [No Drive], Source={StaticResource L10N}}" Margin="20,0,0,0"/>
                            <TextBox Grid.Column="1" Style="{DynamicResource TextBoxWithCorner}" Width="386" IsReadOnly="True" Text="{Binding FileExport.ExternalDrivePath}" Tag="{Binding [Select Destination Path], Source={StaticResource L10N}}" Margin="12,0,0,0"/>
                            <Button Grid.Column="2" Style="{StaticResource OutlinedBtnType1}" Width="72" Height="54" Command="{Binding ExternalDrivePathCommand}" Content="{Binding [Path], Source={StaticResource L10N}}" IsEnabled="{Binding IsEnableExternalDrive}" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,10,0,0" >
                                <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Total], Source={StaticResource L10N}}"/>
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                    <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding ExternalDriveTotalSize}"/>
                                    <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [GB], Source={StaticResource L10N}}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                                <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Free], Source={StaticResource L10N}}"/>
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                    <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding ExternalDriveAvailableFreeSpace}"/>
                                    <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [GB], Source={StaticResource L10N}}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="3" Visibility="{Binding IsPacs, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="39"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <Label Style="{DynamicResource Pretendard-Medium-16}" Margin="20,0,0,8" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Select PACS Server], Source={StaticResource L10N}}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="20,0,0,0">
                            <Button Style="{StaticResource OutlinedBtnType4-Large}" Width="140" Command="{Binding SelectPacsCommand}" Content="{Binding [Select], Source={StaticResource L10N}}"/>
                            <Grid Margin="32,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Row="0" Grid.Column="0" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [AE Title], Source={StaticResource L10N}}"/>
                                <Label Grid.Row="1" Grid.Column="0" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding SelectedDicomServer.AeTitle}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                                <Label Grid.Row="0" Grid.Column="1" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Hostname], Source={StaticResource L10N}}"/>
                                <Label Grid.Row="1" Grid.Column="1" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding SelectedDicomServer.Hostname}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                                <Label Grid.Row="0" Grid.Column="2" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [IP], Source={StaticResource L10N}}"/>
                                <Label Grid.Row="1" Grid.Column="2" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding SelectedDicomServer.IpAddress}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                                <Label Grid.Row="0" Grid.Column="3" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Port], Source={StaticResource L10N}}"/>
                                <Label Grid.Row="1" Grid.Column="3" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding SelectedDicomServer.Port}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                                <Label Grid.Row="0" Grid.Column="4" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Comment], Source={StaticResource L10N}}"/>
                                <Label Grid.Row="1" Grid.Column="4" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding SelectedDicomServer.Comment}" VerticalAlignment="Bottom"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="8" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                    <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding CancelCommand}" Content="{Binding [Cancel], Source={StaticResource L10N}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding BackCommand}" Content="{Binding [Back], Source={StaticResource L10N}}"/>
                    <StackPanel Width="12"/>
                    <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Command="{Binding ExportCommand}" Content="{Binding [Export], Source={StaticResource L10N}}"/>
                </StackPanel>
            </Grid>

            <ContentControl Grid.Column="1" Grid.RowSpan="9" Template="{DynamicResource Loading}" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Border>
</Page>
