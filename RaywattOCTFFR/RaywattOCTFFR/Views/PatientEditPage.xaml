<Page x:Class="RaywattOCTFFR.Views.PatientEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RaywattOCTFFR.Views"
      xmlns:const="clr-namespace:RaywattOCTFFR.Common.Bases"
      xmlns:behaviors="clr-namespace:RaywattOCTFFR.Common.Behaviors"
      xmlns:component="clr-namespace:RaywattOCTFFR.Views.Component"
      mc:Ignorable="d" 
      d:DesignHeight="1024" d:DesignWidth="1280"
      Background="{DynamicResource GrayscaleGray8Brush}"
      Title="PatientEditPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="60" Background="{DynamicResource GrayscaleGray7Brush}">
            <Label Style="{DynamicResource Pretendard-Medium-18}" Foreground="{DynamicResource GrayscaleGray3Brush}" Margin="75,20,0,19" Content="{Binding [Edit Patient], Source={StaticResource L10N}}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="436"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="436"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="78"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="78"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="78"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="78"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="78"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="78"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="237"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Grid.Column="1" Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Edit Patient], Source={StaticResource L10N}}"/>
            <component:IconButton Grid.Row="1" Grid.Column="1" Style="{DynamicResource IconButton}" Icon="delete" Command="{Binding DeleteCommand}" HorizontalAlignment="Right" Margin="0,12,0,32"/>
            <Label Grid.Row="2" Grid.Column="1" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [ID], Source={StaticResource L10N}}"/>
            <TextBox Grid.Row="3" Grid.Column="1" Style="{DynamicResource TextBoxValidator}" Text="{Binding PatientEdit.Id, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [Enter ID], Source={StaticResource L10N}}" ToolTip="{Binding PatientEdit.ValidateId}" Margin="0,0,0,8"/>
            <Label Grid.Row="4" Grid.Column="1" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [First Name], Source={StaticResource L10N}}"/>
            <TextBox Grid.Row="5" Grid.Column="1" Style="{DynamicResource TextBoxBase}" Text="{Binding PatientEdit.Firstname, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [Enter First Name], Source={StaticResource L10N}}" Margin="0,0,0,8"/>
            <Label Grid.Row="6" Grid.Column="1" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Last Name], Source={StaticResource L10N}}"/>
            <TextBox Grid.Row="7" Grid.Column="1" Style="{DynamicResource TextBoxBase}" Text="{Binding PatientEdit.Lastname, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [Enter Last Name], Source={StaticResource L10N}}" Margin="0,0,0,8"/>
            <Label Grid.Row="8" Grid.Column="1" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Birth Date], Source={StaticResource L10N}}"/>
            <DatePicker Grid.Row="9" Grid.Column="1" Style="{DynamicResource DatePickerStyle}" behaviors:DatePickerPopupOffsetBehavior.AutoVerticalOffset="True" SelectedDate="{Binding PatientEdit.Birthdate, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [Enter Birth Date], Source={StaticResource L10N}}" Margin="0,0,0,24"/>
            <Label Grid.Row="10" Grid.Column="1" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Gender], Source={StaticResource L10N}}"/>
            <ComboBox Grid.Row="11" Grid.Column="1" ItemsSource="{Binding GenderComboBox}" SelectedValue="{Binding SelectedGender, Mode=TwoWay}" SelectedValuePath="Key" DisplayMemberPath="Value" Margin="0,0,0,24" Tag="{Binding [Select Gender], Source={StaticResource L10N}}"/>
            <Label Grid.Row="12" Grid.Column="1" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Physician], Source={StaticResource L10N}}"/>
            <StackPanel Grid.Row="13" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBox Style="{DynamicResource TextBoxWithCorner}" Width="268" IsReadOnly="True" Text="{Binding PatientEdit.PhysicianName}" Tag="{Binding [Select Physician], Source={StaticResource L10N}}" Margin="0,0,0,8"/>
                <Button Style="{StaticResource OutlinedBtnType1-Large}" Width="134" Height="54" VerticalAlignment="Top" Command="{Binding SelectPhysicianCommand}" Content="{Binding [Select], Source={StaticResource L10N}}" Margin="6,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="14" Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource OutlinedBtnType1-Large}" Command="{Binding CancelCommand}" Content="{Binding [Cancel], Source={StaticResource L10N}}"/>
                <StackPanel Width="8"/>
                <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Command="{Binding PatientEditSaveCommand}" Content="{Binding [OK], Source={StaticResource L10N}}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Height="40" Background="{DynamicResource GrayscaleBlackBrush}"/>
    </Grid>
</Page>
