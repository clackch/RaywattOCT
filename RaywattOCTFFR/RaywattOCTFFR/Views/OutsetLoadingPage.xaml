<Page x:Class="RaywattOCTFFR.Views.OutsetLoadingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RaywattOCTFFR.Views"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      mc:Ignorable="d" 
      d:DesignHeight="1024" d:DesignWidth="1280"
      Background="{DynamicResource GrayscaleGray8Brush}"
      Title="OutsetLoadingPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="293"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="64"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="64"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Image Grid.Row="1" Style="{DynamicResource RaywattOutset}"/>

        <Grid Grid.Row="3">
            <Image Source="{svgc:SvgImage Source=/res/icon/progressBound.svg}" Width="600" Height="64"/>
            <ProgressBar Style="{DynamicResource LoadingProgressBar}" Value="{Binding Progress}" Margin="10" Width="580"/>
        </Grid>
        
    </Grid>
</Page>
