<Page x:Class="RaywattOCTFFR.Views.ReviewFfrSettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:local="clr-namespace:RaywattOCTFFR.Views"
      xmlns:component="clr-namespace:RaywattOCTFFR.Views.Component"
      xmlns:behaviors="clr-namespace:RaywattOCTFFR.Common.Behaviors"
      xmlns:System="clr-namespace:System;assembly=mscorlib"
      xmlns:const="clr-namespace:RaywattOCTFFR.Common.Bases"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      xmlns:annotation="clr-namespace:RaywattOCTFFR.Common.Annotation"
      mc:Ignorable="d" 
      d:DesignHeight="1024" d:DesignWidth="1280"
      Background="{DynamicResource GrayscaleGray8Brush}"
      Title="ReviewFfrSettingPage">
    <Page.Resources>
        <System:Boolean x:Key="TrueValue">True</System:Boolean>
        <System:Boolean x:Key="FalseValue">False</System:Boolean>
    </Page.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource SideCardBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Width="70"/>
                    <ToggleButton Style="{DynamicResource TabToggleBtn}" Content="{Binding [2D], Source={StaticResource L10N}}" Command="{Binding ReviewTypeSwitchCommand}" CommandParameter="{x:Static const:Constants.ReviewPage}"/>
                    <ToggleButton Style="{DynamicResource TabToggleBtn}" Content="{Binding [3D], Source={StaticResource L10N}}" Command="{Binding ReviewTypeSwitchCommand}" CommandParameter="{x:Static const:Constants.Review3dPage}"/>
                    <ToggleButton Style="{DynamicResource TabToggleBtn}" Content="{Binding [Compare], Source={StaticResource L10N}}" Command="{Binding ReviewTypeSwitchCommand}" CommandParameter="{x:Static const:Constants.ReviewComparePage}" Visibility="{Binding PatientCase.Procedure, Converter={StaticResource ProcedureVisibilityConverter}, ConverterParameter=$002|$003}"/>
                    <ToggleButton Style="{DynamicResource TabToggleBtn}" Content="{Binding [AI FFR], Source={StaticResource L10N}}" IsChecked="True" IsEnabled="False"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="60,30,60,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="790"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="73"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="10,10,0,0" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray7Brush}" Background="{DynamicResource GrayscaleGray7Brush}">
                    <StackPanel>
                        <Grid Height="620" Margin="40,28,40,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="620"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="64"/>
                                    <RowDefinition/>
                                    <RowDefinition Height="64"/>
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0" Style="{DynamicResource Pretendard-Bold-22}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Feature Parameters], Source={StaticResource L10N}}" VerticalAlignment="Center"/>
                                <!-- Step 1 : Select Vessel Type -->
                                <Grid Grid.Row="1" VerticalAlignment="Center" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityConverter}, ConverterParameter={x:Static const:Constants.FfrStep1}}">
                                    <StackPanel>
                                        <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Step 1.], Source={StaticResource L10N}}"/>
                                        <StackPanel Height="16"/>
                                        <Label Style="{DynamicResource Pretendard-Semibold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}">
                                            <Label.Content>
                                                <AccessText TextWrapping="Wrap" Text="{Binding [$MSG018], Source={StaticResource L10N}}"/>
                                            </Label.Content>
                                        </Label>
                                        <StackPanel Height="20"/>
                                        <DataGrid Name="vesselList" Width="210" Height="175" ItemsSource="{Binding VesselList}" SelectedItem="{Binding CurrentVessel}" Style="{StaticResource DataGridDialog}" RowStyle="{StaticResource DataGridRowDialog}" ColumnHeaderStyle="{StaticResource DataGridColumnHeaderDialog}" HeadersVisibility="None" SelectionMode="Single" FontSize="16" HorizontalAlignment="Left">
                                            <i:Interaction.Behaviors>
                                                <behaviors:DataGridLoadedBehavior />
                                            </i:Interaction.Behaviors>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="SelectionChanged">
                                                    <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}" CommandParameter="{Binding ElementName=vesselList, Path=CurrentItem}"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" Width="*" Binding="{Binding Value}" Header="{Binding [Vessel], Source={StaticResource L10N}}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                    <Label Style="{DynamicResource Pretendard-Medium-12}" Foreground="{DynamicResource AdditionalColor3Brush}" Content="* Vessel type not supported." VerticalAlignment="Bottom" Margin="25,0,0,-20" Visibility="{Binding IsVesselTypeValid, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                                </Grid>
                                <!-- Step 3 : Define Reference Proximal Lumen -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityConverter}, ConverterParameter={x:Static const:Constants.FfrStep3}}">
                                    <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Step 3.], Source={StaticResource L10N}}"/>
                                    <StackPanel Height="16"/>
                                    <Label Style="{DynamicResource Pretendard-Semibold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}">
                                        <Label.Content>
                                            <AccessText TextWrapping="Wrap" Text="{Binding [$MSG019], Source={StaticResource L10N}}"/>
                                        </Label.Content>
                                    </Label>
                                </StackPanel>
                                <!-- Step 2 : Define Reference Distal Lumen -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityConverter}, ConverterParameter={x:Static const:Constants.FfrStep2}}">
                                    <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Step 2.], Source={StaticResource L10N}}"/>
                                    <StackPanel Height="16"/>
                                    <Label Style="{DynamicResource Pretendard-Semibold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}">
                                        <Label.Content>
                                            <AccessText TextWrapping="Wrap" Text="{Binding [$MSG020], Source={StaticResource L10N}}"/>
                                        </Label.Content>
                                    </Label>
                                </StackPanel>
                                <!-- Step 4 : Measure Plaque Area -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityConverter}, ConverterParameter={x:Static const:Constants.FfrStep4}}">
                                    <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Step 4.], Source={StaticResource L10N}}"/>
                                    <StackPanel Height="16"/>
                                    <Label Style="{DynamicResource Pretendard-Semibold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}">
                                        <Label.Content>
                                            <AccessText TextWrapping="Wrap" Text="{Binding [$MSG021], Source={StaticResource L10N}}"/>
                                        </Label.Content>
                                    </Label>
                                    <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding DeleteCommand}" Content="{Binding [Delete], Source={StaticResource L10N}}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                                </StackPanel>
                                <!-- Step 5 : Check the value for FFR -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityConverter}, ConverterParameter={x:Static const:Constants.FfrStep5}}">
                                    <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Step 5.], Source={StaticResource L10N}}"/>
                                    <StackPanel Height="16"/>
                                    <Label Style="{DynamicResource Pretendard-Semibold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}">
                                        <Label.Content>
                                            <AccessText TextWrapping="Wrap" Text="{Binding [$MSG022], Source={StaticResource L10N}}"/>
                                        </Label.Content>
                                    </Label>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                                    <component:IconButton Style="{StaticResource IconButton}" Width="42" Height="42" Icon="zoomIn" Command="{Binding ZoomInCommand}"/>
                                    <StackPanel Width="5"/>
                                    <component:IconButton Style="{StaticResource IconButton}" Width="42" Height="42" Icon="zoomOut" Command="{Binding ZoomOutCommand}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Column="1">
                                <Grid.Clip>
                                    <RectangleGeometry RadiusX="10" RadiusY="10">
                                        <RectangleGeometry.Rect>
                                            <Rect X="0" Y="0" Width="{x:Static const:Constants.CrossSectionSize}" Height="{x:Static const:Constants.CrossSectionSize}"/>
                                        </RectangleGeometry.Rect>
                                    </RectangleGeometry>
                                </Grid.Clip>
                                <Image Source="{Binding CrossSectionImage}" Width="{x:Static const:Constants.CrossSectionSize}" Height="{x:Static const:Constants.CrossSectionSize}">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="{Binding ReviewStatus.ZoomFfr.ScaleX, Converter={StaticResource CrossSectionScaleConverter}}" ScaleY="{Binding ReviewStatus.ZoomFfr.ScaleY, Converter={StaticResource CrossSectionScaleConverter}}"/>
                                            <TranslateTransform X="{Binding ReviewStatus.ZoomFfr.TranslateX, Converter={StaticResource CrossSectionScaleConverter}}" Y="{Binding ReviewStatus.ZoomFfr.TranslateY, Converter={StaticResource CrossSectionScaleConverter}}"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                                <!-- Lumen Contour-->
                                <Grid Grid.Column="1" Width="{x:Static const:Constants.CrossSectionSize}" Height="{x:Static const:Constants.CrossSectionSize}">
                                    <annotation:DrawLumenContourUtil LumenContours="{Binding PatientCase.LumenContours}" CurrentLumenContour="{Binding CurrentLumenContour, Mode=TwoWay}" LumenStents="{Binding PatientCase.LumenStents}" CurrentLumenStent="{Binding CurrentLumenStent, Mode=TwoWay}" AppositionThreshold="{Binding PatientCase.AppositionThreshold}" Zoom="{Binding ReviewStatus.ZoomFfr}" FrameNumber="{Binding FrameNumber}" IsEditOn="False" IsDrawOn="True" IsFfr="True"/>
                                </Grid>
                                <!-- Measurement -->
                                <Grid Grid.Column="1" Width="{x:Static const:Constants.CrossSectionSize}" Height="{x:Static const:Constants.CrossSectionSize}">
                                    <annotation:DrawUtil Grid.Row="1" Width="{x:Static const:Constants.CrossSectionSize}" Height="{x:Static const:Constants.CrossSectionSize}" Zoom="{Binding ReviewStatus.ZoomFfr}" IsDrawOn="{Binding IsDrawOn}" Measurements="{Binding PlaqueAreaList}" FrameNumber="{Binding FrameNumber}" InCommand="{Binding MeasurementCommand, Mode=TwoWay}" IsEditOn="{Binding IsEditOn}" IsFfr="True" FfrFeature="{Binding FfrFeature}"/>
                                </Grid>
                                <!-- Circle Mask -->
                                <Grid>
                                    <Path Fill="{StaticResource GrayscaleGray7Brush}">
                                        <Path.Data>
                                            <CombinedGeometry GeometryCombineMode="Exclude">
                                                <CombinedGeometry.Geometry1>
                                                    <RectangleGeometry Rect="{x:Static const:Constants.CrossSectionRect}" />
                                                </CombinedGeometry.Geometry1>
                                                <CombinedGeometry.Geometry2>
                                                    <EllipseGeometry Center="{x:Static const:Constants.CrossSectionPointCenter}" RadiusX="{x:Static const:Constants.CrossSectionRadius}" RadiusY="{x:Static const:Constants.CrossSectionRadius}"/>
                                                </CombinedGeometry.Geometry2>
                                            </CombinedGeometry>
                                        </Path.Data>
                                    </Path>
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="{Binding ReviewStatus.ZoomFfr.ZoomScaleX, Converter={StaticResource CrossSectionScaleConverter}}" ScaleY="{Binding ReviewStatus.ZoomFfr.ZoomScaleY, Converter={StaticResource CrossSectionScaleConverter}}"/>
                                            <TranslateTransform X="{Binding ReviewStatus.ZoomFfr.ZoomTranslateX, Converter={StaticResource CrossSectionScaleConverter}}" Y="{Binding ReviewStatus.ZoomFfr.ZoomTranslateY, Converter={StaticResource CrossSectionScaleConverter}}"/>
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                </Grid>
                                <!--Touch-->
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="ManipulationStarting">
                                        <i:InvokeCommandAction Command="{Binding ManipulationStartingCommand}" PassEventArgsToCommand="True"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="ManipulationDelta">
                                        <i:InvokeCommandAction Command="{Binding ManipulationDeltaCommand}" PassEventArgsToCommand="True"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="ManipulationCompleted">
                                        <i:InvokeCommandAction Command="{Binding ManipulationCompletedCommand}" PassEventArgsToCommand="True"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Grid>
                            <!-- Cross Section Info. -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="50">
                                <Label Content="F" Style="{DynamicResource Pretendard-ExtraBold-14}" Foreground="{DynamicResource GrayscaleGray3Brush}"/>
                                <StackPanel Width="6"/>
                                <Label Content="{Binding DisplayFrameNumber}" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray3Brush}" />
                            </StackPanel>
                            <!-- Scale Bar -->
                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                <Label Content="1 ㎜" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource SideMenuTitleBrush}" HorizontalAlignment="Center"/>
                                <StackPanel Height="4"/>
                                <Grid>
                                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Height="5" Width="1" Margin="0" HorizontalAlignment="Left">
                                        <Separator.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform X="{Binding ReviewStatus.ZoomFfr.ScaleX, Converter={StaticResource ScaleBarScaleConverter}, ConverterParameter={x:Static const:Constants.CrossSectionSize}}"/>
                                            </TransformGroup>
                                        </Separator.RenderTransform>
                                    </Separator>
                                    <Separator Width="{Binding CrossSectionScale}" Height="1" Margin="0">
                                        <Separator.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="{Binding ReviewStatus.ZoomFfr.ScaleX, Converter={StaticResource CrossSectionScaleConverter}}"/>
                                                <TranslateTransform X="{Binding ReviewStatus.ZoomFfr.ScaleX, Converter={StaticResource ScaleBarScaleConverter}, ConverterParameter={x:Static const:Constants.CrossSectionSize}}"/>
                                            </TransformGroup>
                                        </Separator.RenderTransform>
                                    </Separator>
                                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Height="5" Width="1" Margin="0" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                            <!-- Mini Map -->
                            <Grid Grid.Column="1" Width="{x:Static const:Constants.CrossSectionSize}" Height="{x:Static const:Constants.CrossSectionSize}">
                                <Border Width="{x:Static const:Constants.MiniMapBorderSize}" Height="{x:Static const:Constants.MiniMapBorderSize}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="1" BorderBrush="{DynamicResource GrayscaleGray8Brush}" BorderThickness="1" CornerRadius="10" Visibility="{Binding ReviewStatus.ZoomFfr.Visibility}">
                                    <Canvas>
                                        <Canvas.Background>
                                            <ImageBrush ImageSource="{Binding CrossSectionImage}" Stretch="Fill"/>
                                        </Canvas.Background>
                                        <Canvas.Clip>
                                            <RectangleGeometry RadiusX="10" RadiusY="10">
                                                <RectangleGeometry.Rect>
                                                    <Rect X="0" Y="0" Width="{x:Static const:Constants.MiniMapCanvasSize}" Height="{x:Static const:Constants.MiniMapCanvasSize}"/>
                                                </RectangleGeometry.Rect>
                                            </RectangleGeometry>
                                        </Canvas.Clip>

                                        <Rectangle Style="{DynamicResource MiniMapRect}" Canvas.Left="{Binding ReviewStatus.ZoomFfr.RectLeft}" Canvas.Top="{Binding ReviewStatus.ZoomFfr.RectTop}" Width="{Binding ReviewStatus.ZoomFfr.RectWidth}" Height="{Binding ReviewStatus.ZoomFfr.RectHeight}" Tag="{Binding ReviewStatus.ZoomFfr.IsCaptured}">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="PreviewMouseDown">
                                                    <i:InvokeCommandAction Command="{Binding ReviewStatus.ZoomFfr.CmdSetCaptured}" CommandParameter="{Binding ReviewStatus.ZoomFfr}"/>
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="PreviewMouseUp">
                                                    <i:InvokeCommandAction Command="{Binding ReviewStatus.ZoomFfr.CmdSetCaptured}"/>
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="PreviewMouseMove">
                                                    <i:InvokeCommandAction Command="{Binding ReviewStatus.ZoomFfr.CmdMoveRect}" CommandParameter="{Binding ReviewStatus.ZoomFfr}"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </Rectangle>
                                    </Canvas>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="2" Margin="20,0,0,0">
                                <StackPanel Height="34"/>
                                <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Vessel], Source={StaticResource L10N}}"/>
                                <StackPanel Height="10"/>
                                <Grid Height="31">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="27.1"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Label Style="{DynamicResource Pretendard-Bold-26}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding CurrentVessel.Buffer1, Converter={StaticResource CodeConverter}, ConverterParameter='VESS'}"/>
                                        <StackPanel Width="5"/>
                                        <Label Grid.Column="0" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding CurrentVessel.Buffer2}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                    </StackPanel>
                                    
                                    <Image Grid.Column="1" Source="{svgc:SvgImage Source=/res/icon/ffrValueChecked.svg}" Visibility="{Binding FfrStep, Converter={StaticResource FfrStepVisibilityConveter}, ConverterParameter={x:Static const:Constants.FfrStep1}}"/>
                                </Grid>
                                <StackPanel Height="13"/>
                                <Separator Grid.Row="1" Background="{DynamicResource GrayscaleGray5Brush}"/>
                                <StackPanel Height="10"/>
                                <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Distal Lumen Area], Source={StaticResource L10N}}"/>
                                <StackPanel Height="10"/>
                                <Grid Height="31">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="27.1"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{DynamicResource TextBlock_Pretendard-Bold-26}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Text="{Binding Section.Proximal.DValue, StringFormat={}{0:N2}, Converter={StaticResource UnitConverter}, ConverterParameter={x:Static const:Constants.ScaleArea}}"/>
                                    <Image Grid.Column="1" Source="{svgc:SvgImage Source=/res/icon/ffrValueChecked.svg}" Visibility="{Binding FfrStep, Converter={StaticResource FfrStepVisibilityConveter}, ConverterParameter={x:Static const:Constants.FfrStep2}}"/>
                                </Grid>
                                <StackPanel Height="13"/>
                                <Separator Grid.Row="1" Background="{DynamicResource GrayscaleGray5Brush}"/>
                                <StackPanel Height="10"/>
                                <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Proximal Lumen Area], Source={StaticResource L10N}}"/>
                                <StackPanel Height="10"/>
                                <Grid Height="31">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="27.1"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{DynamicResource TextBlock_Pretendard-Bold-26}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Text="{Binding Section.Distal.DValue, StringFormat={}{0:N2}, Converter={StaticResource UnitConverter}, ConverterParameter={x:Static const:Constants.ScaleArea}}"/>
                                    <Image Grid.Column="1" Source="{svgc:SvgImage Source=/res/icon/ffrValueChecked.svg}" Visibility="{Binding FfrStep, Converter={StaticResource FfrStepVisibilityConveter}, ConverterParameter={x:Static const:Constants.FfrStep3}}"/>
                                </Grid>
                                <StackPanel Height="13"/>
                                <Separator Grid.Row="1" Background="{DynamicResource GrayscaleGray5Brush}"/>
                                <StackPanel Height="10"/>
                                <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Lesion Length], Source={StaticResource L10N}}"/>
                                <StackPanel Height="10"/>
                                <Grid Height="31">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="27.1"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{DynamicResource TextBlock_Pretendard-Bold-26}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Text="{Binding Section.LesionLength.DValue, StringFormat={}{0:N1}}"/>
                                    <Image Grid.Column="1" Source="{svgc:SvgImage Source=/res/icon/ffrValueChecked.svg}" Visibility="{Binding FfrStep, Converter={StaticResource FfrStepVisibilityConveter}, ConverterParameter={x:Static const:Constants.FfrStep3}}"/>
                                </Grid>
                                <StackPanel Height="13"/>
                                <Separator Grid.Row="1" Background="{DynamicResource GrayscaleGray5Brush}"/>
                                <StackPanel Height="10"/>
                                <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Minimal Lumen Area], Source={StaticResource L10N}}"/>
                                <StackPanel Height="10"/>
                                <Grid Height="31">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="27.1"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{DynamicResource TextBlock_Pretendard-Bold-26}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Text="{Binding Section.MlaValue.DValue, StringFormat={}{0:N2}, Converter={StaticResource UnitConverter}, ConverterParameter={x:Static const:Constants.ScaleArea}}" Visibility="{Binding Section.Mla.IsVisible}" />
                                    <TextBlock Grid.Column="0" Style="{DynamicResource TextBlock_Pretendard-Bold-26}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Text="{Binding Section.MsaValue.DValue, StringFormat={}{0:N2}, Converter={StaticResource UnitConverter}, ConverterParameter={x:Static const:Constants.ScaleArea}}" Visibility="{Binding Section.Msa.IsVisible}"/>
                                    <Image Grid.Column="1" Source="{svgc:SvgImage Source=/res/icon/ffrValueChecked.svg}" Visibility="{Binding FfrStep, Converter={StaticResource FfrStepVisibilityConveter}, ConverterParameter={x:Static const:Constants.FfrStep3}}"/>
                                </Grid>
                                <StackPanel Height="13"/>
                                <Separator Grid.Row="1" Background="{DynamicResource GrayscaleGray5Brush}"/>
                                <StackPanel Height="10"/>
                                <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Plaque Area], Source={StaticResource L10N}}"/>
                                <StackPanel Height="10"/>
                                <Grid Height="31">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="27.1"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Style="{DynamicResource Pretendard-Bold-26}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding FfrFeature.PlaqueArea, StringFormat={}{0:N2}, Converter={StaticResource UnitConverter}, ConverterParameter={x:Static const:Constants.ScaleArea}}"/>
                                    <Image Grid.Column="1" Source="{svgc:SvgImage Source=/res/icon/ffrValueChecked.svg}" Visibility="{Binding FfrStep, Converter={StaticResource FfrStepVisibilityConveter}, ConverterParameter={x:Static const:Constants.FfrStep4}}"/>
                                </Grid>
                                <StackPanel Height="13"/>
                                <Separator Grid.Row="1" Background="{DynamicResource GrayscaleGray5Brush}"/>
                                <StackPanel Height="10"/>
                                <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Percent Area Stenosis], Source={StaticResource L10N}}"/>
                                <StackPanel Height="10"/>
                                <Grid Height="31">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="27.1"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{DynamicResource TextBlock_Pretendard-Bold-26}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Text="{Binding FfrFeature.PercentAreaStenosis, StringFormat={}{0:N2}}"/>
                                    <Image Grid.Column="1" Source="{svgc:SvgImage Source=/res/icon/ffrValueChecked.svg}" Visibility="{Binding FfrStep, Converter={StaticResource FfrStepVisibilityConveter}, ConverterParameter={x:Static const:Constants.FfrStep4}}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Grid Height="110" Margin="0,16,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="1080"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Label Content="D" Style="{DynamicResource Pretendard-Semibold-20}" Foreground="{DynamicResource AdditionalColor7Brush}" Opacity="0.5"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Label Content="P" Style="{DynamicResource Pretendard-Semibold-20}" Foreground="{DynamicResource AdditionalColor7Brush}" VerticalAlignment="Center" Opacity="0.5"/>
                            </StackPanel>
                            <Grid Grid.Row="0" Grid.Column="1" >
                                <Image Source="{Binding LumenProfileImage}" Width="{x:Static const:Constants.LongitudeFfrWidth}" Height="{x:Static const:Constants.LongitudeFfrHeight}" Stretch="Fill">
                                    <Image.Clip>
                                        <RectangleGeometry RadiusX="8" RadiusY="8">
                                            <RectangleGeometry.Rect>
                                                <Rect X="0" Y="0" Width="{x:Static const:Constants.LongitudeFfrWidth}" Height="{x:Static const:Constants.LongitudeFfrImageClipHeight}"/>
                                            </RectangleGeometry.Rect>
                                        </RectangleGeometry>
                                    </Image.Clip>
                                </Image>
                                <!-- Lesion Section -->
                                <Canvas Width="{x:Static const:Constants.LongitudeFfrWidth}">
                                    <!-- Section MLA -->
                                    <Grid Canvas.Left="{Binding Section.Mla.X}" Visibility="{Binding Section.Mla.IsVisible}" Margin="20,-4,0,0">
                                        <Image Height="95.2" Width="8" Source="{svgc:SvgImage Source=/res/indicator/ffrMlaSmall.svg}" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityReverseConverter}, ConverterParameter={x:Static const:Constants.FfrStep4}}"/>
                                        <Image Height="95.2" Width="8" Source="{svgc:SvgImage Source=/res/indicator/ffrMlaSmall_active.svg}" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityConverter}, ConverterParameter={x:Static const:Constants.FfrStep4}}"/>
                                        <Image Height="95.2" Width="8" Source="{svgc:SvgImage Source=/res/indicator/ffrMlaSmall_active.svg}" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityConverter}, ConverterParameter={x:Static const:Constants.FfrStep1}}"/>
                                        <Image Height="95.2" Width="8" Source="{svgc:SvgImage Source=/res/indicator/ffrMlaSmall_active.svg}" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityConverter}, ConverterParameter={x:Static const:Constants.FfrStep5}}"/>
                                    </Grid>
                                    <!-- Section MSA -->
                                    <Grid Canvas.Left="{Binding Section.Msa.X}" Visibility="{Binding Section.Msa.IsVisible}" Margin="20,-4,0,0">
                                        <Image Height="95.2" Width="8" Source="{svgc:SvgImage Source=/res/indicator/ffrMlaSmall.svg}" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityReverseConverter}, ConverterParameter={x:Static const:Constants.FfrStep4}}"/>
                                        <Image Height="95.2" Width="8" Source="{svgc:SvgImage Source=/res/indicator/ffrMlaSmall_active.svg}" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityConverter}, ConverterParameter={x:Static const:Constants.FfrStep4}}"/>
                                        <Image Height="95.2" Width="8" Source="{svgc:SvgImage Source=/res/indicator/ffrMlaSmall_active.svg}" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityConverter}, ConverterParameter={x:Static const:Constants.FfrStep1}}"/>
                                        <Image Height="95.2" Width="8" Source="{svgc:SvgImage Source=/res/indicator/ffrMlaSmall_active.svg}" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityConverter}, ConverterParameter={x:Static const:Constants.FfrStep5}}"/>
                                    </Grid>
                                    <!-- Section Lesion Length -->
                                    <Line Canvas.Left="{Binding Section.LesionProximal}" HorizontalAlignment="Stretch" Stroke="{StaticResource GrayscaleGray2Brush}" StrokeDashArray="2 3" StrokeThickness="1" X1="{Binding Section.LesionLengthWidth}" Margin="0,85,0,0"/>
                                    <Line Canvas.Left="{Binding Section.LesionDistal}" HorizontalAlignment="Stretch" Stroke="{StaticResource GrayscaleGray2Brush}" StrokeDashArray="2 3" StrokeThickness="1" X1="{Binding Section.LesionLengthWidth}" Margin="0,85,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,78,0,0" Canvas.Left="{Binding Section.LesionLength.X}" Visibility="{Binding Section.LesionLength.IsVisible}">
                                        <TextBlock Style="{DynamicResource TextBlock_Pretendard-Semibold-10}" Foreground="{DynamicResource GrayscaleGray2Brush}" Text="{Binding Section.LesionLength.DValue, StringFormat={}{0:N1}}"/>
                                        <StackPanel Width="1"/>
                                        <Label Style="{DynamicResource Pretendard-Medium-10}" Foreground="{DynamicResource GrayscaleGray2Brush}" Content="{Binding [㎜], Source={StaticResource L10N}}"/>
                                    </StackPanel>
                                    <!-- Section Proximal -->
                                    <Image Height="90" Width="28" Source="{svgc:SvgImage Source=/res/indicator/sectionProximalSmall.svg}" Canvas.Left="{Binding Section.Proximal.X}" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityReverseConverter}, ConverterParameter={x:Static const:Constants.FfrStep2}}"/>
                                    <component:IndicatorImage Style="{DynamicResource IndicatorImage}" Icon="sectionProximalSmallMove" IsCaptured="{Binding Section.Proximal.IsCaptured}" Stretch="None" Canvas.Left="{Binding Section.Proximal.X}" IsEnabled="{Binding Section.Proximal.IsEnabled}" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityConverter}, ConverterParameter={x:Static const:Constants.FfrStep2}}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="PreviewMouseDown" >
                                                <i:InvokeCommandAction Command="{Binding Section.Proximal.CmdSetCaptured}" CommandParameter="{StaticResource TrueValue}"/>
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="PreviewMouseUp" >
                                                <i:InvokeCommandAction Command="{Binding Section.Proximal.CmdSetCaptured}" CommandParameter="{StaticResource FalseValue}"/>
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="PreviewMouseMove" >
                                                <i:InvokeCommandAction Command="{Binding CmdMoveIndicator}" CommandParameter="{Binding Section.Proximal}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </component:IndicatorImage>
                                    <!-- Section Distal -->
                                    <Image Height="90" Width="28" Source="{svgc:SvgImage Source=/res/indicator/sectionDistalSmall.svg}" Canvas.Left="{Binding Section.Distal.X}"  Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityReverseConverter}, ConverterParameter={x:Static const:Constants.FfrStep3}}"/>
                                    <component:IndicatorImage Style="{DynamicResource IndicatorImage}" Icon="sectionDistalSmallMove" IsCaptured="{Binding Section.Distal.IsCaptured}" Stretch="None" Canvas.Left="{Binding Section.Distal.X}" IsEnabled="{Binding Section.Distal.IsEnabled}" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityConverter}, ConverterParameter={x:Static const:Constants.FfrStep3}}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="PreviewMouseDown" >
                                                <i:InvokeCommandAction Command="{Binding Section.Distal.CmdSetCaptured}" CommandParameter="{StaticResource TrueValue}"/>
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="PreviewMouseUp" >
                                                <i:InvokeCommandAction Command="{Binding Section.Distal.CmdSetCaptured}" CommandParameter="{StaticResource FalseValue}"/>
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="PreviewMouseMove" >
                                                <i:InvokeCommandAction Command="{Binding CmdMoveIndicator}" CommandParameter="{Binding Section.Distal}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </component:IndicatorImage>
                                </Canvas>
                            </Grid>
                            <ContentControl Grid.Row="1" Grid.Column="1" Template="{DynamicResource LongitudeScaleBar}" Width="{x:Static const:Constants.LongitudeFfrWidth}" Tag="{Binding PatientCase.PullbackLength}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Separator Grid.Row="1" Background="{DynamicResource GrayscaleGray5Brush}"/>
                <Border Grid.Row="2" CornerRadius="0,0,10,10" Background="{DynamicResource GrayscaleGray6Brush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Left" Margin="16,16,0,0">
                            <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding BackCommand}" Content="{Binding [Back], Source={StaticResource L10N}}" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityReverseConverter}, ConverterParameter={x:Static const:Constants.FfrStep1}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="0,16,16,0">
                            <Button Style="{StaticResource OutlinedBtnType4-Large}" Command="{Binding NextCommand}" Content="{Binding [Next], Source={StaticResource L10N}}" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityConverter}, ConverterParameter={x:Static const:Constants.FfrStep1}}" IsEnabled="{Binding IsNextEnabled}"/>
                            <Button Style="{StaticResource OutlinedBtnType4-Large}" Command="{Binding NextCommand}" Content="{Binding [Next], Source={StaticResource L10N}}" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityConverter}, ConverterParameter={x:Static const:Constants.FfrStep2}}"/>
                            <Button Style="{StaticResource OutlinedBtnType4-Large}" Command="{Binding NextCommand}" Content="{Binding [Next], Source={StaticResource L10N}}" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityConverter}, ConverterParameter={x:Static const:Constants.FfrStep3}}" IsEnabled="{Binding IsMlaEnabled}"/>
                            <Button Style="{StaticResource OutlinedBtnType4-Large}" Command="{Binding NextCommand}" Content="{Binding [Next], Source={StaticResource L10N}}" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityConverter}, ConverterParameter={x:Static const:Constants.FfrStep4}}" IsEnabled="{Binding FfrFeature.IsPlaqueAreaValid}"/>
                            <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Command="{Binding ConfirmCommand}" Content="{Binding [Confirm], Source={StaticResource L10N}}" Visibility="{Binding FfrStep, Converter={StaticResource RadioButtonVisibilityConverter}, ConverterParameter={x:Static const:Constants.FfrStep5}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="2" Height="40" Background="{DynamicResource GrayscaleBlackBrush}"/>
        </Grid>

        <!-- Indicator : SectionProximal -->
        <component:IndicatorAreaGrid Style="{DynamicResource IndicatorAreaGrid}" IsCaptured="{Binding Section.Proximal.IsCaptured}" Visibility="{Binding Section.Proximal.IsEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
            <i:Interaction.Behaviors>
                <behaviors:MouseBehavior MouseX="{Binding Section.Proximal.PointLongitudeX, Mode=OneWayToSource}"/>
            </i:Interaction.Behaviors>

            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseLeave" >
                    <i:InvokeCommandAction Command="{Binding Section.Proximal.CmdSetCaptured}" CommandParameter="{StaticResource FalseValue}"/>
                </i:EventTrigger>
                <i:EventTrigger EventName="PreviewMouseUp" >
                    <i:InvokeCommandAction Command="{Binding Section.Proximal.CmdSetCaptured}" CommandParameter="{StaticResource FalseValue}"/>
                </i:EventTrigger>
                <i:EventTrigger EventName="PreviewMouseMove" >
                    <i:InvokeCommandAction Command="{Binding CmdMoveIndicator}" CommandParameter="{Binding Section.Proximal}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </component:IndicatorAreaGrid>
        <!-- Indicator : SectionDistal -->
        <component:IndicatorAreaGrid Style="{DynamicResource IndicatorAreaGrid}" IsCaptured="{Binding Section.Distal.IsCaptured}" Visibility="{Binding Section.Distal.IsEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
            <i:Interaction.Behaviors>
                <behaviors:MouseBehavior MouseX="{Binding Section.Distal.PointLongitudeX, Mode=OneWayToSource}"/>
            </i:Interaction.Behaviors>

            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseLeave" >
                    <i:InvokeCommandAction Command="{Binding Section.Distal.CmdSetCaptured}" CommandParameter="{StaticResource FalseValue}"/>
                </i:EventTrigger>
                <i:EventTrigger EventName="PreviewMouseUp" >
                    <i:InvokeCommandAction Command="{Binding Section.Distal.CmdSetCaptured}" CommandParameter="{StaticResource FalseValue}"/>
                </i:EventTrigger>
                <i:EventTrigger EventName="PreviewMouseMove" >
                    <i:InvokeCommandAction Command="{Binding CmdMoveIndicator}" CommandParameter="{Binding Section.Distal}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </component:IndicatorAreaGrid>

        <i:Interaction.Behaviors>
            <behaviors:MouseBehavior MouseX="{Binding ReviewStatus.ZoomFfr.MouseX, Mode=OneWayToSource}" MouseY="{Binding ReviewStatus.ZoomFfr.MouseY, Mode=OneWayToSource}" />
        </i:Interaction.Behaviors>
        <i:Interaction.Triggers>
            <i:EventTrigger EventName="MouseLeave" >
                <i:InvokeCommandAction Command="{Binding ReviewStatus.ZoomFfr.CmdSetCaptured}"/>
            </i:EventTrigger>
            <i:EventTrigger EventName="PreviewMouseUp" >
                <i:InvokeCommandAction Command="{Binding ReviewStatus.ZoomFfr.CmdSetCaptured}"/>
            </i:EventTrigger>
            <i:EventTrigger EventName="PreviewMouseMove" >
                <i:InvokeCommandAction Command="{Binding ReviewStatus.ZoomFfr.CmdMoveRect}" CommandParameter="{Binding ReviewStatus.ZoomFfr}"/>
            </i:EventTrigger>
        </i:Interaction.Triggers>
    </Grid>
</Page>
