<Application x:Class="RaywattApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RaywattApp"
             xmlns:localization="clr-namespace:RaywattApp.Common.Localization"
             StartupUri="/Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ConverterRd.xaml" />
                <ResourceDictionary Source="/Styles/GlobalStyle.xaml" />
                <ResourceDictionary Source="/Styles/ButtonStyle.xaml" />
                <ResourceDictionary Source="/Styles/GridStyle.xaml" />
                <ResourceDictionary Source="/Styles/IconStyle.xaml" />
                <ResourceDictionary Source="/Styles/SelectItemStyle.xaml" />
                <ResourceDictionary Source="/Styles/TextStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <localization:DynamicResource x:Key="L10N"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
