<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:ut="clr-namespace:RaywattApp.Common.Util"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="Label">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style TargetType="Label" x:Key="ProcedureLabel">
        <Setter Property="Width" Value="79"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <Grid>
                        <Border x:Name="border" CornerRadius="13" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="{DynamicResource PreLabelBackgroundBrush}">
                            <Grid Background="Transparent"/>
                        </Border>
                        <TextBlock x:Name="text" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{TemplateBinding Content}" Foreground="{DynamicResource PreLabelForegroundBrush}" FontFamily="Pretendard" FontWeight="Medium" FontSize="14px"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="$001">
                            <Setter Property="Width" Value="79"/>
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource PreLabelBackgroundBrush}"/>
                            <Setter TargetName="text" Property="Foreground" Value="{DynamicResource PreLabelForegroundBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="$002">
                            <Setter Property="Width" Value="86"/>
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource PostLabelBackgroundBrush}"/>
                            <Setter TargetName="text" Property="Foreground" Value="{DynamicResource PostLabelForegroundBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="$003">
                            <Setter Property="Width" Value="93"/>
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource FULabelBackgroundBrush}"/>
                            <Setter TargetName="text" Property="Foreground" Value="{DynamicResource FULabelForegroundBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Label" x:Key="LabelWithCorner" BasedOn="{StaticResource Pretendard-Medium-18}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource GrayscaleGray3Brush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <Border x:Name="border" CornerRadius="8" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray5Brush}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Label" x:Key="InfoTitleLabel">
        <Setter Property="Width" Value="90"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="FontFamily" Value="Pretendard"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource CaseInfoSecondBrush}"/>
    </Style>
    
    <Style TargetType="Label" x:Key="InfoValueLabel" BasedOn="{StaticResource InfoTitleLabel}">
        <Setter Property="Width" Value="102"/>
        <Setter Property="Foreground" Value="{DynamicResource CaseValueBrush}"/>
    </Style>

    <Style TargetType="TextBox" x:Key="TextBoxBase" BasedOn="{StaticResource Pretendard-Medium-18}">
        <Setter Property="Cursor" Value="{StaticResource iBeam}"/>
        <Setter Property="Width" Value="408"/>
        <Setter Property="Height" Value="70"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource MainPrimaryColorBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.30"/>
        <Setter Property="CaretBrush" Value="{DynamicResource GrayscaleWhiteBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource GrayscaleWhiteBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Border x:Name="border" Height="54" CornerRadius="8" BorderBrush="{DynamicResource GrayscaleGray5Brush}" BorderThickness="1" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="1" x:Name="placeholder" Content="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Tag}" Foreground="{DynamicResource GrayscaleGray3Brush}" Visibility="Collapsed" Focusable="false" VerticalAlignment="Center"/>
                                <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" Focusable="false" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsFocused" Value="False"/>
                                <Condition Property="Text" Value=""/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource MainPrimaryColorBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="False">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource GrayscaleGray5Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" x:Key="TextBoxWithCorner" BasedOn="{StaticResource Pretendard-Medium-18}">
        <Setter Property="Cursor" Value="{StaticResource iBeam}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource MainPrimaryColorBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.30"/>
        <Setter Property="Foreground" Value="{DynamicResource GrayscaleGray3Brush}"/>
        <Setter Property="Height" Value="54"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Border x:Name="border" Height="54" CornerRadius="8" BorderBrush="{DynamicResource GrayscaleGray5Brush}" BorderThickness="1" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="1" x:Name="placeholder" Content="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Tag}" Foreground="{DynamicResource GrayscaleGray3Brush}" Visibility="Collapsed" Focusable="false" VerticalAlignment="Center"/>
                                <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" Focusable="false" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" x:Key="TextBoxReadOnly" BasedOn="{StaticResource Pretendard-Medium-16}">
        <Setter Property="Cursor" Value="{StaticResource iBeam}"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource MainPrimaryColorBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.30"/>
        <Setter Property="Foreground" Value="{DynamicResource GrayscaleWhiteBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="TextBox" x:Key="TextBoxValidator" BasedOn="{StaticResource TextBoxBase}">
        <Setter Property="ToolTipService.IsEnabled" Value="False"/>
        <Setter Property="Height" Value="72"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource MainPrimaryColorBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54"/>
                            <RowDefinition Height="18"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="border" Height="54" CornerRadius="8" BorderBrush="{DynamicResource GrayscaleGray5Brush}" BorderThickness="1" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="1" x:Name="placeholder" Content="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Tag}" Foreground="{DynamicResource GrayscaleGray3Brush}" Visibility="Collapsed" Focusable="false" VerticalAlignment="Center"/>
                                <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" Focusable="false" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" x:Name="validator" Orientation="Horizontal" Visibility="Collapsed" Margin="0,4,0,0">
                            <Label Content="* " Foreground="{DynamicResource AdditionalColor3Brush}" FontSize="12"/>
                            <Label Content="{TemplateBinding ToolTip}" Foreground="{DynamicResource AdditionalColor3Brush}" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsFocused" Value="False"/>
                                <Condition Property="Text" Value=""/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource MainPrimaryColorBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="False">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource GrayscaleGray5Brush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding RelativeSource={x:Static RelativeSource.Self},Path=ToolTip, Converter={StaticResource NotEmptyStringToEnableConverter}}" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AdditionalColor3Brush}"/>
                            <Setter TargetName="validator" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" x:Key="TextBoxIpAddress" BasedOn="{StaticResource Pretendard-Medium-18}">
        <Setter Property="Cursor" Value="{StaticResource iBeam}"/>
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource MainPrimaryColorBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.30"/>
        <Setter Property="CaretBrush" Value="{DynamicResource GrayscaleWhiteBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource GrayscaleWhiteBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MaxLength" Value="3"/>
    </Style>

    <Style TargetType="PasswordBox" x:Key="PasswordBoxValidator">
        <Setter Property="Cursor" Value="{StaticResource iBeam}"/>
        <Setter Property="Width" Value="408"/>
        <Setter Property="Height" Value="70"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource MainPrimaryColorBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.30"/>
        <Setter Property="CaretBrush" Value="{DynamicResource GrayscaleWhiteBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource GrayscaleWhiteBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54"/>
                            <RowDefinition Height="18"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="border"
                            Height="54"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource GrayscaleGray5Brush}"
                            BorderThickness="1"
                            Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <!-- Placeholder -->
                                <Label Grid.Column="1" 
                                       x:Name="placeholder" 
                                       Content="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Tag}" 
                                       Foreground="{DynamicResource GrayscaleGray3Brush}" 
                                       Visibility="Collapsed" 
                                       Focusable="false" 
                                       FontSize="20"
                                       VerticalAlignment="Center"/>


                                <!-- Password Content -->
                                <ScrollViewer x:Name="PART_ContentHost"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>

                        <!-- Validator 메시지 -->
                        <StackPanel Grid.Row="1"
                                x:Name="validator"
                                Orientation="Horizontal"
                                Visibility="Collapsed"
                                Margin="0,4,0,0">
                            <Label Content="* "
                               Foreground="{DynamicResource AdditionalColor3Brush}"
                               FontSize="12"/>
                            <Label Content="{TemplateBinding ToolTip}"
                               Foreground="{DynamicResource AdditionalColor3Brush}"
                               FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=(ut:PasswordBoxHelper.BindablePassword), RelativeSource={RelativeSource Mode=Self}}" Value="">
                            <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                        </DataTrigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource MainPrimaryColorBrush}"/>
                        </Trigger>

                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip, Converter={StaticResource NotEmptyStringToEnableConverter}}" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AdditionalColor3Brush}"/>
                            <Setter TargetName="validator" Property="Visibility" Value="Visible"/>
                        </DataTrigger>

                        <!-- Focus 색상 -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource MainPrimaryColorBrush}"/>
                        </Trigger>

                        <Trigger Property="IsFocused" Value="False">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource GrayscaleGray5Brush}"/>
                        </Trigger>

                        <!-- Validator 표시 -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip, Converter={StaticResource NotEmptyStringToEnableConverter}}" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AdditionalColor3Brush}"/>
                            <Setter TargetName="validator" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>