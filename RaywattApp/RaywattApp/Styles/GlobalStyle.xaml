<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="Separator">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Padding" Value="0,0,0,0"/>
        <Setter Property="FontFamily" Value="Pretendard"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontStyle" Value="Normal"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="#0d0d0d"/>
        <Setter Property="Foreground" Value="#ffffff"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#0d0d0d" CornerRadius="4" Height="24" Padding="14,5,14,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Color -->
    <Color x:Key="GrayscaleWhite">#ffffff</Color>
    <Color x:Key="GrayscaleGray1">#f2f2f2</Color>
    <Color x:Key="GrayscaleGray2">#e4e4e4</Color>
    <Color x:Key="GrayscaleGray3">#b1b1b1</Color>
    <Color x:Key="GrayscaleGray4">#8d8d8d</Color>
    <Color x:Key="GrayscaleGray5">#4f4f4f</Color>
    <Color x:Key="GrayscaleGray6">#333333</Color>
    <Color x:Key="GrayscaleGray7">#232323</Color>
    <Color x:Key="GrayscaleGray8">#161616</Color>
    <Color x:Key="GrayscaleBlack">#0d0d0d</Color>

    <Color x:Key="MainPrimaryColor"     >#1ed760</Color>
    <Color x:Key="MainSecondaryColor"   >#1ebe57</Color>
    <Color x:Key="MainTertiaryColor"    >#26a353</Color>
    <Color x:Key="MainBackgroundColor"  >#c7efd5</Color>

    <Color x:Key="AdditionalColor1">#343434</Color>
    <Color x:Key="AdditionalColor2">#385042</Color>
    <Color x:Key="AdditionalColor3">#ff4d8b</Color>

    <SolidColorBrush x:Key="GrayscaleWhiteBrush" Color="{StaticResource GrayscaleWhite}"/>
    <SolidColorBrush x:Key="GrayscaleGray1Brush" Color="{StaticResource GrayscaleGray1}"/>
    <SolidColorBrush x:Key="GrayscaleGray2Brush" Color="{StaticResource GrayscaleGray2}"/>
    <SolidColorBrush x:Key="GrayscaleGray3Brush" Color="{StaticResource GrayscaleGray3}"/>
    <SolidColorBrush x:Key="GrayscaleGray4Brush" Color="{StaticResource GrayscaleGray4}"/>
    <SolidColorBrush x:Key="GrayscaleGray5Brush" Color="{StaticResource GrayscaleGray5}"/>
    <SolidColorBrush x:Key="GrayscaleGray6Brush" Color="{StaticResource GrayscaleGray6}"/>
    <SolidColorBrush x:Key="GrayscaleGray7Brush" Color="{StaticResource GrayscaleGray7}"/>
    <SolidColorBrush x:Key="GrayscaleGray8Brush" Color="{StaticResource GrayscaleGray8}"/>
    <SolidColorBrush x:Key="GrayscaleBlackBrush" Color="{StaticResource GrayscaleBlack}"/>

    <SolidColorBrush x:Key="MainPrimaryColorBrush"      Color="{StaticResource MainPrimaryColor}"/>
    <SolidColorBrush x:Key="MainSecondaryColorBrush"    Color="{StaticResource MainSecondaryColor}"/>
    <SolidColorBrush x:Key="MainTertiaryColorBrush"     Color="{StaticResource MainTertiaryColor}"/>
    <SolidColorBrush x:Key="MainBackgroundColorBrush"   Color="{StaticResource MainBackgroundColor}"/>

    <SolidColorBrush x:Key="AdditionalColor1Brush" Color="{StaticResource AdditionalColor1}"/>
    <SolidColorBrush x:Key="AdditionalColor2Brush" Color="{StaticResource AdditionalColor2}"/>
    <SolidColorBrush x:Key="AdditionalColor3Brush" Color="{StaticResource AdditionalColor3}"/>
    
    <SolidColorBrush x:Key="BackgroundBrush" Color="#161616"/>
    <SolidColorBrush x:Key="SideCardBackgroundBrush" Color="#232323"/>
    <SolidColorBrush x:Key="BottomCardBackgroundBrush" Color="#232323"/>
    <SolidColorBrush x:Key="SideMenuTitleBrush" Color="#b1b1b1"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#494949"/>
    <SolidColorBrush x:Key="VerticalSeparatorBrush" Color="#4f4f4f"/>
    <SolidColorBrush x:Key="MainThemeBrush" Color="#1ed760"/>
    <SolidColorBrush x:Key="MainThemePressedBrush" Color="#26a353"/>
    <SolidColorBrush x:Key="TabMenuDefaultBrush" Color="#4f4f4f"/>    
    <SolidColorBrush x:Key="CaseInfoFirstBrush" Color="#fcfcfc"/>    
    <SolidColorBrush x:Key="CaseInfoSecondBrush" Color="#8d8d8d"/>    
    <SolidColorBrush x:Key="CaseValueBrush" Color="#b1b1b1"/>
    <SolidColorBrush x:Key="ValueInfoLabelBrush" Color="#a3a3a3"/>
    <SolidColorBrush x:Key="ValueInfoValueBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="PreLabelBackgroundBrush" Color="#b1b1b1"/>
    <SolidColorBrush x:Key="PreLabelForegroundBrush" Color="#232323"/>
    <SolidColorBrush x:Key="PostLabelBackgroundBrush" Color="#4f4f4f"/>
    <SolidColorBrush x:Key="PostLabelForegroundBrush" Color="#fcfcfc"/>
    <SolidColorBrush x:Key="FULabelBackgroundBrush" Color="#333333"/>
    <SolidColorBrush x:Key="FULabelForegroundBrush" Color="#fcfcfc"/>

