    <Style TargetType="Button" x:Key="Import_Icon">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Margin" Value="0,9,6,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Image x:Name="img" Source="{svgc:SvgImage Source=/res/icon/import.svg}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="img" Property="Source" Value="{svgc:SvgImage Source=/res/icon/import.svg}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="img" Property="Source" Value="{svgc:SvgImage Source=/res/icon/import_hover.svg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="img" Property="Source" Value="{svgc:SvgImage Source=/res/icon/import_active.svg}"/>
                        </Trigger>
