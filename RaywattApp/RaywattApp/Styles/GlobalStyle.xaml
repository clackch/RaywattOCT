<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="Label">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Padding" Value="0,0,0,0"/>
        <Setter Property="FontFamily" Value="Pretendard"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontStyle" Value="Normal"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="#0d0d0d"/>
        <Setter Property="Foreground" Value="#ffffff"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#0d0d0d" CornerRadius="4" Height="24" Padding="14,5,14,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- Color -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#161616"/>
    <SolidColorBrush x:Key="SideCardBackgroundBrush" Color="#232323"/>
    <SolidColorBrush x:Key="BottomCardBackgroundBrush" Color="#232323"/>
    <SolidColorBrush x:Key="SideMenuTitleBrush" Color="#b1b1b1"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#494949"/>
    <SolidColorBrush x:Key="VerticalSeparatorBrush" Color="#4f4f4f"/>
    <SolidColorBrush x:Key="MainThemeBrush" Color="#1ed760"/>
    <SolidColorBrush x:Key="MainThemePressedBrush" Color="#26a353"/>
    <SolidColorBrush x:Key="TabMenuDefaultBrush" Color="#4f4f4f"/>    
    <SolidColorBrush x:Key="CaseInfoFirstBrush" Color="#fcfcfc"/>    
    <SolidColorBrush x:Key="CaseInfoSecondBrush" Color="#8d8d8d"/>    
    <SolidColorBrush x:Key="CaseValueBrush" Color="#b1b1b1"/>
    <SolidColorBrush x:Key="ValueInfoLabelBrush" Color="#a3a3a3"/>
    <SolidColorBrush x:Key="ValueInfoValueBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="PreLabelBackgroundBrush" Color="#b1b1b1"/>
    <SolidColorBrush x:Key="PreLabelForegroundBrush" Color="#232323"/>
    <SolidColorBrush x:Key="PostLabelBackgroundBrush" Color="#4f4f4f"/>
    <SolidColorBrush x:Key="PostLabelForegroundBrush" Color="#fcfcfc"/>
    <SolidColorBrush x:Key="FULabelBackgroundBrush" Color="#333333"/>
    <SolidColorBrush x:Key="FULabelForegroundBrush" Color="#fcfcfc"/>

    <!-- Toggle Button -->
    <Style TargetType="ToggleButton" x:Key="ContainedToggleBtnType2-Small">
        <Setter Property="Width" Value="120"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="border" CornerRadius="4" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" BorderThickness="1" BorderBrush="Transparent">
                            <Grid Background="Transparent"/>
                        </Border>
                        <TextBlock x:Name="title" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{TemplateBinding Content}" Foreground="#4f4f4f" FontFamily="Pretendard" FontWeight="Medium" FontSize="14px"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="True">
                            <Setter TargetName="border" Property="Background" Value="Transparent"/>
                            <Setter TargetName="border" Property="Opacity" Value="1.0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="title" Property="Foreground" Value="{DynamicResource MainThemeBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.08"/>
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource MainThemeBrush}"/>
                            <Setter TargetName="title" Property="Foreground" Value="{DynamicResource MainThemeBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToggleButton" x:Key="TabToggleBtn">
        <Setter Property="Width" Value="92"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="21"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="text" Grid.Row="1" Text="{TemplateBinding Content}" HorizontalAlignment="Center" FontFamily="Pretendard" FontWeight="Medium" FontSize="18" Foreground="{DynamicResource TabMenuDefaultBrush}"/>
                        <Separator x:Name="separator" Grid.Row="2" Height="4" VerticalAlignment="Bottom" Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="True">
                            <Setter TargetName="text" Property="Foreground" Value="{DynamicResource TabMenuDefaultBrush}"/>
                            <Setter TargetName="separator" Property="Background" Value="Transparent"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="text" Property="Foreground" Value="White"/>
                            <Setter TargetName="separator" Property="Background" Value="{DynamicResource MainThemeBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- font -->
