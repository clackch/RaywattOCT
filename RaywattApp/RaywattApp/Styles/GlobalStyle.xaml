    <Style TargetType="Button" x:Key="Export_Icon">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Margin" Value="0,9,118,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Image x:Name="img" Source="{svgc:SvgImage Source=/res/icon/export.svg}"/>
                    </Grid>
