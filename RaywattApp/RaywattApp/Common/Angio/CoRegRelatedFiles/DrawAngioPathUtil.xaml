<UserControl 
    x:Class="RaywattApp.Common.Angio.CoRegRelatedFiles.DrawAngioPathUtil"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:const="clr-namespace:RaywattApp.Common.Bases"
    
    mc:Ignorable="d" 
    x:Name="UserControl"
    d:DesignHeight="580" d:DesignWidth="580">

    <UserControl.Resources>
        <Style TargetType="Rectangle" x:Key="StyleRectangle">
            <Setter Property="Width" Value="{x:Static const:Constants.AnnotationRectWidth}"/>
            <Setter Property="Height" Value="{x:Static const:Constants.AnnotationRectHeight}"/>
            <Setter Property="StrokeThickness" Value="{x:Static const:Constants.AnnotationStrokeThickness}"/>
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="Fill" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Stroke" Value="Green"/>
                    <Setter Property="Cursor" Value="{StaticResource hand}"/>
                </Trigger>
                <Trigger Property="IsMouseCaptured" Value="True">
                    <Setter Property="Stroke" Value="Green"/>
                    <Setter Property="Cursor" Value="{StaticResource grab}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Ellipse" x:Key="StylePathEllipse">
            <Setter Property="Width" Value="{x:Static const:Constants.ellipsePathWidth}"/>
            <Setter Property="Height" Value="{x:Static const:Constants.ellipsePathHeight}"/>
            <Setter Property="Fill" Value="Yellow"/>
        </Style>
        <Style TargetType="Ellipse" x:Key="StyleTrackEllipse">
            <Setter Property="Width" Value="{x:Static const:Constants.ellipsePathWidth}"/>
            <Setter Property="Height" Value="{x:Static const:Constants.ellipsePathHeight}"/>
            <Setter Property="Fill" Value="White"/>
        </Style>

        <Style TargetType="Line" x:Key="StyleLine">
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="{x:Static const:Constants.AnnotationStrokeThickness}"/>
        </Style>
        <Style TargetType="Path" x:Key="StylePath">
            <Setter Property="StrokeThickness" Value="{x:Static const:Constants.AnnotationStrokeThickness}"/>
            <Setter Property="Stroke" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid Width="{x:Static const:Constants.AngioSize}" Height="{x:Static const:Constants.AngioSize}">
        <Grid.Clip>
            <RectangleGeometry RadiusX="10" RadiusY="10">
                <RectangleGeometry.Rect>
                    <Rect X="0" Y="0" Width="{x:Static const:Constants.AngioSize}" Height="{x:Static const:Constants.AngioSize}"/>
                </RectangleGeometry.Rect>
            </RectangleGeometry>
        </Grid.Clip>
        <Canvas Name="canvas"/>
    </Grid>
</UserControl>
