<UserControl x:Class="RaywattApp.Common.Annotation.DrawLumenContourUtil"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Common.Annotation"
             mc:Ignorable="d" 
             x:Name="UserControl"
             d:DesignHeight="640" d:DesignWidth="640">

    <UserControl.Resources>
        <Style TargetType="Rectangle" x:Key="StyleRectangle">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="Fill" Value="White"/>
        </Style>
        <Style TargetType="Line" x:Key="StyleLine">
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsEditOn, ElementName=UserControl}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Cursor" Value="Pen"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsContourMouseOver, ElementName=UserControl}" Value="True">
                    <Setter Property="StrokeThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Path" x:Key="StylePath">
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeDashArray" Value="2"/>
        </Style>
        <Style TargetType="Path" x:Key="StylePathDiameter">
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Stroke" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsContourMouseOver, ElementName=UserControl}" Value="True">
                    <Setter Property="Stroke" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Path" x:Key="StylePathBackground">
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Stroke" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Canvas Name="canvasBackground"/>
        <Canvas Name="canvas"/>
    </Grid>
</UserControl>
