<UserControl x:Class="RaywattApp.Common.Annotation.DrawUtil"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Common.Annotation"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             x:Name="UserControl"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <System:Double x:Key="CrossSectionSize">640</System:Double>
        <System:Double x:Key="SideBarExpand">250</System:Double>
        <System:Double x:Key="SideBarCollapse">50</System:Double>
        
        <Style TargetType="Canvas">
            <Style.Triggers>
                <DataTrigger Binding="{Binding MouseCursor, ElementName=UserControl}" Value="1">
                    <Setter Property="Cursor" Value="Pen"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MouseCursor, ElementName=UserControl}" Value="2">
                    <Setter Property="Cursor" Value="Cross"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MouseCursor, ElementName=UserControl}" Value="3">
                    <Setter Property="Cursor" Value="UpArrow"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Path" x:Key="StylePath">
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>
        <Style TargetType="Path" x:Key="StylePathCurve" BasedOn="{StaticResource StylePath}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Pen"/>
                    <Setter Property="StrokeThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Rectangle" x:Key="StyleRectangle">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Fill" Value="White"/>
        </Style>
        <Style TargetType="Rectangle" x:Key="StyleRectangleClosed" BasedOn="{StaticResource StyleRectangle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="StrokeThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Rectangle" x:Key="StyleRectangleFirst">
            <Setter Property="Cursor" Value="Cross"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>
        <Style TargetType="Label" x:Key="StyleLabel">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style TargetType="Label" x:Key="StyleLabelText">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Ellipse" x:Key="StyleEllipse">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Fill" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="StrokeThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox" x:Key="StyleTextBox">
            <Setter Property="MinWidth" Value="50"/>
        </Style>
    </UserControl.Resources>

    <Grid Height="{StaticResource CrossSectionSize}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Width="{StaticResource CrossSectionSize}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Canvas Grid.RowSpan="2" Name="canvasBackground" Background="Transparent"/>
            <Canvas Grid.RowSpan="2" Name="canvas" Background="Transparent"/>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button Height="20" Content="Area" Click="area_Add"/>
                <Button Height="20" Content="Length" Click="length_Add"/>
                <Button Height="20" Content="Text" Click="text_Add"/>
                <Button Height="20" Content="Delete All" Click="delete_All"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1" HorizontalAlignment="Right" Background="White" Width="{StaticResource SideBarExpand}">
            <Grid HorizontalAlignment="Right" Width="{StaticResource SideBarExpand}" Visibility="{Binding MeasurementExpand, ElementName=UserControl, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" >
                    <Button Content="Measurment ≫" Click="toggle_Measurement"/>
                    <Separator/>
                </StackPanel>
                <Label Grid.Row="1" Content="{Binding [Area], Source={StaticResource L10N}}"/>
                <DataGrid Grid.Row="2" ItemsSource="{Binding CurrAreaGeometries, ElementName=UserControl}" Style="{StaticResource DataGridBasic}">
                    <DataGrid.Columns>
                        <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" Width="*" Binding="{Binding Group, Converter={StaticResource GroupNameConverter}}" Header="{Binding [Name], Source={StaticResource L10N}}"/>
                        <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" Width="*" Binding="{Binding Area, StringFormat={}{0:N3}}" Header="{Binding [Area(㎟)], Source={StaticResource L10N}}"/>
                        <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" Width="*" Binding="{Binding MeanDiameter, StringFormat={}{0:N3}}" Header="{Binding [Mean Diameter(㎜)], Source={StaticResource L10N}}"/>
                        <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" Width="*" Binding="{Binding MinDiameter.diameter, StringFormat={}{0:N3}}" Header="{Binding [Min Diameter(㎜)], Source={StaticResource L10N}}"/>
                        <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" Width="*" Binding="{Binding MaxDiameter.diameter, StringFormat={}{0:N3}}" Header="{Binding [Max Diameter(㎜)], Source={StaticResource L10N}}"/>
                        <DataGridTemplateColumn Header="Delete">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="delete_Area" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=CurrentItem}" Content="X"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Label Grid.Row="3" Content="{Binding [Length], Source={StaticResource L10N}}"/>
                <DataGrid Grid.Row="4" ItemsSource="{Binding CurrLengthGeometries, ElementName=UserControl}" Style="{StaticResource DataGridBasic}">
                    <DataGrid.Columns>
                        <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" Width="*" Binding="{Binding Group, Converter={StaticResource GroupNameConverter}}" Header="{Binding [Name], Source={StaticResource L10N}}"/>
                        <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" Width="*" Binding="{Binding Length, StringFormat={}{0:N3}}" Header="{Binding [Length(㎜)], Source={StaticResource L10N}}"/>
                        <DataGridTemplateColumn Header="Delete">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="delete_Length" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=CurrentItem}" Content="X"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Separator Grid.Row="5"/>
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="◀" Click="move_Frame" CommandParameter="prev"/>
                    <Button Content="▶" Click="move_Frame" CommandParameter="next"/>
                </StackPanel>
            </Grid>
            <Grid HorizontalAlignment="Right" Width="{StaticResource SideBarCollapse}" Visibility="{Binding MeasurementExpand, ElementName=UserControl, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" >
                    <Button Content="≪"  Click="toggle_Measurement"/>
                    <Separator/>
                </StackPanel>
                <StackPanel Grid.Row="1">

                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
    

</UserControl>
