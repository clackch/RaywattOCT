<UserControl x:Class="RaywattApp.Common.Annotation.DrawUtil"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Common.Annotation"
             mc:Ignorable="d" 
             x:Name="UserControl"
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <Style TargetType="Canvas">
            <Style.Triggers>
                <DataTrigger Binding="{Binding MouseCursor, ElementName=UserControl}" Value="1">
                    <Setter Property="Cursor" Value="Pen"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MouseCursor, ElementName=UserControl}" Value="2">
                    <Setter Property="Cursor" Value="Cross"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MouseCursor, ElementName=UserControl}" Value="3">
                    <Setter Property="Cursor" Value="UpArrow"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Path" x:Key="StylePath">
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>
        <Style TargetType="Path" x:Key="StylePathCurve" BasedOn="{StaticResource StylePath}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Pen"/>
                    <Setter Property="StrokeThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Rectangle" x:Key="StyleRectangle">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Fill" Value="White"/>
        </Style>
        <Style TargetType="Rectangle" x:Key="StyleRectangleClosed" BasedOn="{StaticResource StyleRectangle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="StrokeThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Rectangle" x:Key="StyleRectangleFirst">
            <Setter Property="Cursor" Value="Cross"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>
        <Style TargetType="Label" x:Key="StyleLabel">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style TargetType="Label" x:Key="StyleLabelText">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Ellipse" x:Key="StyleEllipse">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Fill" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="StrokeThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox" x:Key="StyleTextBox">
            <Setter Property="MinWidth" Value="50"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Canvas Grid.RowSpan="2" Name="canvas" Background="Transparent"/>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Height="20" Content="Area" Click="area_Add"/>
            <Button Height="20" Content="Length" Click="length_Add"/>
            <Button Height="20" Content="Text" Click="text_Add"/>
            <Button Height="20" Content="Delete All" Click="delete_All"/>
        </StackPanel>
    </Grid>
</UserControl>
