<UserControl x:Class="RaywattApp.Common.Annotation.DrawLmodeUtil"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Common.Annotation"
             xmlns:const="clr-namespace:RaywattApp.Common.Bases"
             mc:Ignorable="d" 
             x:Name="UserControl"
             d:DesignHeight="180" d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="Canvas">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CommandType, ElementName=UserControl}" Value="1">
                    <Setter Property="Cursor" Value="{StaticResource measureArea}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CommandType, ElementName=UserControl}" Value="2">
                    <Setter Property="Cursor" Value="{StaticResource measureLength}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CommandType, ElementName=UserControl}" Value="3">
                    <Setter Property="Cursor" Value="{StaticResource measureText}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CommandType, ElementName=UserControl}" Value="4">
                    <Setter Property="Cursor" Value="{StaticResource measureErase}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Path" x:Key="StylePath">
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>
        <Style TargetType="Path" x:Key="StylePathCurve" BasedOn="{StaticResource StylePath}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                        <Condition Binding="{Binding CommandType, ElementName=UserControl}" Value="0"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Cursor" Value="{StaticResource measureArea}"/>
                    <Setter Property="StrokeThickness" Value="3"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Rectangle" x:Key="StyleRectangle">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Fill" Value="White"/>
        </Style>
        <Style TargetType="Rectangle" x:Key="StyleRectangleClosed" BasedOn="{StaticResource StyleRectangle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                        <Condition Binding="{Binding CommandType, ElementName=UserControl}" Value="0"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="StrokeThickness" Value="3"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                        <Condition Binding="{Binding CommandType, ElementName=UserControl}" Value="4"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="StrokeThickness" Value="3"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Rectangle" x:Key="StyleRectangleFirst">
            <Setter Property="Cursor" Value="Cross"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>
        <Style TargetType="Label" x:Key="StyleLabel">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style TargetType="Label" x:Key="StyleLabelText">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                        <Condition Binding="{Binding CommandType, ElementName=UserControl}" Value="0"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource Self}, Path=BorderBrush}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                        <Condition Binding="{Binding CommandType, ElementName=UserControl}" Value="4"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource Self}, Path=BorderBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Ellipse" x:Key="StyleEllipse">
            <Setter Property="Width" Value="{x:Static const:Constants.AnnotationTextPointSize}"/>
            <Setter Property="Height" Value="{x:Static const:Constants.AnnotationTextPointSize}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Fill" Value="White"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                        <Condition Binding="{Binding CommandType, ElementName=UserControl}" Value="0"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="StrokeThickness" Value="3"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                        <Condition Binding="{Binding CommandType, ElementName=UserControl}" Value="4"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="StrokeThickness" Value="3"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox" x:Key="StyleTextBox">
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MaxLength" Value="50"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Canvas Name="canvas"/>
    </Grid>
</UserControl>
