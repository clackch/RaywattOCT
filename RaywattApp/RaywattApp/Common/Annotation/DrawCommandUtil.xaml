<UserControl x:Class="RaywattApp.Common.Annotation.DrawCommandUtil"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Common.Annotation"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="250">
    <Grid>
        <StackPanel Orientation="Horizontal">
            <Button Height="20" Content="Area" Click="area_Add"/>
            <Button Height="20" Content="Length" Click="length_Add"/>
            <Button Height="20" Content="Text" Click="text_Add"/>
            <Button Height="20" Content="Delete All" Click="delete_All"/>
        </StackPanel>
    </Grid>
</UserControl>
