                                                        <StackPanel Height="48" Orientation="Horizontal">
                                                            <Label Content="0.73" Style="{DynamicResource Pretendard-Bold-40}" Foreground="{DynamicResource ValueInfoValueBrush}" VerticalAlignment="Center"/>
                                                            <StackPanel Width="6"/>
                                                            <Label Content="{Binding [mm], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Medium-24}" Foreground="{DynamicResource ValueInfoLabelBrush}" VerticalAlignment="Bottom"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                    <StackPanel Orientation="Vertical">
                                        <StackPanel Height="24"/>
                                        <Grid Width="300" Height="300" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <!-- Indicator  -->
                                            <component:IndicatorImage Style="{DynamicResource IndicatorImage}" Width="300" Height="18" Icon="crossSectionAngio" IsCaptured="{Binding IndicatorCrossSection.IsCaptured}" Cursor="Hand" Visibility="{Binding IndicatorCrossSection.IsVisible}">
                                                <Image.RenderTransform>
                                                    <RotateTransform CenterX="150" CenterY="9" Angle="{Binding Degree}"/>
                                                </Image.RenderTransform>

                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="PreviewMouseDown" >
                                                        <i:InvokeCommandAction Command="{Binding IndicatorCrossSection.CmdSetCaptured}" CommandParameter="{StaticResource TrueValue}"/>
                                                    </i:EventTrigger>
                                                    <i:EventTrigger EventName="PreviewMouseUp" >
                                                        <i:InvokeCommandAction Command="{Binding IndicatorCrossSection.CmdSetCaptured}" CommandParameter="{StaticResource FalseValue}"/>
                                                    </i:EventTrigger>
                                                    <i:EventTrigger EventName="PreviewMouseMove" >
                                                        <i:InvokeCommandAction Command="{Binding CmdRotateIndicator}" CommandParameter="{Binding IndicatorCrossSection}"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </component:IndicatorImage>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <Button Grid.Row="1" HorizontalAlignment="Right" Visibility="{Binding ExpandRightMenu, Converter={StaticResource BoolToVisibilityReverseConverter}}" Command="{Binding ExpandCollapseCommand}" CommandParameter="{x:Static const:Constants.RightMenu}">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border CornerRadius="8,0,0,8" HorizontalAlignment="Right" Width="{x:Static const:Constants.SideBarCollapseSize}" Background="{StaticResource SideCardBackgroundBrush}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" >
                                                <Button Style="{DynamicResource SideMenuTitleRightCollapsed}" Command="{Binding ExpandCollapseCommand}" CommandParameter="{x:Static const:Constants.RightMenu}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center">
                                                <StackPanel Height="284"/>
                                                <Image Source="{svgc:SvgImage Source=/res/icon/ValueInfo.svg}" Width="24" Height="24"/>
                                                <StackPanel Height="8"/>
                                                <Image Source="{svgc:SvgImage Source=/res/icon/ValueInfoText.svg}" Width="32" Height="26"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>

                <!-- Calcium Indicator -->
                <Grid Grid.Row="0" Grid.RowSpan="3" Visibility="{Binding ReviewStatus.IsAngioOn, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                    <Image x:Name="CalciumIndicator" Width="{x:Static const:Constants.CalciumIndicatorSize}" Height="{x:Static const:Constants.CalciumIndicatorSize}" Source="{Binding CalciumIndicator}"/>
                    <Grid Width="{x:Static const:Constants.CalciumThicknessIndicatorSize}" Height="{x:Static const:Constants.CalciumThicknessIndicatorSize}" Background="Transparent">
                        <Image Width="14" Height="15.6" Source="{svgc:SvgImage Source=/res/icon/thicknessIndicator.svg}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        <Grid.RenderTransform>
                            <RotateTransform CenterX="{x:Static const:Constants.CalciumThicknessIndicatorCenter}" CenterY="{x:Static const:Constants.CalciumThicknessIndicatorCenter}" Angle="{Binding Degree}"/>
                        </Grid.RenderTransform>
                    </Grid>
                </Grid>

                <!-- Indicator  -->
                <Grid Grid.Row="1" Visibility="{Binding ReviewStatus.IsAngioOn, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                    <component:IndicatorImage Style="{DynamicResource IndicatorImage}" Width="640" Height="18" Icon="crossSection" IsCaptured="{Binding IndicatorCrossSection.IsCaptured}" Cursor="Hand" Visibility="{Binding IndicatorCrossSection.IsVisible}">
                        <Image.RenderTransform>
                            <RotateTransform CenterX="319" CenterY="9" Angle="{Binding Degree}"/>
                        </Image.RenderTransform>

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseDown" >
                                <i:InvokeCommandAction Command="{Binding IndicatorCrossSection.CmdSetCaptured}" CommandParameter="{StaticResource TrueValue}"/>
                            </i:EventTrigger>
                            <i:EventTrigger EventName="PreviewMouseUp" >
                                <i:InvokeCommandAction Command="{Binding IndicatorCrossSection.CmdSetCaptured}" CommandParameter="{StaticResource FalseValue}"/>
                            </i:EventTrigger>
                            <i:EventTrigger EventName="PreviewMouseMove" >
                                <i:InvokeCommandAction Command="{Binding CmdRotateIndicator}" CommandParameter="{Binding IndicatorCrossSection}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </component:IndicatorImage>
                </Grid>

                <!-- Measurement -->
                <annotation:DrawUtil Grid.Row="1" Width="{x:Static const:Constants.CrossSectionSize}" Height="{x:Static const:Constants.CrossSectionSize}" Visibility="{Binding ReviewStatus.IsMeasurementOn, Converter={StaticResource BoolToVisibilityConverter}}" Measurements="{Binding Measurements}" FrameNumber="{Binding MeasurementFrameNumber}" InCommand="{Binding MeasurementCommand, Mode=TwoWay}" IsHitTestVisible="{Binding IndicatorCrossSection.IsCaptured, Converter={StaticResource InverseBooleanConverter}}" IsEnabled="{Binding IndicatorCrossSection.IsCaptured, Converter={StaticResource InverseBooleanConverter}}"/>

                <!-- Longitude Part -->
                <Grid Grid.Row="3" Background="{StaticResource BottomCardBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="51"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="184"/>
                    </Grid.RowDefinitions>

                    <!-- Play/Pause/Prev/Next, Lumen Profile/L-Mode -->
                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <component:IconRepeatButton Style="{DynamicResource IconRepeatButton}" Icon="prev" Width="24" Height="21.3" Command="{Binding CmdPlayback}" CommandParameter="prev" />
                            <StackPanel Width="40"/>
                            <component:IconMultiToggleButton Style="{DynamicResource IconMultiToggleButton}" IsChecked="{Binding IsPaused}" Icon="play" CheckedIcon="pause" Width="22" Height="26.8" Command="{Binding CmdPlayback}" CommandParameter="play"/>
                            <StackPanel Width="40"/>
                            <component:IconRepeatButton Style="{DynamicResource IconRepeatButton}" Icon="next"  Width="24" Height="21.3" Command="{Binding CmdPlayback}" CommandParameter="next"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <StackPanel Width="20"/>
                            <ToggleButton IsChecked="{Binding ReviewStatus.IsLumenProfile}" Style="{StaticResource ContainedToggleBtnType2-Small}" Command="{Binding ToggleLongitudeCommand}" CommandParameter="{StaticResource TrueValue}" Content="{Binding [Lumen Profile], Source={StaticResource L10N}}"/>
                            <ToggleButton IsChecked="{Binding ReviewStatus.IsLumenProfile, Converter={StaticResource InverseBooleanConverter}}" Style="{StaticResource ContainedToggleBtnType2-Small}" Width="80" Command="{Binding ToggleLongitudeCommand}" CommandParameter="{StaticResource FalseValue}" Content="{Binding [L-Mode], Source={StaticResource L10N}}"/>
                        </StackPanel>
                    </Grid>

                    <Separator Grid.Row="1" Margin="0" Padding="0" Background="#161616"/>

                    <!-- Longitude -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <StackPanel Height="76"/>
                            <Label Content="P" Style="{DynamicResource Pretendard-Semibold-20}" HorizontalAlignment="Center" Foreground="#fcfcfc" Opacity="0.5"/>
                        </StackPanel>
                        <Grid Grid.Column="2">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Height="76"/>
                                <Label Content="D" Style="{DynamicResource Pretendard-Semibold-20}" HorizontalAlignment="Center" Foreground="#fcfcfc" Opacity="0.5"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="9"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="35"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Image Grid.Column="1" Grid.Row="1" Width="12" Height="105" Source="{svgc:SvgImage Source=/res/icon/indicator.svg}" Visibility="{Binding IndicatorCrossSection.IsVisible}" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                            </Grid>
                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="105"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>

                            <!-- Longitude Image -->
                            <Grid x:Name="longitude" Grid.Row="1">
                                <!-- Lumen Profile -->
                                <Image x:Name="lumenProfile" Width="{x:Static const:Constants.LongitudeWidth}" Height="{x:Static const:Constants.LongitudeHeight}" Stretch="Fill" Visibility="{Binding ReviewStatus.IsLumenProfile, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Loaded">
                                            <i:InvokeCommandAction Command="{Binding CmdViewSizeChanged}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Image}}"/>
                                        </i:EventTrigger>
                                        <i:EventTrigger EventName="SizeChanged">
                                            <i:InvokeCommandAction Command="{Binding CmdViewSizeChanged}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Image}}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <Image.Clip>
                                        <RectangleGeometry RadiusX="8" RadiusY="8">
                                            <RectangleGeometry.Rect>
                                                <Rect X="0" Y="0" Width="{x:Static const:Constants.LongitudeWidth}" Height="{x:Static const:Constants.LongitudeImageClipHeight}"/>
                                            </RectangleGeometry.Rect>
                                        </RectangleGeometry>
                                    </Image.Clip>
                                </Image>
                                <!-- L-Mode -->
                                <Image x:Name="lMode" Source="{Binding LongitudeImage}" Width="{x:Static const:Constants.LongitudeWidth}" Height="{x:Static const:Constants.LongitudeHeight}" Stretch="Fill" Visibility="{Binding ReviewStatus.IsLumenProfile, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Loaded">
                                            <i:InvokeCommandAction Command="{Binding CmdViewSizeChanged}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Image}}"/>
                                        </i:EventTrigger>
                                        <i:EventTrigger EventName="SizeChanged">
                                            <i:InvokeCommandAction Command="{Binding CmdViewSizeChanged}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Image}}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <Image.Clip>
                                        <RectangleGeometry RadiusX="8" RadiusY="8">
                                            <RectangleGeometry.Rect>
                                                <Rect X="0" Y="0" Width="{x:Static const:Constants.LongitudeWidth}" Height="{x:Static const:Constants.LongitudeImageClipHeight}"/>
                                            </RectangleGeometry.Rect>
                                        </RectangleGeometry>
                                    </Image.Clip>
                                </Image>

                                <!-- L-Mode Indicator -->
                                <Canvas>
                                    <component:IndicatorImage Style="{DynamicResource IndicatorImage}" Icon="longitude" IsCaptured="{Binding IndicatorLongitude.IsCaptured}" Width="{x:Static const:Constants.LongitudeIndicatorWidth}" Height="{x:Static const:Constants.LongitudeIndicatorHeight}" Cursor="Hand" Stretch="None" Canvas.Left="{Binding IndicatorLongitude.X}" Margin="0,-11,0,0" Visibility="{Binding IndicatorLongitude.IsVisible}">
                                        <!-- Trigger -->
                                        <i:Interaction.Triggers>
                                            <!--PreviewMouseDown : Image 영역에서 MouseDown 할 경우, Indicator 동작 가능 상태로 변경 -->
                                            <i:EventTrigger EventName="PreviewMouseDown" >
                                                <i:InvokeCommandAction Command="{Binding IndicatorLongitude.CmdSetCaptured}" CommandParameter="{StaticResource TrueValue}"/>
                                            </i:EventTrigger>
                                            <!--PreviewMouseUp : Image 영역에서 MouseUp 할 경우, Indicator 멈춤 -->
                                            <i:EventTrigger EventName="PreviewMouseUp" >
                                                <i:InvokeCommandAction Command="{Binding IndicatorLongitude.CmdSetCaptured}" CommandParameter="{StaticResource FalseValue}"/>
                                            </i:EventTrigger>
                                            <!--PreviewMouseMove : Image 영역에서 MouseMove 할 경우, Indicator 동작(단, Indicator가 동작 가능 상태 일때) -->
                                            <i:EventTrigger EventName="PreviewMouseMove" >
                                                <i:InvokeCommandAction Command="{Binding CmdMoveIndicator}" CommandParameter="{Binding IndicatorLongitude}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </component:IndicatorImage>
                                </Canvas>

                                <!-- Measurement -->
                                <Grid>
                                    <annotation:DrawLmodeUtil Visibility="{Binding ReviewStatus.IsMeasurementOn, Converter={StaticResource BoolToVisibilityConverter}}" InCommand="{Binding MeasurementCommand, Mode=TwoWay}" LModeLengthGeometries="{Binding LModeLengthGeometries}" LModeTextGeometries="{Binding LModeTextGeometries}" LModeIndicatorX="{Binding LModeIndicatorX, Mode=TwoWay}" IsHitTestVisible="{Binding IndicatorLongitude.IsCaptured, Converter={StaticResource InverseBooleanConverter}}" IsEnabled="{Binding IndicatorLongitude.IsCaptured, Converter={StaticResource InverseBooleanConverter}}"/>
                                </Grid>
                            </Grid>

                            <!-- Bookmark Scale -->
                            <Border Grid.Row="2" CornerRadius="0,0,8,8" Background="{DynamicResource BackgroundBrush}">
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Converter={StaticResource GridLengthConverter}, ConverterParameter={x:Static const:Constants.LongitudeScale}}"/>
                                        <ColumnDefinition Width="{Binding Converter={StaticResource GridLengthConverter}, ConverterParameter={x:Static const:Constants.LongitudeScale}}"/>
                                        <ColumnDefinition Width="{Binding Converter={StaticResource GridLengthConverter}, ConverterParameter={x:Static const:Constants.LongitudeScale}}"/>
                                        <ColumnDefinition Width="{Binding Converter={StaticResource GridLengthConverter}, ConverterParameter={x:Static const:Constants.LongitudeScale}}"/>
                                        <ColumnDefinition Width="{Binding Converter={StaticResource GridLengthConverter}, ConverterParameter={x:Static const:Constants.LongitudeScale}}"/>
                                        <ColumnDefinition Width="{Binding Converter={StaticResource GridLengthConverter}, ConverterParameter={x:Static const:Constants.LongitudeScale}}"/>
                                        <ColumnDefinition Width="{Binding Converter={StaticResource GridLengthConverter}, ConverterParameter={x:Static const:Constants.LongitudeScale}}"/>
                                        <ColumnDefinition Width="{Binding Converter={StaticResource GridLengthConverter}, ConverterParameter={x:Static const:Constants.LongitudeScale}}"/>
                                        <ColumnDefinition Width="{Binding Converter={StaticResource GridLengthConverter}, ConverterParameter={x:Static const:Constants.LongitudeScale}}"/>
                                        <ColumnDefinition Width="{Binding Converter={StaticResource GridLengthConverter}, ConverterParameter={x:Static const:Constants.LongitudeScale}}"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1" Width="1" HorizontalAlignment="Left" Background="{DynamicResource VerticalSeparatorBrush}"/>
                                    <StackPanel Grid.Column="2" Width="1" HorizontalAlignment="Left" Background="{DynamicResource VerticalSeparatorBrush}"/>
                                    <StackPanel Grid.Column="3" Width="1" HorizontalAlignment="Left" Background="{DynamicResource VerticalSeparatorBrush}"/>
                                    <StackPanel Grid.Column="4" Width="1" HorizontalAlignment="Left" Background="{DynamicResource VerticalSeparatorBrush}"/>
                                    <StackPanel Grid.Column="5" Width="1" HorizontalAlignment="Left" Background="{DynamicResource VerticalSeparatorBrush}"/>
                                    <StackPanel Grid.Column="6" Width="1" HorizontalAlignment="Left" Background="{DynamicResource VerticalSeparatorBrush}"/>
                                    <StackPanel Grid.Column="7" Width="1" HorizontalAlignment="Left" Background="{DynamicResource VerticalSeparatorBrush}"/>
                                    <StackPanel Grid.Column="8" Width="1" HorizontalAlignment="Left" Background="{DynamicResource VerticalSeparatorBrush}"/>
                                    <StackPanel Grid.Column="9" Width="1" HorizontalAlignment="Left" Background="{DynamicResource VerticalSeparatorBrush}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Bookmark -->
                <Grid Grid.Row="3">
                    <annotation:BookmarkUtil Bookmarks="{Binding Bookmarks}" BookmarkFrameNumber="{Binding FrameNumber}" BookmarkLongitudeX="{Binding IndicatorLongitude.CenterX}" BookmarkOutFrameNumber="{Binding OutFrameNumber, Mode=TwoWay}"/>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Height="40" Background="#0d0d0d">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                    <Button Style="{StaticResource OutlinedBtnType1-Small-Wide}" Command="{Binding NewRecordingCommand}" Content="{Binding [New Recording], Source={StaticResource L10N}}"/>
                    <StackPanel Width="8"/>
                    <Button Style="{StaticResource OutlinedBtnType1-Small-Medium}" Command="{Binding EndReviewCommand}" Content="{Binding [End Review], Source={StaticResource L10N}}"/>
                    <StackPanel Width="16"/>
                </StackPanel>
            </Grid>
        </Grid>

        <component:IndicatorAreaGrid Style="{DynamicResource IndicatorAreaGrid}" IsCaptured="{Binding IndicatorCrossSection.IsCaptured}" Visibility="{Binding IndicatorCrossSection.IsVisible}">
            <i:Interaction.Behaviors>
                <behaviors:MouseBehavior MouseX="{Binding IndicatorCrossSection.X, Mode=OneWayToSource}" MouseY="{Binding IndicatorCrossSection.Y, Mode=OneWayToSource}" />
            </i:Interaction.Behaviors>

            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseLeave" >
                    <i:InvokeCommandAction Command="{Binding IndicatorCrossSection.CmdSetCaptured}" CommandParameter="{StaticResource FalseValue}"/>
                </i:EventTrigger>
                <i:EventTrigger EventName="PreviewMouseUp" >
                    <i:InvokeCommandAction Command="{Binding IndicatorCrossSection.CmdSetCaptured}" CommandParameter="{StaticResource FalseValue}"/>
                </i:EventTrigger>
                <i:EventTrigger EventName="PreviewMouseMove" >
                    <i:InvokeCommandAction Command="{Binding CmdRotateIndicator}" CommandParameter="{Binding IndicatorCrossSection}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </component:IndicatorAreaGrid>
        <component:IndicatorAreaGrid Style="{DynamicResource IndicatorAreaGrid}" IsCaptured="{Binding IndicatorLongitude.IsCaptured}" Visibility="{Binding IndicatorLongitude.IsVisible}">
            <i:Interaction.Behaviors>
                <behaviors:MouseBehavior MouseX="{Binding PointLongitudeX, Mode=OneWayToSource}"/>
            </i:Interaction.Behaviors>
            
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseLeave" >
                    <i:InvokeCommandAction Command="{Binding IndicatorLongitude.CmdSetCaptured}" CommandParameter="{StaticResource FalseValue}"/>
                </i:EventTrigger>
                <i:EventTrigger EventName="PreviewMouseUp" >
                    <i:InvokeCommandAction Command="{Binding IndicatorLongitude.CmdSetCaptured}" CommandParameter="{StaticResource FalseValue}"/>
                </i:EventTrigger>
                <i:EventTrigger EventName="PreviewMouseMove" >
                    <i:InvokeCommandAction Command="{Binding CmdMoveIndicator}" CommandParameter="{Binding IndicatorLongitude}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </component:IndicatorAreaGrid>
    </Grid>
</Page>
