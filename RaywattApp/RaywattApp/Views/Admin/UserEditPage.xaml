<Page x:Class="RaywattApp.Views.Admin.UserEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RaywattApp.Views.Admin"
      mc:Ignorable="d" 
      d:DesignHeight="1024" d:DesignWidth="1280"
      Background="{DynamicResource GrayscaleGray8Brush}"
      Title="UserEditPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="60" Background="{DynamicResource GrayscaleGray7Brush}">
            <Label Style="{DynamicResource Pretendard-Medium-18}" Foreground="{DynamicResource GrayscaleGray3Brush}" Margin="75,20,0,19" Content="{Binding [Edit User], Source={StaticResource L10N}}"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="436,80,436,0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource OutlinedBtnType2-Large}" Command="{Binding ResetPasswordCommand}" Content="{Binding [Reset Password], Source={StaticResource L10N}}"/>
                <Button Style="{StaticResource OutlinedBtnType1-Large}" Margin="8,0,0,0" Command="{Binding DeleteUserCommand}" Content="{Binding [Delete User], Source={StaticResource L10N}}"/>
            </StackPanel>
            <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Margin="0,25,0,0" Content="{Binding [ID], Source={StaticResource L10N}}"/>
            <TextBox Style="{DynamicResource TextBoxValidator}" Width="408" Text="{Binding User.Id, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [Enter ID], Source={StaticResource L10N}}" ToolTip="{Binding User.ValidateId}" Margin="0,6,0,0"/>
            <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Margin="0,24,0,0" Content="{Binding [Comment], Source={StaticResource L10N}}"/>
            <TextBox Style="{DynamicResource TextBoxBase}" Width="408" Text="{Binding User.Comment, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [Enter Comment], Source={StaticResource L10N}}" Margin="0,6,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,38,0,0">
                <Button Style="{StaticResource OutlinedBtnType1-Large}" Command="{Binding CancelCommand}" Content="{Binding [Cancel], Source={StaticResource L10N}}"/>
                <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Margin="8,0,0,0" Command="{Binding SaveCommand}" Content="{Binding [Save], Source={StaticResource L10N}}"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" Height="40" Background="{DynamicResource GrayscaleBlackBrush}"/>
    </Grid>
</Page>
