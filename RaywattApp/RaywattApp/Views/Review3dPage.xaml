<Page x:Class="RaywattApp.Views.Review3dPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:behaviors="clr-namespace:RaywattApp.Common.Behaviors"
      xmlns:local="clr-namespace:RaywattApp.Views"
      xmlns:const="clr-namespace:RaywattApp.Common.Bases"
      xmlns:System="clr-namespace:System;assembly=mscorlib"
      xmlns:component="clr-namespace:RaywattApp.Views.Component"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      xmlns:gl="clr-namespace:System.Globalization;assembly=mscorlib"
      mc:Ignorable="d" 
      d:DesignHeight="1024" d:DesignWidth="1280"
      Background="{DynamicResource GrayscaleGray8Brush}"
      Title="Review3dPage">
    <Page.Resources>
        <System:Boolean x:Key="TrueValue">True</System:Boolean>
        <System:Boolean x:Key="FalseValue">False</System:Boolean>
    </Page.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource SideCardBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Width="70"/>
                    <ToggleButton Style="{DynamicResource TabToggleBtn}" Content="{Binding [2D], Source={StaticResource L10N}}" Command="{Binding ReviewTypeSwitchCommand}" CommandParameter="{x:Static const:Constants.ReviewPage}"/>
                    <ToggleButton Style="{DynamicResource TabToggleBtn}" Content="{Binding [3D], Source={StaticResource L10N}}" IsChecked="True" IsEnabled="False"/>
                    <ToggleButton Style="{DynamicResource TabToggleBtn}" Content="{Binding [Compare], Source={StaticResource L10N}}" Command="{Binding ReviewTypeSwitchCommand}" CommandParameter="{x:Static const:Constants.ReviewComparePage}" Visibility="{Binding PatientCase.Procedure, Converter={StaticResource ProcedureVisibilityConverter}, ConverterParameter=$002|$003}"/>
                    <ToggleButton Style="{DynamicResource TabToggleBtn}" Content="{Binding [AI FFR], Source={StaticResource L10N}}" Command="{Binding ReviewTypeSwitchCommand}" CommandParameter="{x:Static const:Constants.ReviewFfrSettingPage}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="668"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="236"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="420"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Background="{DynamicResource GrayscaleBlackBrush}"/>
                </Grid>

                <!-- 3D Part -->
                <Grid Grid.Row="1">
                    <!-- 3D -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="860"/>
                            <ColumnDefinition Width="420"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Background="{DynamicResource GrayscaleGray8Brush}">
                            <Grid Margin="98,21,28,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="29"/>
                                    <RowDefinition Height="560"/>
                                    <RowDefinition Height="50"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Cut-View], Source={StaticResource L10N}}"/>
                                </StackPanel>
                                <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource AdditionalColor5Brush}">
                                    <!-- Loading -->
                                    <ContentControl Template="{DynamicResource Loading}" Visibility="{Binding IsRendering, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                                </Border>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0" Width="734">
                                    <component:IconToggleButton Style="{DynamicResource ToggleButtonWithText}" Icon="cutView" Content="{Binding [Cut-View], Source={StaticResource L10N}}" IsChecked="{Binding IsCutViewOn, Mode=TwoWay}" IsEnabled="{Binding IsRendering}"/>
                                    <StackPanel Width="6"/>
                                    <component:IconToggleButton Style="{DynamicResource ToggleButtonWithText}" Icon="currentFrameIndicator3D" Content="{Binding [Current Frame Indicator], Source={StaticResource L10N}}" IsChecked="{Binding IsIndicatorOn}" IsEnabled="{Binding IsRendering}"/>
                                    <StackPanel Width="6"/>
                                    <component:IconButton Style="{StaticResource IconButton}" Icon="zoomIn" Command="{Binding ZoomIn3DCommand}" Height="42" Width="42"/>
                                    <StackPanel Width="6"/>
                                    <component:IconButton Style="{StaticResource IconButton}" Icon="zoomOut" Command="{Binding ZoomOut3DCommand}" Height="42" Width="42"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Background="{DynamicResource GrayscaleBlackBrush}">
                            <Grid Margin="26,21,26,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="29"/>
                                    <RowDefinition Height="560"/>
                                    <RowDefinition Height="50"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Fly-Through], Source={StaticResource L10N}}"/>
                                </StackPanel>
                                <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource AdditionalColor5Brush}">
                                    <ContentControl Template="{DynamicResource Loading}" Visibility="{Binding IsRendering, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                                </Border>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                    <ToggleButton Style="{DynamicResource FlyThroughToggleBtn}" Content="{Binding [P to D], Source={StaticResource L10N}}" IsChecked="{Binding IsPtoD}" IsEnabled="{Binding IsRendering}"/>
                                    <StackPanel Width="6"/>
                                    <component:IconToggleButton Style="{DynamicResource ToggleButtonWithText}" Icon="sideBranchView" Content="{Binding [Side Branch View], Source={StaticResource L10N}}" IsChecked="{Binding IsSideBranchView}" IsEnabled="{Binding IsRendering}" Visibility="Hidden"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Left Menu -->
                        <Grid Grid.Column="0" Width="{x:Static const:Constants.SideBarExpandSize}" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="329"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="329"/>
                            </Grid.RowDefinitions>
                            <!-- 3D Option  -->
                            <Button Grid.Row="0" HorizontalAlignment="Left" Visibility="{Binding ExpandLeftUpMenu, Converter={StaticResource BoolToVisibilityReverseConverter}}" Command="{Binding CmdExpandLeftViewMenu}">
                                <Button.Template>
                                    <ControlTemplate>
                                        <Border CornerRadius="0,8,8,0" Width="{x:Static const:Constants.SideBarCollapseSize}" Background="{StaticResource SideCardBackgroundBrush}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" >
                                                    <Button Style="{DynamicResource SideMenuTitleLeftCollapsed}" Command="{Binding CmdExpandLeftViewMenu}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center">
                                                    <StackPanel Height="114.2"/>
                                                    <Image Source="{svgc:SvgImage Source=/res/icon/3dOption.svg}" Width="24.3" Height="24.3"/>
                                                    <StackPanel Height="8"/>
                                                    <Label Style="{DynamicResource Pretendard-Semibold-12}" Foreground="{DynamicResource GrayscaleGray3Brush}" TextBlock.TextAlignment="Center" Padding="10,0,10,0">
                                                        <Label.Content>
                                                            <AccessText TextWrapping="Wrap" Text="{Binding [3D Option], Source={StaticResource L10N}}"/>
                                                        </Label.Content>
                                                    </Label>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Patient Info  -->
                            <Button Grid.Row="2" HorizontalAlignment="Left" Visibility="{Binding ExpandLeftDownMenu, Converter={StaticResource BoolToVisibilityReverseConverter}}" Command="{Binding CmdExpandLeftPatientMenu}">
                                <Button.Template>
                                    <ControlTemplate>
                                        <Border CornerRadius="0,8,8,0" HorizontalAlignment="Left" Width="{x:Static const:Constants.SideBarCollapseSize}" Background="{StaticResource SideCardBackgroundBrush}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" >
                                                    <Button Style="{DynamicResource SideMenuTitleLeftCollapsed}" Command="{Binding CmdExpandLeftPatientMenu}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center">
                                                    <StackPanel Height="125.5"/>
                                                    <Image Source="{svgc:SvgImage Source=/res/icon/CaseInfo.svg}" Width="24" Height="24"/>
                                                    <StackPanel Height="8"/>
                                                    <Label Style="{DynamicResource Pretendard-Semibold-12}" Foreground="{DynamicResource GrayscaleGray3Brush}" TextBlock.TextAlignment="Center" Padding="10,0,10,0">
                                                        <Label.Content>
                                                            <AccessText TextWrapping="Wrap" Text="{Binding [Case Info.], Source={StaticResource L10N}}"/>
                                                        </Label.Content>
                                                    </Label>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="420"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Background="{DynamicResource GrayscaleBlackBrush}"/>
                </Grid>

                <!-- 2D Part -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1008"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Background="{DynamicResource GrayscaleGray7Brush}">
                        <Grid Grid.Row="4" Margin="0,37,0,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,0,0">
                                <Label Content="P" Style="{DynamicResource Pretendard-Semibold-20}" Foreground="{DynamicResource AdditionalColor7Brush}" Opacity="0.5"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,12,0">
                                <Image Height="150" Source="{svgc:SvgImage Source=/res/icon/indicator3d.svg}"/>
                                <StackPanel Width="5"/>
                                <Label Content="D" Style="{DynamicResource Pretendard-Semibold-20}" Foreground="{DynamicResource AdditionalColor7Brush}" VerticalAlignment="Center" Opacity="0.5"/>
                            </StackPanel>
                            <Grid Grid.Row="0" Grid.Column="1" >
                                <Image x:Name="lMode" Source="{Binding LongitudeImage}" Width="{x:Static const:Constants.Longitude3dWidth}" Height="{x:Static const:Constants.Longitude3dHeight}" Stretch="Fill">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Loaded">
                                            <i:InvokeCommandAction Command="{Binding CmdViewSizeChanged}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Image}}"/>
                                        </i:EventTrigger>
                                        <i:EventTrigger EventName="SizeChanged">
                                            <i:InvokeCommandAction Command="{Binding CmdViewSizeChanged}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Image}}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <Image.Clip>
                                        <RectangleGeometry RadiusX="8" RadiusY="8">
                                            <RectangleGeometry.Rect>
                                                <Rect X="0" Y="0" Width="{x:Static const:Constants.Longitude3dWidth}" Height="{x:Static const:Constants.Longitude3dImageClipHeight}"/>
                                            </RectangleGeometry.Rect>
                                        </RectangleGeometry>
                                    </Image.Clip>
                                </Image>

                                <!-- L-Mode Indicator -->
                                <Canvas>
                                    <component:IndicatorImage Style="{DynamicResource IndicatorImage}" Icon="longitude3d" IsCaptured="{Binding IndicatorLongitude.IsCaptured}" IsEnabled="{Binding IndicatorLongitude.IsEnabled}" Width="{x:Static const:Constants.LongitudeIndicatorWidth}" Height="{x:Static const:Constants.LongitudeIndicator3dHeight}" Stretch="None" Canvas.Left="{Binding IndicatorLongitude.X}" Margin="0,-11,0,0" Visibility="{Binding IndicatorLongitude.IsVisible}">
                                        <!-- Trigger -->
                                        <i:Interaction.Triggers>
                                            <!--PreviewMouseDown : Image 영역에서 MouseDown 할 경우, Indicator 동작 가능 상태로 변경 -->
                                            <i:EventTrigger EventName="PreviewMouseDown" >
                                                <i:InvokeCommandAction Command="{Binding IndicatorLongitude.CmdSetCaptured}" CommandParameter="{StaticResource TrueValue}"/>
                                            </i:EventTrigger>
                                            <!--PreviewMouseUp : Image 영역에서 MouseUp 할 경우, Indicator 멈춤 -->
                                            <i:EventTrigger EventName="PreviewMouseUp" >
                                                <i:InvokeCommandAction Command="{Binding IndicatorLongitude.CmdSetCaptured}" CommandParameter="{StaticResource FalseValue}"/>
                                            </i:EventTrigger>
                                            <!--PreviewMouseMove : Image 영역에서 MouseMove 할 경우, Indicator 동작(단, Indicator가 동작 가능 상태 일때) -->
                                            <i:EventTrigger EventName="PreviewMouseMove" >
                                                <i:InvokeCommandAction Command="{Binding CmdMoveIndicator}" CommandParameter="{Binding IndicatorLongitude}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </component:IndicatorImage>
                                </Canvas>
                            </Grid>
                            <ContentControl Grid.Row="1" Grid.Column="1" Template="{DynamicResource LongitudeScaleBar}" Width="{x:Static const:Constants.Longitude3dWidth}" Tag="{Binding PatientCase.PullbackLength}"/>
                        </Grid>
                    </Grid>
                    <Grid Grid.Column="1" Background="{DynamicResource GrayscaleGray8Brush}">
                        <Image x:Name="crossSectionImage" Source="{Binding CrossSectionImage}" Width="{x:Static const:Constants.CrossSection3dSize}" Height="{x:Static const:Constants.CrossSection3dSize}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Loaded">
                                    <i:InvokeCommandAction Command="{Binding CmdViewSizeChanged}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Image}}"/>
                                </i:EventTrigger>
                                <i:EventTrigger EventName="SizeChanged">
                                    <i:InvokeCommandAction Command="{Binding CmdViewSizeChanged}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Image}}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Image>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="42,0,0,5">
                            <StackPanel Orientation="Horizontal" Width="50">
                                <Label Content="F" Style="{DynamicResource Pretendard-ExtraBold-14}" Foreground="{DynamicResource GrayscaleGray3Brush}"/>
                                <StackPanel Width="6"/>
                                <Label Content="{Binding DisplayFrameNumber}" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray3Brush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,42,5">
                            <Label Content="1 ㎜" Style="{DynamicResource Pretendard-Medium-10}" Foreground="{DynamicResource SideMenuTitleBrush}" HorizontalAlignment="Center"/>
                            <StackPanel Height="2"/>
                            <Grid>
                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Height="5" Width="1" Margin="0" HorizontalAlignment="Left"/>
                                <Separator Width="{Binding CrossSection3dScale}" Height="1" Margin="0"/>
                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Height="5" Width="1" Margin="0" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <!-- camera -->
                        <Grid Width="214" Height="214" Background="Transparent" Visibility="{Binding IndicatorLongitude.IsVisible}">
                            <Image Width="12" Height="9.6" Source="{svgc:SvgImage Source=/res/icon/camera.svg}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <Grid.RenderTransform>
                                <RotateTransform CenterX="107" CenterY="107" Angle="{Binding CameraDegree}"/>
                            </Grid.RenderTransform>
                        </Grid>

                        <!-- camera View Part -->
                        <Grid Width="182" Height="182" Background="Transparent" Visibility="{Binding IndicatorLongitude.IsVisible}">
                            <Image Width="91" Height="182" Source="{svgc:SvgImage Source=/res/icon/cameraViewPart.svg}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <Grid.RenderTransform>
                                <RotateTransform CenterX="91" CenterY="91" Angle="{Binding CameraDegree}"/>
                            </Grid.RenderTransform>
                        </Grid>

                        <!-- Indicator  -->
                        <Grid>
                            <component:IndicatorImage Style="{DynamicResource IndicatorImage}" Width="188" Icon="crossSectionSmall" IsCaptured="{Binding IndicatorCrossSection.IsCaptured}" IsEnabled="{Binding IndicatorCrossSection.IsEnabled}" Visibility="{Binding IndicatorCrossSection.IsVisible}">
                                <Image.RenderTransform>
                                    <RotateTransform CenterX="94" CenterY="5" Angle="{Binding Degree}"/>
                                </Image.RenderTransform>

                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="PreviewMouseDown" >
                                        <i:InvokeCommandAction Command="{Binding IndicatorCrossSection.CmdSetCaptured}" CommandParameter="{StaticResource TrueValue}"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewMouseUp" >
                                        <i:InvokeCommandAction Command="{Binding IndicatorCrossSection.CmdSetCaptured}" CommandParameter="{StaticResource FalseValue}"/>
                                    </i:EventTrigger>
                                    <i:EventTrigger EventName="PreviewMouseMove" >
                                        <i:InvokeCommandAction Command="{Binding CmdRotateIndicator}" CommandParameter="{Binding IndicatorCrossSection}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </component:IndicatorImage>
                        </Grid>
                    </Grid>

                </Grid>

            </Grid>


            <Grid Grid.Row="2" Height="40" Background="{DynamicResource GrayscaleBlackBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                    <Button Style="{StaticResource OutlinedBtnType1-Small-Wide}" Command="{Binding NewRecordingCommand}" Content="{Binding [New Recording], Source={StaticResource L10N}}"/>
                    <StackPanel Width="8"/>
                    <Button Style="{StaticResource OutlinedBtnType1-Small-Medium}" Command="{Binding EndReviewCommand}" Content="{Binding [End Review], Source={StaticResource L10N}}"/>
                    <StackPanel Width="16"/>
                </StackPanel>
            </Grid>
        </Grid>

        <component:IndicatorAreaGrid Style="{DynamicResource IndicatorAreaGrid}" IsCaptured="{Binding IndicatorCrossSection.IsCaptured}" Visibility="{Binding IndicatorCrossSection.IsVisible}">
            <i:Interaction.Behaviors>
                <behaviors:MouseBehavior MouseX="{Binding IndicatorCrossSection.X, Mode=OneWayToSource}" MouseY="{Binding IndicatorCrossSection.Y, Mode=OneWayToSource}" />
            </i:Interaction.Behaviors>

            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseLeave" >
                    <i:InvokeCommandAction Command="{Binding IndicatorCrossSection.CmdSetCaptured}" CommandParameter="{StaticResource FalseValue}"/>
                </i:EventTrigger>
                <i:EventTrigger EventName="PreviewMouseUp" >
                    <i:InvokeCommandAction Command="{Binding IndicatorCrossSection.CmdSetCaptured}" CommandParameter="{StaticResource FalseValue}"/>
                </i:EventTrigger>
                <i:EventTrigger EventName="PreviewMouseMove" >
                    <i:InvokeCommandAction Command="{Binding CmdRotateIndicator}" CommandParameter="{Binding IndicatorCrossSection}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </component:IndicatorAreaGrid>
        <component:IndicatorAreaGrid Style="{DynamicResource IndicatorAreaGrid}" IsCaptured="{Binding IndicatorLongitude.IsCaptured}" Visibility="{Binding IndicatorLongitude.IsVisible}">
            <i:Interaction.Behaviors>
                <behaviors:MouseBehavior MouseX="{Binding IndicatorLongitude.PointLongitudeX, Mode=OneWayToSource}"/>
            </i:Interaction.Behaviors>

            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseLeave" >
                    <i:InvokeCommandAction Command="{Binding IndicatorLongitude.CmdSetCaptured}" CommandParameter="{StaticResource FalseValue}"/>
                </i:EventTrigger>
                <i:EventTrigger EventName="PreviewMouseUp" >
                    <i:InvokeCommandAction Command="{Binding IndicatorLongitude.CmdSetCaptured}" CommandParameter="{StaticResource FalseValue}"/>
                </i:EventTrigger>
                <i:EventTrigger EventName="PreviewMouseMove" >
                    <i:InvokeCommandAction Command="{Binding CmdMoveIndicator}" CommandParameter="{Binding IndicatorLongitude}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </component:IndicatorAreaGrid>
    </Grid>

</Page>
