<Page x:Class="RaywattApp.Views.Password.InitialPasswordSetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RaywattApp.Views"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      xmlns:ut="clr-namespace:RaywattApp.Common.Util"
      mc:Ignorable="d"
      d:DesignHeight="1024" d:DesignWidth="1280"
      Background="{DynamicResource GrayscaleGray8Brush}"
      Title="InitialPasswordSetupPage">

    <Grid>
        <StackPanel Margin="436,140,436,473">
            <Label Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="Password Setup"/>
            <StackPanel Height="33"/>

            <Label Style="{DynamicResource Pretendard-Medium-16}" 
               Foreground="{DynamicResource GrayscaleWhiteBrush}" 
               Content="New Password"/>
            <StackPanel Height="6"/>

            <PasswordBox Style="{DynamicResource PasswordBoxValidator}"
                     Tag="{Binding [MSG_EnterNewPassword], Source={StaticResource L10N}}"
                     MaxLength="50"
                     ut:PasswordBoxHelper.Attach="True"
                     ut:PasswordBoxHelper.BindablePassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent"/>
            <StackPanel Height="8"/>

            <Label Style="{DynamicResource Pretendard-Medium-16}" 
               Foreground="{DynamicResource GrayscaleWhiteBrush}" 
               Content="Confirm Password"/>
            <StackPanel Height="6"/>

            <PasswordBox Style="{DynamicResource PasswordBoxValidator}"
                     Tag="{Binding [MSG_ConfirmNewPassword], Source={StaticResource L10N}}"
                     MaxLength="50"
                     ut:PasswordBoxHelper.Attach="True"
                     ut:PasswordBoxHelper.BindablePassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent"/>

            <Label Style="{DynamicResource Pretendard-Medium-12}" 
               Foreground="{DynamicResource AdditionalColor3Brush}">
                <TextBlock Text="{Binding [MSG_PasswordRequirement], Source={StaticResource L10N}}"
               TextWrapping="Wrap"/>
            </Label>
            <StackPanel Height="28"/>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource OutlinedBtnType3-Large}" 
                    Command="{Binding CancelCommand}" 
                    Content="{Binding [Cancel], Source={StaticResource L10N}}"/>
                <StackPanel Width="8"/>
                <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" 
                    Command="{Binding OkCommand}" 
                    Content="{Binding [OK], Source={StaticResource L10N}}"/>
            </StackPanel>
        </StackPanel>

    </Grid>
    
</Page>
