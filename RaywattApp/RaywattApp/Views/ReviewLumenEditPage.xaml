<Page x:Class="RaywattApp.Views.ReviewLumenEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RaywattApp.Views"
      xmlns:System="clr-namespace:System;assembly=mscorlib"
      xmlns:const="clr-namespace:RaywattApp.Common.Bases"
      xmlns:component="clr-namespace:RaywattApp.Views.Component"
      xmlns:annotation="clr-namespace:RaywattApp.Common.Annotation"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:behaviors="clr-namespace:RaywattApp.Common.Behaviors"
      mc:Ignorable="d" 
      d:DesignHeight="1024" d:DesignWidth="1280"
      Background="{DynamicResource GrayscaleGray8Brush}"
      Title="ReviewLumenEditPage">
    <Page.Resources>
        <System:Boolean x:Key="TrueValue">True</System:Boolean>
        <System:Boolean x:Key="FalseValue">False</System:Boolean>
    </Page.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="60" Background="{DynamicResource GrayscaleGray7Brush}">
            <Label Style="{DynamicResource Pretendard-Medium-18}" Foreground="{DynamicResource GrayscaleGray3Brush}" Margin="75,20,0,19" Content="{Binding [Review], Source={StaticResource L10N}}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="60,40,60,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="769"/>
                <RowDefinition Height="75"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" CornerRadius="10,10,0,0" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray7Brush}" Background="{DynamicResource GrayscaleGray7Brush}">
                <Grid Margin="42,0,42,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="84"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="684"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,32,0,10" Orientation="Horizontal" VerticalAlignment="Center">
                            <Label Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Lumen Contour], Source={StaticResource L10N}}"/>
                            <StackPanel Width="10"/>
                            <component:IconButton Style="{StaticResource IconButton}" Icon="information" Command="{Binding InformationCommand}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,32,0,10" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <component:IconButton Style="{StaticResource IconButtonLarge}" Icon="zoomIn" Command="{Binding ZoomInCommand}"/>
                            <StackPanel Width="10"/>
                            <component:IconButton Style="{StaticResource IconButtonLarge}" Icon="zoomOut" Command="{Binding ZoomOutCommand}"/>
                            <StackPanel Width="10"/>
                            <component:IconButton Style="{StaticResource IconButtonLarge}" Icon="restore" Command="{Binding RestoreCommand}"/>
                            <StackPanel Width="10"/>
                            <component:IconButton Style="{StaticResource IconButtonLarge}" Icon="reset" Command="{Binding ResetCommand}"/>
                            <StackPanel Width="10"/>
                            <Button Style="{StaticResource OutlinedBtnType3-Large}" Width="130" Command="{Binding AutoDetectCommand}" Content="{Binding [Auto Detect], Source={StaticResource L10N}}"/>
                        </StackPanel>
                    </Grid>
                    <Separator Grid.Row="1" Foreground="{DynamicResource GrayscaleGray5Brush}"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,50,0">
                            <component:IconRepeatButton Style="{DynamicResource IconRepeatButton}" Icon="prev" Width="40" Height="35.5" Command="{Binding CmdPlayback}" CommandParameter="prev" />
                        </StackPanel>
                        <Grid Grid.Column="1" Width="{x:Static const:Constants.CrossSectionSize}" Height="{x:Static const:Constants.CrossSectionSize}">
                            <Grid.Clip>
                                <RectangleGeometry RadiusX="10" RadiusY="10">
                                    <RectangleGeometry.Rect>
                                        <Rect X="0" Y="0" Width="{x:Static const:Constants.CrossSectionSize}" Height="{x:Static const:Constants.CrossSectionSize}"/>
                                    </RectangleGeometry.Rect>
                                </RectangleGeometry>
                            </Grid.Clip>
                            <Image x:Name="crossSectionImage" Source="{Binding CrossSectionImage}" Width="{x:Static const:Constants.CrossSectionSize}" Height="{x:Static const:Constants.CrossSectionSize}" Stretch="Fill">
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding Zoom.ScaleX, Converter={StaticResource CrossSectionScaleConverter}}" ScaleY="{Binding Zoom.ScaleY, Converter={StaticResource CrossSectionScaleConverter}}"/>
                                        <TranslateTransform X="{Binding Zoom.TranslateX, Converter={StaticResource CrossSectionScaleConverter}}" Y="{Binding Zoom.TranslateY, Converter={StaticResource CrossSectionScaleConverter}}"/>
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                        </Grid>
                        <annotation:DrawLumenContourUtil Grid.Column="1" Width="{x:Static const:Constants.CrossSectionSize}" Height="{x:Static const:Constants.CrossSectionSize}" LumenContours="{Binding LumenContours}" FrameNumber="{Binding FrameNumber}" InCommand="{Binding LumenContourCommand, Mode=TwoWay}" IsEditOn="True" Zoom="{Binding Zoom}"/>
                        <Grid Grid.Column="1" Width="{x:Static const:Constants.CrossSectionSize}" Height="{x:Static const:Constants.CrossSectionSize}">
                            <Border Width="{x:Static const:Constants.MiniMapBorderSize}" Height="{x:Static const:Constants.MiniMapBorderSize}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="16" BorderBrush="{DynamicResource GrayscaleGray8Brush}" BorderThickness="1" CornerRadius="10" Visibility="{Binding Zoom.Visibility}">
                                <Canvas>
                                    <Canvas.Background>
                                        <ImageBrush ImageSource="{Binding CrossSectionImage}" Stretch="Fill"/>
                                    </Canvas.Background>
                                    <Canvas.Clip>
                                        <RectangleGeometry RadiusX="10" RadiusY="10">
                                            <RectangleGeometry.Rect>
                                                <Rect X="0" Y="0" Width="{x:Static const:Constants.MiniMapCanvasSize}" Height="{x:Static const:Constants.MiniMapCanvasSize}"/>
                                            </RectangleGeometry.Rect>
                                        </RectangleGeometry>
                                    </Canvas.Clip>

                                    <Rectangle Style="{DynamicResource MiniMapRect}" Canvas.Left="{Binding Zoom.RectLeft}" Canvas.Top="{Binding Zoom.RectTop}" Width="{Binding Zoom.RectWidth}" Height="{Binding Zoom.RectHeight}" Tag="{Binding Zoom.IsCaptured}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="PreviewMouseDown">
                                                <i:InvokeCommandAction Command="{Binding Zoom.CmdSetCaptured}" CommandParameter="{Binding Zoom}"/>
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="PreviewMouseUp">
                                                <i:InvokeCommandAction Command="{Binding Zoom.CmdSetCaptured}"/>
                                            </i:EventTrigger>
                                            <i:EventTrigger EventName="PreviewMouseMove">
                                                <i:InvokeCommandAction Command="{Binding Zoom.CmdMoveRect}" CommandParameter="{Binding Zoom}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </Rectangle>
                                </Canvas>
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="50">
                                <Label Content="F : " Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource SideMenuTitleBrush}"/>
                                <Label Content="{Binding DisplayFrameNumber}" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource SideMenuTitleBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                <Separator Width="{Binding CrossSectionScale}" Height="1"/>
                                <StackPanel Height="4"/>
                                <Label Content="1 mm" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource SideMenuTitleBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="50,0,0,0">
                            <component:IconRepeatButton Style="{DynamicResource IconRepeatButton}" Icon="next"  Width="40" Height="35.5" Command="{Binding CmdPlayback}" CommandParameter="next"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Row="1" CornerRadius="0,0,10,10" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray7Brush}" Background="{DynamicResource GrayscaleGray6Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Left" Margin="16,16,0,0">
                        <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding CancelCommand}" Content="{Binding [Cancel], Source={StaticResource L10N}}"/>
                    </StackPanel>
                    <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0">
                        <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Command="{Binding OkCommand}" Content="{Binding [OK], Source={StaticResource L10N}}"/>
                    </Grid>
                </Grid>
            </Border>

            <i:Interaction.Behaviors>
                <behaviors:MouseBehavior MouseX="{Binding Zoom.MouseX, Mode=OneWayToSource}" MouseY="{Binding Zoom.MouseY, Mode=OneWayToSource}" />
            </i:Interaction.Behaviors>
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseLeave" >
                    <i:InvokeCommandAction Command="{Binding Zoom.CmdSetCaptured}"/>
                </i:EventTrigger>
                <i:EventTrigger EventName="PreviewMouseUp" >
                    <i:InvokeCommandAction Command="{Binding Zoom.CmdSetCaptured}"/>
                </i:EventTrigger>
                <i:EventTrigger EventName="PreviewMouseMove" >
                    <i:InvokeCommandAction Command="{Binding Zoom.CmdMoveRect}" CommandParameter="{Binding Zoom}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Grid>

        <Grid Grid.Row="2" Height="40" Background="{DynamicResource GrayscaleBlackBrush}"/>
    </Grid>
</Page>
