<Page x:Class="RaywattApp.Views.File.FileExportStep1Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RaywattApp.Views.File"
      xmlns:const="clr-namespace:RaywattApp.Common.Bases"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:gl="clr-namespace:System.Globalization;assembly=mscorlib"
      mc:Ignorable="d" 
      Width="{x:Static const:Constants.FileExportDialogWidth}" Height="{x:Static const:Constants.FileExportDialogHeight}"
      Title="FileExportStep1Page">

    <Grid>
        <Border CornerRadius="10" Background="{DynamicResource GrayscaleGray6Brush}" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray7Brush}" Visibility="{Binding FileExport.IsFromReview, Converter={StaticResource BoolToVisibilityReverseConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="29"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="29"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="62"/>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="29"/>
                    <RowDefinition Height="451"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="71" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <Label Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Export], Source={StaticResource L10N}}"/>
                    <Label Style="{DynamicResource Pretendard-Medium-22}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Margin="0,12,0,0" Content=" - "/>
                    <Label Style="{DynamicResource Pretendard-Medium-22}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Margin="0,12,0,0" Content="{Binding [Step 1.], Source={StaticResource L10N}}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <Label Style="{DynamicResource Pretendard-Medium-16}" Margin="0,5,0,0" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Export Type], Source={StaticResource L10N}}"/>
                    <StackPanel Width="35"/>
                    <StackPanel>
                        <RadioButton IsChecked="{Binding FileExport.Type, Converter={StaticResource RadioButtonConverter}, ConverterParameter={x:Static const:Constants.ExportTypeNative}}" Content="{Binding [Native(Raw)], Source={StaticResource L10N}}"/>
                    </StackPanel>
                    <StackPanel Margin="27,0,0,0">
                        <RadioButton IsChecked="{Binding FileExport.Type, Converter={StaticResource RadioButtonConverter}, ConverterParameter={x:Static const:Constants.ExportTypeDicom}}" Content="{Binding [DICOM], Source={StaticResource L10N}}"/>
                    </StackPanel>
                    <StackPanel Margin="27,0,0,0">
                        <RadioButton IsChecked="{Binding FileExport.Type, Converter={StaticResource RadioButtonConverter}, ConverterParameter={x:Static const:Constants.ExportTypeStandard}}" Content="{Binding [Standard], Source={StaticResource L10N}}"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="3" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Patient], Source={StaticResource L10N}}"/>
                    <Label Grid.Column="1" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Patient Case], Source={StaticResource L10N}}"/>
                </Grid>

                <Grid Grid.Row="4" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="570"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <DataGrid Name="patientList" ItemsSource="{Binding PatientList}" SelectedIndex="0" Style="{StaticResource DataGridDialog}" RowStyle="{StaticResource DataGridRowDialog}" ColumnHeaderStyle="{StaticResource DataGridColumnHeaderDialog}" SelectionMode="Single">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding ShowCaseCommand}" CommandParameter="{Binding ElementName=patientList, Path=CurrentItem}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn CellStyle="{StaticResource DataGridCellCheckbox}" Width="30">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource DataGridCheckList}" IsChecked="{Binding IsChecked}" IsEnabled="False"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" Width="*" Binding="{Binding Id}" Header="{Binding [ID], Source={StaticResource L10N}}" />
                                <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltipWrap}" Width="*" Binding="{Binding Name}" Header="{Binding [Name], Source={StaticResource L10N}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Grid Grid.Column="2">
                        <FrameworkElement x:Name="ProxyElement" Visibility="Collapsed"/>

                        <DataGrid Name="patientCaseList" ItemsSource="{Binding PatientCaseList}" Style="{StaticResource DataGridDialog}" RowStyle="{StaticResource DataGridRowDialog}" ColumnHeaderStyle="{StaticResource DataGridColumnHeaderDialog}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn CellStyle="{StaticResource DataGridCellCheckbox}" Width="42">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource DataGridCheckBoxHeader}" Command="{Binding DataContext.CheckBoxToggleCommand, Source={x:Reference ProxyElement}}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" IsChecked="{Binding DataContext.CheckBoxAllSelected, Source={x:Reference ProxyElement}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource DataGridCheckBox}" IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Command="{Binding DataContext.CheckBoxClickCommand, Source={x:Reference ProxyElement}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltipWrap}" Width="*" Binding="{Binding CreateDate, StringFormat=g, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}" Header="{Binding [Create Date], Source={StaticResource L10N}}" />
                                <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" Width="*" Binding="{Binding Vessel, Converter={StaticResource CodeConverter}, ConverterParameter='VESS'}" Header="{Binding [Vessel], Source={StaticResource L10N}}" />
                                <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" Width="*" Binding="{Binding Procedure, Converter={StaticResource CodeConverter}, ConverterParameter='PROC'}" Header="{Binding [Procedure], Source={StaticResource L10N}}" />
                                <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltipWrap}" Width="*" Binding="{Binding PhysicianName}" Header="{Binding [Physician Name], Source={StaticResource L10N}}" />
                                <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" Width="*" Binding="{Binding AccessionNumber}" Header="{Binding [Accession Number], Source={StaticResource L10N}}" />
                                <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" Width="*" Binding="{Binding Comment}" Header="{Binding [Comment], Source={StaticResource L10N}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <Grid Grid.Row="6" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource OutlinedBtnType3-Large}" HorizontalAlignment="Left" VerticalAlignment="Top" Command="{Binding CancelCommand}" Content="{Binding [Cancel], Source={StaticResource L10N}}"/>
                    <Button Grid.Column="1" Style="{StaticResource ContainedBtnType1-Large-Wide}" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding NextCommand}" Content="{Binding [Next], Source={StaticResource L10N}}"/>
                </Grid>
            </Grid>
        </Border>

        <Border CornerRadius="10" Background="{DynamicResource GrayscaleGray6Brush}" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray7Brush}" Width="472" Height="541" Visibility="{Binding FileExport.IsFromReview, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Margin="31,35,31,35">
                <Grid.RowDefinitions>
                    <RowDefinition Height="57"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="140"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="140"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="42"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                    <Label Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Export], Source={StaticResource L10N}}"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Label Style="{DynamicResource Pretendard-Semibold-22}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Step 1.], Source={StaticResource L10N}}"/>
                </StackPanel>
                <Border Grid.Row="2" CornerRadius="10" Background="{DynamicResource GrayscaleGray7Brush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="163"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="24,25,0,0">
                            <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Export Type], Source={StaticResource L10N}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <StackPanel Margin="0,19,0,0">
                                <RadioButton IsChecked="{Binding FileExport.Type, Converter={StaticResource RadioButtonConverter}, ConverterParameter={x:Static const:Constants.ExportTypeNative}}" Content="{Binding [Native(Raw)], Source={StaticResource L10N}}"/>
                            </StackPanel>
                            <StackPanel Margin="0,6,0,0">
                                <RadioButton IsChecked="{Binding FileExport.Type, Converter={StaticResource RadioButtonConverter}, ConverterParameter={x:Static const:Constants.ExportTypeDicom}}" Content="{Binding [DICOM], Source={StaticResource L10N}}"/>
                            </StackPanel>
                            <StackPanel Margin="0,6,0,0">
                                <RadioButton IsChecked="{Binding FileExport.Type, Converter={StaticResource RadioButtonConverter}, ConverterParameter={x:Static const:Constants.ExportTypeStandard}}" Content="{Binding [Standard], Source={StaticResource L10N}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="4" CornerRadius="10" Background="{DynamicResource GrayscaleGray7Brush}" IsEnabled="{Binding FileExport.Type, Converter={StaticResource RadioButtonReverseConverter}, ConverterParameter={x:Static const:Constants.ExportTypeNative}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="163"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="24,25,0,0">
                            <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Opacity="0.3" Content="{Binding [Frame Option], Source={StaticResource L10N}}" Visibility="{Binding FileExport.Type, Converter={StaticResource RadioButtonVisibilityConverter}, ConverterParameter={x:Static const:Constants.ExportTypeNative}}"/>
                            <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Frame Option], Source={StaticResource L10N}}" Visibility="{Binding FileExport.Type, Converter={StaticResource RadioButtonVisibilityReverseConverter}, ConverterParameter={x:Static const:Constants.ExportTypeNative}}"/>
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <StackPanel Margin="0,19,0,0">
                                <RadioButton IsChecked="{Binding FileExport.Material, Converter={StaticResource RadioButtonConverter}, ConverterParameter={x:Static const:Constants.ExportMaterialPullback}}" Content="{Binding [Pullback], Source={StaticResource L10N}}"/>
                            </StackPanel>
                            <StackPanel Margin="0,6,0,0">
                                <RadioButton IsChecked="{Binding FileExport.Material, Converter={StaticResource RadioButtonConverter}, ConverterParameter={x:Static const:Constants.ExportMaterialCurrent}}" Content="{Binding [Current Frame], Source={StaticResource L10N}}"/>
                            </StackPanel>
                            <StackPanel Margin="0,6,0,0">
                                <RadioButton IsChecked="{Binding FileExport.Material, Converter={StaticResource RadioButtonConverter}, ConverterParameter={x:Static const:Constants.ExportMaterialBookmarked}}" Content="{Binding [Bookmarked Frames], Source={StaticResource L10N}}" IsEnabled="{Binding IsBookmarkOn}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="6" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource OutlinedBtnType3-Large}" HorizontalAlignment="Left" VerticalAlignment="Top" Command="{Binding CancelCommand}" Content="{Binding [Cancel], Source={StaticResource L10N}}"/>
                    <Button Grid.Column="1" Style="{StaticResource ContainedBtnType1-Large-Wide}" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding NextCommand}" Content="{Binding [Next], Source={StaticResource L10N}}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>    
</Page>
