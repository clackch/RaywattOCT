<Window x:Class="RaywattApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:RaywattApp.Common.Behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RaywattApp"
        ResizeMode="NoResize"
        WindowStyle="None"
        mc:Ignorable="d"
        Width="1280" Height="1024">

    <Grid Width="1280">
        <Frame NavigationUIVisibility="Hidden">
            <b:Interaction.Behaviors>
                <behaviors:FrameBehavior Parameter="{Binding NavigationParameter, Mode=TwoWay}" Navigation="{Binding NavigationSource, Mode=TwoWay}" />
            </b:Interaction.Behaviors>
        </Frame>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Width="1280" Height="60">
                <StackPanel HorizontalAlignment="Left">
                    <Button Style="{DynamicResource Home_Icon}" Command="{Binding HomeCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{DynamicResource Setting_Icon}" Command="{Binding SettingCommand}"/>
                    <Button Style="{DynamicResource Power_Icon}" Command="{Binding ExitCommand}"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2" Width="1280" Height="40" Background="#0d0d0d">
                <Image Style="{DynamicResource RaywattSmall_Icon}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
