<Window x:Class="RaywattApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:RaywattApp.Common.Behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RaywattApp"
        xmlns:component="clr-namespace:RaywattApp.Views.Component"
        xmlns:const="clr-namespace:RaywattApp.Common.Bases"
        ResizeMode="NoResize"
        WindowStyle="None"
        mc:Ignorable="d"
        Width="1280" Height="1024" Cursor="{DynamicResource arrow}" Left="0" Top="0">

    <Grid Width="1280">
        <Frame NavigationUIVisibility="Hidden">
            <b:Interaction.Behaviors>
                <behaviors:FrameBehavior Parameter="{Binding NavigationParameter, Mode=TwoWay}" Navigation="{Binding NavigationSource, Mode=TwoWay}" />
            </b:Interaction.Behaviors>
        </Frame>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel HorizontalAlignment="Left">
                    <component:IconButton Style="{DynamicResource IconButtonLarge}" Icon="home" Margin="14,9,0,9" Command="{Binding HomeCommand}" Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <component:IconButton Style="{DynamicResource IconButtonLarge}" Icon="setting" Margin="0,9,6,9" Command="{Binding SettingCommand}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                    <component:IconButton Style="{DynamicResource IconButtonLarge}" Icon="power" Margin="0,9,12,9" Command="{Binding ExitCommand}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Image Style="{DynamicResource RaywattSmall_Icon}"/>
                <StackPanel MinWidth="130" Margin="25,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Visibility="{Binding DeviceStatus.CatheterStatus, Converter={StaticResource RadioButtonVisibilityConverter}, ConverterParameter={x:Static const:Constants.CatheterStatusLocked}}">
                    <ProgressBar Style="{DynamicResource HomeCatheterProgressBar}" Value="{Binding CatheterProgress}" Width="72" Height="20" Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <ProgressBar Style="{DynamicResource CatheterProgressBar}" Value="{Binding CatheterProgress}" Width="72" Height="20" Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                    <StackPanel Width="8"/>
                    <Label Style="{DynamicResource Pretendard-Medium-14}" MinWidth="52" Foreground="{DynamicResource MainPrimaryColorBrush}" Content="{Binding [Loading], Source={StaticResource L10N}}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="200,0,0,0">
                    <Button Style="{DynamicResource OutlinedBtnType1}" Command="{Binding CatheterFailTestCommmand}" Width="100" Height="15" FontSize="9" Content="Catheter Fail"/>
                    <Button Style="{DynamicResource OutlinedBtnType1}" Command="{Binding CatheterConnectTestCommmand}" Width="100" Height="15" FontSize="9" Content="Catheter Connect"/>
                </StackPanel>
            </StackPanel>

            <component:MenuUnableComponent Grid.Row="0" Background="{StaticResource GrayscaleGray7Brush}" Opacity="0.7" IsLumenLoaded="{Binding DeviceStatus.IsLumenLoaded}" IsLumenSaved="{Binding DeviceStatus.IsLumenSaved}" IsOCTImagingDone="{Binding DeviceStatus.IsOCTImagingDone}">
                <component:MenuUnableComponent.Visibility>
                    <MultiBinding Converter="{StaticResource MenuUnableConverter}">
                        <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsLumenLoaded"/>
                        <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsLumenSaved"/>
                        <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsOCTImagingDone"/>
                    </MultiBinding>
                </component:MenuUnableComponent.Visibility>
            </component:MenuUnableComponent>

            <component:MenuUnableComponent Grid.Row="2" Background="{StaticResource GrayscaleGray7Brush}" Opacity="0.7" IsLumenLoaded="{Binding DeviceStatus.IsLumenLoaded}" IsLumenSaved="{Binding DeviceStatus.IsLumenSaved}" IsOCTImagingDone="{Binding DeviceStatus.IsOCTImagingDone}">
                <component:MenuUnableComponent.Visibility>
                    <MultiBinding Converter="{StaticResource MenuUnableConverter}">
                        <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsLumenLoaded"/>
                        <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsLumenSaved"/>
                        <Binding RelativeSource="{RelativeSource Mode=Self}" Path="IsOCTImagingDone"/>
                    </MultiBinding>
                </component:MenuUnableComponent.Visibility>
            </component:MenuUnableComponent>
        </Grid>
    </Grid>
</Window>
