<Window x:Class="RaywattApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:RaywattApp.Common.Behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RaywattApp"
        mc:Ignorable="d"
        Width="1280" Height="1080">

    <StackPanel>
        <StackPanel Height="30" Background="Black">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Label Foreground="White" Content="{Binding [Raywatt], Source={StaticResource L10N}}"></Label>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding IsShowPatient}">
                    <Label Foreground="White" Content="{Binding [ID], Source={StaticResource L10N}}"/>
                    <Label Foreground="White">[</Label>
                    <Label Foreground="White" Content="{Binding Patient.Id}"/>
                    <Label Foreground="White">]</Label>
                    <Label Foreground="White" Content="{Binding [Name], Source={StaticResource L10N}}"/>
                    <Label Foreground="White">[</Label>
                    <Label Foreground="White" Content="{Binding Patient.Firstname}"/>
                    <Label Foreground="White">, </Label>
                    <Label Foreground="White" Content="{Binding Patient.Lastname}"/>
                    <Label Foreground="White">]</Label>
                    <Label Foreground="White" Content="{Binding [Birth Date], Source={StaticResource L10N}}"/>
                    <Label Foreground="White">[</Label>
                    <Label Foreground="White" Content="{Binding Patient.Birthdate}"/>
                    <Label Foreground="White">]</Label>
                    <Label Foreground="White" Content="{Binding [Gender], Source={StaticResource L10N}}"/>
                    <Label Foreground="White">[</Label>
                    <Label Foreground="White" Content="{Binding Patient.Gender, Converter={StaticResource L10NConverter}}"/>
                    <Label Foreground="White">]</Label>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="50" Command="{Binding SettingCommand}" Content="{Binding [Setting], Source={StaticResource L10N}}" Margin="5,5,5,5" />
                    <Button Width="50" Command="{Binding ExitCommand}" Content="{Binding [Exit], Source={StaticResource L10N}}" Margin="5,5,5,5" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <StackPanel>
            <Grid Height="1000">
                <Frame NavigationUIVisibility="Hidden">
                    <b:Interaction.Behaviors>
                        <behaviors:FrameBehavior Parameter="{Binding NavigationParameter, Mode=TwoWay}" Navigation="{Binding NavigationSource, Mode=TwoWay}" />
                    </b:Interaction.Behaviors>
                </Frame>
                <Border Background="#66000000" Visibility="{Binding ShowViewLayerPopup, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="5">
                        <Border.Effect>
                            <DropShadowEffect />
                        </Border.Effect>
                        <ContentControl Width="1200" MinHeight="800">
                            <b:Interaction.Behaviors>
                                <behaviors:PopupControlBehavior Control="{Binding ViewControlName}" LayerPopup="{Binding ShowViewLayerPopup}"/>
                            </b:Interaction.Behaviors>
                        </ContentControl>
                    </Border>
                </Border>
                <Border Background="#66000000" Visibility="{Binding ShowLayerPopup, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="5">
                        <Border.Effect>
                            <DropShadowEffect />
                        </Border.Effect>
                        <ContentControl Width="400" MinHeight="200">
                            <b:Interaction.Behaviors>
                                <behaviors:PopupControlBehavior Control="{Binding ControlName}" LayerPopup="{Binding ShowLayerPopup}"/>
                            </b:Interaction.Behaviors>
                        </ContentControl>
                    </Border>
                </Border>
                <Border Background="#66000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="5">
                        <StackPanel Width="100" Margin="10">
                            <ProgressBar Height="10" IsIndeterminate="True" />
                            <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" Text="Busy..." />
                        </StackPanel>
                        <Border.Effect>
                            <DropShadowEffect />
                        </Border.Effect>
                    </Border>
                </Border>
            </Grid>
        </StackPanel>
    </StackPanel>
    
    
</Window>
