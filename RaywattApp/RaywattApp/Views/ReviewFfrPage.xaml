<Page x:Class="RaywattApp.Views.ReviewFfrPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RaywattApp.Views"
      xmlns:gl="clr-namespace:System.Globalization;assembly=mscorlib"
      xmlns:const="clr-namespace:RaywattApp.Common.Bases"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      mc:Ignorable="d" 
      d:DesignHeight="1024" d:DesignWidth="1280"
      Background="{DynamicResource GrayscaleGray8Brush}"
      Title="ReviewFfrPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource SideCardBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <StackPanel Width="70"/>
                <ToggleButton Style="{DynamicResource TabToggleBtn}" Content="{Binding [2D], Source={StaticResource L10N}}" Command="{Binding ReviewTypeSwitchCommand}" CommandParameter="{x:Static const:Constants.ReviewPage}"/>
                <ToggleButton Style="{DynamicResource TabToggleBtn}" Content="{Binding [3D], Source={StaticResource L10N}}" Command="{Binding ReviewTypeSwitchCommand}" CommandParameter="{x:Static const:Constants.Review3dPage}"/>
                <ToggleButton Style="{DynamicResource TabToggleBtn}" Content="{Binding [Compare], Source={StaticResource L10N}}" Command="{Binding ReviewTypeSwitchCommand}" CommandParameter="{x:Static const:Constants.ReviewComparePage}" Visibility="{Binding PatientCase.Procedure, Converter={StaticResource ProcedureVisibilityConverter}, ConverterParameter=$002|$003}"/>
                <ToggleButton Style="{DynamicResource TabToggleBtn}" Content="{Binding [AI FFR], Source={StaticResource L10N}}" IsChecked="True" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,50,0,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="199"/>
                <RowDefinition Height="466"/>
                <RowDefinition Height="109"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Margin="70,0,70,0" CornerRadius="10" Background="{DynamicResource GrayscaleGray7Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="715"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center">
                        <Label Style="{DynamicResource Pretendard-Bold-22}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding Patient.Firstname}"/>
                        <Label Style="{DynamicResource Pretendard-Bold-22}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content=", "/>
                        <Label Style="{DynamicResource Pretendard-Bold-22}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding Patient.Lastname}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray4Brush}" Content="{Binding [ID], Source={StaticResource L10N}}"/>
                        <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Margin="8,0,0,0" Content="{Binding Patient.Id}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray4Brush}" Content="{Binding [Birth], Source={StaticResource L10N}}"/>
                        <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Margin="8,0,0,0" Content="{Binding Patient.Birthdate, StringFormat=d, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray4Brush}" Content="{Binding [Gender], Source={StaticResource L10N}}"/>
                        <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Margin="8,0,0,0" Content="{Binding Patient.Gender, Converter={StaticResource CodeConverter}, ConverterParameter='GEND'}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="69"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="69"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="105"/>
                    <RowDefinition Height="82"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,0,0">
                    <Label Content="P" Style="{DynamicResource Pretendard-Semibold-16}" Foreground="{DynamicResource AdditionalColor7Brush}" Opacity="0.5"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,12,0">
                    <Label Content="D" Style="{DynamicResource Pretendard-Semibold-16}" Foreground="{DynamicResource AdditionalColor7Brush}" Opacity="0.5"/>
                </StackPanel>

                <Grid Grid.Row="1" Grid.Column="1">
                    <Image x:Name="longitude" Source="{Binding LumenProfileImage}" Width="{x:Static const:Constants.LongitudeWidth}" Height="{x:Static const:Constants.LongitudeHeight}" Stretch="Fill">
                        <Image.Clip>
                            <RectangleGeometry RadiusX="8" RadiusY="8">
                                <RectangleGeometry.Rect>
                                    <Rect X="0" Y="0" Width="{x:Static const:Constants.LongitudeWidth}" Height="{x:Static const:Constants.LongitudeHeight}"/>
                                </RectangleGeometry.Rect>
                            </RectangleGeometry>
                        </Image.Clip>
                    </Image>

                    <Canvas>
                        <!-- Section Lesion Length -->
                        <!-- 
                        <Line Canvas.Left="{Binding Section.LesionProximal}" HorizontalAlignment="Stretch" Stroke="{StaticResource GrayscaleGray2Brush}" StrokeDashArray="2 3" StrokeThickness="1" X1="{Binding Section.LesionLengthWidth}" Margin="0,100,0,0"/>
                        <Line Canvas.Left="{Binding Section.LesionDistal}" HorizontalAlignment="Stretch" Stroke="{StaticResource GrayscaleGray2Brush}" StrokeDashArray="2 3" StrokeThickness="1" X1="{Binding Section.LesionLengthWidth}" Margin="0,100,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,93,0,0" Canvas.Left="{Binding Section.LesionLength.X}" Visibility="{Binding Section.LesionLength.IsVisible}">
                            <TextBlock Style="{DynamicResource TextBlock_Pretendard-Semibold-10}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Text="{Binding Section.LesionLength.DValue, StringFormat={}{0:N1}}"/>
                            <StackPanel Width="1"/>
                            <Label Style="{DynamicResource Pretendard-Medium-10}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [㎜], Source={StaticResource L10N}}"/>
                        </StackPanel>
                        -->
                        <!-- Section Proximal -->
                        <Image Height="105" Source="{svgc:SvgImage Source=/res/indicator/sectionProximal.svg}" Canvas.Left="{Binding Section.Proximal.X}" Visibility="{Binding Section.Proximal.IsVisible}"/>
                        <!-- Section Distal -->
                        <Image Height="105" Source="{svgc:SvgImage Source=/res/indicator/sectionDistal.svg}" Canvas.Left="{Binding Section.Distal.X}" Visibility="{Binding Section.Distal.IsVisible}"/>
                        <!-- MLA -->
                        <Image Height="109" Width="8" Source="{svgc:SvgImage Source=/res/indicator/ffrMla.svg}" Canvas.Left="{Binding MlaX}" Margin="0,-4,0,0"/>
                    </Canvas>
                </Grid>
                <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center">
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Height="13" Width="1" Background="{DynamicResource GrayscaleGray5Brush}" Margin="0"/>
                    <Border Width="452" Height="60" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray5Brush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <StackPanel Width="24"/>
                                <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Vessel], Source={StaticResource L10N}}" VerticalAlignment="Center"/>
                                <StackPanel Width="20"/>
                                <Label Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding VesselType}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Lesion Length], Source={StaticResource L10N}}" VerticalAlignment="Center"/>
                                <StackPanel Width="20"/>
                                <Label Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding PatientCase.FfrFeature.LesionLength}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2" Margin="70,0,70,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="344"/>
                    <ColumnDefinition Width="452"/>
                    <ColumnDefinition Width="344"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Border Width="60" Height="21" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray3Brush}" Background="{DynamicResource GrayscaleGray5Brush}">
                        <Label Style="{DynamicResource Pretendard-Semibold-12}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Proximal], Source={StaticResource L10N}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Height="13" Width="1" Background="{DynamicResource GrayscaleGray3Brush}" Margin="0"/>
                    <Grid>
                        <Image Source="{Binding ProximalOctImage}" Width="344" Height="344"/>
                        <Image Source="{svgc:SvgImage Source=/res/icon/ffrCircleGray.svg}" Width="344" Height="344"/>
                    </Grid>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Height="13" Width="1" Background="{DynamicResource GrayscaleGray3Brush}" Margin="0"/>
                    <Border Width="250" Height="60" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray3Brush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Width="90" VerticalAlignment="Center">
                                <Label.Content>
                                    <AccessText TextWrapping="Wrap" Text="{Binding [Proximal Lumen Area], Source={StaticResource L10N}}"/>
                                </Label.Content>
                            </Label>
                            <Label Grid.Column="1" Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding PatientCase.FfrFeature.ProximalLumenArea}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <Border Width="60" Height="21" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource MainPrimaryColorBrush}" Background="{DynamicResource AdditionalColor2Brush}">
                        <Label Style="{DynamicResource Pretendard-Semibold-12}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [MLA], Source={StaticResource L10N}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Height="13" Width="1" Background="{DynamicResource MainPrimaryColorBrush}" Margin="0"/>
                    <Grid>
                        <Image Source="{Binding CrossSectionImage}" Width="344" Height="344"/>
                        <Image Source="{svgc:SvgImage Source=/res/icon/ffrCircleGreen.svg}" Width="344" Height="344"/>
                    </Grid>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Height="13" Width="1" Background="{DynamicResource MainPrimaryColorBrush}" Margin="0"/>
                    <Border Width="452" Height="60" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource MainPrimaryColorBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="4*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Width="100" VerticalAlignment="Center">
                                <Label.Content>
                                    <AccessText TextWrapping="Wrap" Text="{Binding [Percent Area Stenosis], Source={StaticResource L10N}}"/>
                                </Label.Content>
                            </Label>
                            <Label Grid.Column="1" Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding PatientCase.FfrFeature.PercentAreaStenosis}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Label Grid.Column="2" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Width="100" VerticalAlignment="Center">
                                <Label.Content>
                                    <AccessText TextWrapping="Wrap" Text="{Binding [Minimal Lumen Area], Source={StaticResource L10N}}"/>
                                </Label.Content>
                            </Label>
                            <Label Grid.Column="3" Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding PatientCase.FfrFeature.MinimalLumenArea}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Border Width="60" Height="21" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray3Brush}" Background="{DynamicResource GrayscaleGray5Brush}">
                        <Label Style="{DynamicResource Pretendard-Semibold-12}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Distal], Source={StaticResource L10N}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Height="13" Width="1" Background="{DynamicResource GrayscaleGray3Brush}" Margin="0"/>
                    <Grid>
                        <Image Source="{Binding DistalOctImage}" Width="344" Height="344"/>
                        <Image Source="{svgc:SvgImage Source=/res/icon/ffrCircleGray.svg}" Width="344" Height="344"/>
                    </Grid>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Height="13" Width="1" Background="{DynamicResource GrayscaleGray3Brush}" Margin="0"/>
                    <Border Width="250" Height="60" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray3Brush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Width="90" VerticalAlignment="Center">
                                <Label.Content>
                                    <AccessText TextWrapping="Wrap" Text="{Binding [Distal Lumen Area], Source={StaticResource L10N}}"/>
                                </Label.Content>
                            </Label>
                            <Label Grid.Column="1" Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding PatientCase.FfrFeature.DistalLumenArea}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
            <Border Grid.Row="3" Margin="70,0,70,0" CornerRadius="10" Background="{DynamicResource GrayscaleGray7Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="820"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource FfrPredictBtn}" Command="{Binding FfrPredictCommand}" Content="{Binding [Predict FFR], Source={StaticResource L10N}}" HorizontalAlignment="Left" Margin="50,0,0,0" IsEnabled="{Binding BtnFfrEnabled}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Label Style="{DynamicResource Pretendard-Bold-48}" Foreground="{DynamicResource MainPrimaryColorBrush}" Content="{Binding [FFR], Source={StaticResource L10N}}" VerticalAlignment="Center"/>
                        <StackPanel Width="38"/>
                        <Label Style="{DynamicResource Pretendard-Bold-74}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding FfrResult}" VerticalAlignment="Center" Opacity="{Binding OpacityResult}" Visibility="{Binding VisibilityResult}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Height="40" Background="{DynamicResource GrayscaleBlackBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                <Button Style="{StaticResource OutlinedBtnType1-Small-Wide}" Command="{Binding NewRecordingCommand}" Content="{Binding [New Recording], Source={StaticResource L10N}}"/>
                <StackPanel Width="8"/>
                <Button Style="{StaticResource OutlinedBtnType1-Small-Medium}" Command="{Binding EndReviewCommand}" Content="{Binding [End Review], Source={StaticResource L10N}}"/>
                <StackPanel Width="16"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
