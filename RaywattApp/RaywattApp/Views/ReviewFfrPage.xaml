<Page x:Class="RaywattApp.Views.ReviewFfrPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RaywattApp.Views"
      xmlns:gl="clr-namespace:System.Globalization;assembly=mscorlib"
      xmlns:const="clr-namespace:RaywattApp.Common.Bases"
      xmlns:component="clr-namespace:RaywattApp.Views.Component"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      mc:Ignorable="d" 
      d:DesignHeight="1024" d:DesignWidth="1280"
      Background="{DynamicResource GrayscaleGray8Brush}"
      Title="ReviewFfrPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource SideCardBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <StackPanel Width="70"/>
                <ToggleButton Style="{DynamicResource TabToggleBtn}" Content="{Binding [2D], Source={StaticResource L10N}}" Command="{Binding ReviewTypeSwitchCommand}" CommandParameter="{x:Static const:Constants.ReviewPage}"/>
                <ToggleButton Style="{DynamicResource TabToggleBtn}" Content="{Binding [3D], Source={StaticResource L10N}}" Command="{Binding ReviewTypeSwitchCommand}" CommandParameter="{x:Static const:Constants.Review3dPage}"/>
                <ToggleButton Style="{DynamicResource TabToggleBtn}" Content="{Binding [Compare], Source={StaticResource L10N}}" Command="{Binding ReviewTypeSwitchCommand}" CommandParameter="{x:Static const:Constants.ReviewComparePage}" Visibility="{Binding PatientCase.Procedure, Converter={StaticResource ProcedureVisibilityConverter}, ConverterParameter=$002|$003}"/>
                <ToggleButton Style="{DynamicResource TabToggleBtn}" Content="{Binding [AI FFR], Source={StaticResource L10N}}" IsChecked="True"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <component:IconButton Style="{StaticResource IconButton}" Icon="editPresetSimple" Width="42" Height="42" Command="{Binding EditPresetCommand}" Content="{Binding [Edit Preset], Source={StaticResource L10N}}"/>
                <StackPanel Width="6"/>
                <component:IconButton Style="{StaticResource IconButton}" Icon="exportSimple" Width="42" Height="42" Command="{Binding ExportCommand}" Content="{Binding [Export], Source={StaticResource L10N}}"/>
                <StackPanel Width="118"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="60,48,60,42">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="545"/>
                <RowDefinition Height="39"/>
                <RowDefinition Height="195"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="39"/>
                    <RowDefinition Height="16"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Label Style="{DynamicResource Pretendard-Bold-24}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding Patient.Firstname}"/>
                    <Label Style="{DynamicResource Pretendard-Bold-24}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content=", "/>
                    <Label Style="{DynamicResource Pretendard-Bold-24}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding Patient.Lastname}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray4Brush}" Content="{Binding [ID], Source={StaticResource L10N}}"/>
                        <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Margin="8,0,0,0" Content="{Binding Patient.Id}"/>
                    </StackPanel>
                    <StackPanel Margin="24,0,0,0" Orientation="Horizontal">
                        <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray4Brush}" Content="{Binding [Birth], Source={StaticResource L10N}}"/>
                        <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Margin="8,0,0,0" Content="{Binding Patient.Birthdate, StringFormat=d, ConverterCulture={x:Static gl:CultureInfo.CurrentCulture}}"/>
                    </StackPanel>
                    <StackPanel Margin="24,0,0,0" Orientation="Horizontal">
                        <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleGray4Brush}" Content="{Binding [Gender], Source={StaticResource L10N}}"/>
                        <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Margin="8,0,0,0" Content="{Binding Patient.Gender, Converter={StaticResource CodeConverter}, ConverterParameter='GEND'}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Image x:Name="crossSectionImage" Source="{Binding CrossSectionImage}" Width="380" Height="380" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                <Image Source="{svgc:SvgImage Source=/res/icon/ffrCrossSectionCircle.svg}" Width="396" Height="396" HorizontalAlignment="Left"/>
                <ProgressBar Style="{DynamicResource FfrProgressBar}" Value="{Binding FfrProgress}" Width="170" Height="228.7" HorizontalAlignment="Left" Margin="420,0,0,0"/>
                <Image Source="{svgc:SvgImage Source=/res/icon/ffrHeart.svg}" Width="170" Height="228.7" HorizontalAlignment="Left" Margin="420,0,0,0"/>
                <MediaElement x:Name="mediaElement" Source="res/media/ffr-508px.mp4" Width="508" Height="508" LoadedBehavior="Manual" MediaEnded="MediaElement_MediaEnded" HorizontalAlignment="Right" Margin="0,0,18,0">
                    <MediaElement.Clip>
                        <EllipseGeometry Center="254,254" RadiusX="254" RadiusY="254"/>
                    </MediaElement.Clip>
                </MediaElement>
                <Image Source="{svgc:SvgImage Source=/res/icon/ffrCenterLine.svg}" Width="348.3" Height="316.3" HorizontalAlignment="Left" Margin="320,0,0,0"/>
                <Image Source="{svgc:SvgImage Source=/res/icon/ffrResultInnerCircle.svg}" Width="508" Height="508" HorizontalAlignment="Right" Margin="0,0,18,0"/>
                <Image Source="{svgc:SvgImage Source=/res/icon/ffrResultOuterCircle.svg}" Width="545" Height="545" HorizontalAlignment="Right" />

                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Width="545" Margin="615,0,0,0">
                    <Label Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource MainPrimaryColorBrush}" Content="{Binding [FFR], Source={StaticResource L10N}}" HorizontalAlignment="Center"/>
                    <Label Style="{DynamicResource Pretendard-Bold-80}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Opacity="{Binding OpacityResult}" Content="{Binding FfrResult}" HorizontalAlignment="Center" Visibility="{Binding VisibilityResult}"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="3" CornerRadius="10" Background="{DynamicResource GrayscaleGray7Brush}">
                <Grid Margin="32,28,28,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="203"/>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="228"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Column="0" Grid.Row="0" Style="{DynamicResource Pretendard-Medium-18}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Model], Source={StaticResource L10N}}"/>
                    <Label Grid.Column="0" Grid.Row="1" Style="{DynamicResource Pretendard-Bold-26}" Margin="0,5,0,0" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Random Forest], Source={StaticResource L10N}}"/>
                    <Separator Grid.Column="1" Grid.RowSpan="4" Width="1" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="{DynamicResource SeparatorBrush}" HorizontalAlignment="Left" Margin="0"/>
                    <Label Grid.Column="2" Grid.Row="0" Style="{DynamicResource Pretendard-Medium-18}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Percent Area Stenosis], Source={StaticResource L10N}}"/>
                    <Label Grid.Column="2" Grid.Row="1" Style="{DynamicResource Pretendard-Bold-26}" Margin="0,5,0,0" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding PatientCase.FfrFeature.PercentAreaStenosis}"/>
                    <Label Grid.Column="2" Grid.Row="2" Style="{DynamicResource Pretendard-Medium-18}" Margin="0,23,0,0" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Lesion Length], Source={StaticResource L10N}}"/>
                    <Label Grid.Column="2" Grid.Row="3" Style="{DynamicResource Pretendard-Bold-26}" Margin="0,5,0,0" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding PatientCase.FfrFeature.LesionLength}"/>
                    <Label Grid.Column="3" Grid.Row="0" Style="{DynamicResource Pretendard-Medium-18}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Minimal Lumen Area], Source={StaticResource L10N}}"/>
                    <Label Grid.Column="3" Grid.Row="1" Style="{DynamicResource Pretendard-Bold-26}" Margin="0,5,0,0" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding PatientCase.FfrFeature.MinimalLumenArea}"/>
                    <Label Grid.Column="3" Grid.Row="2" Style="{DynamicResource Pretendard-Medium-18}" Margin="0,23,0,0" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Plaque Area], Source={StaticResource L10N}}"/>
                    <Label Grid.Column="3" Grid.Row="3" Style="{DynamicResource Pretendard-Bold-26}" Margin="0,5,0,0" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding PatientCase.FfrFeature.PlaqueArea}"/>
                    <Label Grid.Column="4" Grid.Row="0" Style="{DynamicResource Pretendard-Medium-18}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Distal Lumen Area], Source={StaticResource L10N}}"/>
                    <Label Grid.Column="4" Grid.Row="1" Style="{DynamicResource Pretendard-Bold-26}" Margin="0,5,0,0" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding PatientCase.FfrFeature.DistalLumenArea}"/>
                    <Label Grid.Column="4" Grid.Row="2" Style="{DynamicResource Pretendard-Medium-18}" Margin="0,23,0,0" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Proximal Lumen Area], Source={StaticResource L10N}}"/>
                    <Label Grid.Column="4" Grid.Row="3" Style="{DynamicResource Pretendard-Bold-26}" Margin="0,5,0,0" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding PatientCase.FfrFeature.ProximalLumenArea}"/>
                    <Grid Grid.Column="5" Grid.RowSpan="4" Margin="0,85,0,0" HorizontalAlignment="Right">
                        <Button Style="{StaticResource FfrPredictBtn}" Command="{Binding FfrPredictCommand}" Content="{Binding [Predict FFR], Source={StaticResource L10N}}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Height="40" Background="{DynamicResource GrayscaleBlackBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                <Button Style="{StaticResource OutlinedBtnType1-Small-Wide}" Command="{Binding NewRecordingCommand}" Content="{Binding [New Recording], Source={StaticResource L10N}}"/>
                <StackPanel Width="8"/>
                <Button Style="{StaticResource OutlinedBtnType1-Small-Medium}" Command="{Binding EndReviewCommand}" Content="{Binding [End Review], Source={StaticResource L10N}}"/>
                <StackPanel Width="16"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
