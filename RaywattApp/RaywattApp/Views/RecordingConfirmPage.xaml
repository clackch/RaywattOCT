<Page x:Class="RaywattApp.Views.RecordingConfirmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RaywattApp.Views"
      xmlns:const="clr-namespace:RaywattApp.Common.Bases"
      xmlns:System="clr-namespace:System;assembly=mscorlib"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      mc:Ignorable="d" 
      d:DesignHeight="1024" d:DesignWidth="1280"
      Background="{DynamicResource GrayscaleGray8Brush}"
      Title="RecordingConfirmPage">
    <Page.Resources>
        <System:Boolean x:Key="TrueValue">True</System:Boolean>
        <System:Boolean x:Key="FalseValue">False</System:Boolean>
        <System:Double x:Key="CrossSectionSize">400</System:Double>
        <System:Double x:Key="LongitudeWidth">860</System:Double>
        <System:Double x:Key="LongitudeHeight">105</System:Double>
        <System:Double x:Key="LongitudeScale">86</System:Double>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="60" Background="{DynamicResource GrayscaleGray7Brush}">
            <Label Style="{DynamicResource Pretendard-Medium-18}" Foreground="{DynamicResource GrayscaleGray3Brush}" Margin="75,20,0,19" Content="{Binding [New Recording], Source={StaticResource L10N}}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="160,62,160,62">
            <Grid.RowDefinitions>
                <RowDefinition Height="725"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="74"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" CornerRadius="10,10,0,0" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray7Brush}" Background="{DynamicResource GrayscaleGray6Brush}">
                <Grid Margin="0,35,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="400"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="125"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="211,0,211,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <Image Source="{svgc:SvgImage Source=/res/icon/recordingStep1.svg}" Width="47.8" Height="37"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Image Source="{svgc:SvgImage Source=/res/icon/recordingBar.svg}" Width="138" Height="3"/>
                        </StackPanel>
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Image Source="{svgc:SvgImage Source=/res/icon/recordingStep2.svg}" Width="30.9" Height="36"/>
                        </Grid>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <Image Source="{svgc:SvgImage Source=/res/icon/recordingBar.svg}" Width="138" Height="3"/>
                        </StackPanel>
                        <Grid Grid.Column="4" VerticalAlignment="Center">
                            <Image Source="{svgc:SvgImage Source=/res/icon/recordingStep3_active.svg}"/>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="2" Margin="49,0,49,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="10" Background="{DynamicResource AdditionalColor5Brush}">
                            <Image x:Name="crossSectionImage" Source="{Binding CrossSectionImage}" Width="{StaticResource CrossSectionSize}" Height="{StaticResource CrossSectionSize}" Stretch="Fill"/>
                        </Border>
                        <Grid Grid.Column="1" Margin="60,109,52,109">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="37"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Label Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Confirm Image Quality], Source={StaticResource L10N}}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <Label Style="{DynamicResource Pretendard-Medium-18}" Foreground="{DynamicResource GrayscaleGray3Brush}">
                                    <Label.Content>
                                        <AccessText TextWrapping="Wrap" Text="{Binding [Review pullback for proper blood clearing in areas of interest.], Source={StaticResource L10N}}"/>
                                    </Label.Content>
                                </Label>
                                <Label Content=""/>
                                <Label Style="{DynamicResource Pretendard-Medium-18}" Foreground="{DynamicResource GrayscaleGray3Brush}">
                                    <Label.Content>
                                        <AccessText TextWrapping="Wrap" Text="{Binding [And indicates area of low confidence in Lumen contour.], Source={StaticResource L10N}}"/>
                                    </Label.Content>
                                </Label>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="49"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="49"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,0,0">
                            <Label Content="P" Style="{DynamicResource Pretendard-Semibold-20}" Foreground="{DynamicResource AdditionalColor7Brush}" Opacity="0.5"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,12,0">
                            <Label Content="D" Style="{DynamicResource Pretendard-Semibold-20}" Foreground="{DynamicResource AdditionalColor7Brush}" Opacity="0.5"/>
                        </StackPanel>
                        <Border Grid.Row="0" Grid.Column="1" CornerRadius="8,8,0,0" Background="{DynamicResource AdditionalColor5Brush}">
                            <Image x:Name="longitudeImage" Source="{Binding LongitudeImage}" Width="{StaticResource LongitudeWidth}" Height="{StaticResource LongitudeHeight}" Stretch="Fill"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" CornerRadius="0,0,8,8" Background="{DynamicResource BackgroundBrush}">
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Converter={StaticResource GridLengthConverter}, ConverterParameter={StaticResource LongitudeScale}}"/>
                                    <ColumnDefinition Width="{Binding Converter={StaticResource GridLengthConverter}, ConverterParameter={StaticResource LongitudeScale}}"/>
                                    <ColumnDefinition Width="{Binding Converter={StaticResource GridLengthConverter}, ConverterParameter={StaticResource LongitudeScale}}"/>
                                    <ColumnDefinition Width="{Binding Converter={StaticResource GridLengthConverter}, ConverterParameter={StaticResource LongitudeScale}}"/>
                                    <ColumnDefinition Width="{Binding Converter={StaticResource GridLengthConverter}, ConverterParameter={StaticResource LongitudeScale}}"/>
                                    <ColumnDefinition Width="{Binding Converter={StaticResource GridLengthConverter}, ConverterParameter={StaticResource LongitudeScale}}"/>
                                    <ColumnDefinition Width="{Binding Converter={StaticResource GridLengthConverter}, ConverterParameter={StaticResource LongitudeScale}}"/>
                                    <ColumnDefinition Width="{Binding Converter={StaticResource GridLengthConverter}, ConverterParameter={StaticResource LongitudeScale}}"/>
                                    <ColumnDefinition Width="{Binding Converter={StaticResource GridLengthConverter}, ConverterParameter={StaticResource LongitudeScale}}"/>
                                    <ColumnDefinition Width="{Binding Converter={StaticResource GridLengthConverter}, ConverterParameter={StaticResource LongitudeScale}}"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1" Width="1" HorizontalAlignment="Left" Background="{DynamicResource VerticalSeparatorBrush}"/>
                                <StackPanel Grid.Column="2" Width="1" HorizontalAlignment="Left" Background="{DynamicResource VerticalSeparatorBrush}"/>
                                <StackPanel Grid.Column="3" Width="1" HorizontalAlignment="Left" Background="{DynamicResource VerticalSeparatorBrush}"/>
                                <StackPanel Grid.Column="4" Width="1" HorizontalAlignment="Left" Background="{DynamicResource VerticalSeparatorBrush}"/>
                                <StackPanel Grid.Column="5" Width="1" HorizontalAlignment="Left" Background="{DynamicResource VerticalSeparatorBrush}"/>
                                <StackPanel Grid.Column="6" Width="1" HorizontalAlignment="Left" Background="{DynamicResource VerticalSeparatorBrush}"/>
                                <StackPanel Grid.Column="7" Width="1" HorizontalAlignment="Left" Background="{DynamicResource VerticalSeparatorBrush}"/>
                                <StackPanel Grid.Column="8" Width="1" HorizontalAlignment="Left" Background="{DynamicResource VerticalSeparatorBrush}"/>
                                <StackPanel Grid.Column="9" Width="1" HorizontalAlignment="Left" Background="{DynamicResource VerticalSeparatorBrush}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            <Separator Grid.Row="1" Foreground="{DynamicResource GrayscaleGray5Brush}"/>
            <Border Grid.Row="2" CornerRadius="0,0,10,10" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray7Brush}" Background="{DynamicResource GrayscaleGray6Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Left" Margin="16,16,0,0">
                        <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding RedoPullbackCommand}" Content="{Binding [Re-do Pullback], Source={StaticResource L10N}}"/>
                    </StackPanel>
                    <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0">
                        <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Command="{Binding ConfirmCommand}" Content="{Binding [Accept and Continue], Source={StaticResource L10N}}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Height="40" Background="{DynamicResource GrayscaleBlackBrush}"/>
    </Grid>
</Page>
