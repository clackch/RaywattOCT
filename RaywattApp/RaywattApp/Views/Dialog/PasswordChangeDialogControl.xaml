<UserControl x:Class="RaywattApp.Views.Dialog.PasswordChangeDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:RaywattApp.Common.Behaviors"
             xmlns:local="clr-namespace:RaywattApp.Views.Dialog"
             xmlns:ut ="clr-namespace:RaywattApp.Common.Util"
             xmlns:const="clr-namespace:RaywattApp.Common.Bases"
             mc:Ignorable="d" 
             Width="{Binding DialogWidth}"
             Height="{Binding DialogHeight}">
    
    <Border CornerRadius="10" 
            Background="{DynamicResource GrayscaleGray6Brush}" 
            BorderThickness="1" 
            BorderBrush="{DynamicResource GrayscaleGray7Brush}" 
            Width="{x:Static const:Constants.FileFolderBrowseDialogWidth}" 
            Height="{x:Static const:Constants.FileFolderBrowseDialogHeight}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="1"
                    Background="Transparent" 
                    Padding="30">
                <StackPanel>
                    <Label Style="{DynamicResource Pretendard-Bold-32}" 
                       Foreground="{DynamicResource GrayscaleWhiteBrush}" 
                       Content="Password Change"
                       HorizontalContentAlignment="Center"
                       HorizontalAlignment="Center"/>
                    <StackPanel Height="30"/>

                    <Label Style="{DynamicResource Pretendard-Medium-16}" 
                       Content="Old Password" 
                       Foreground="{DynamicResource GrayscaleWhiteBrush}"/>
                    <StackPanel Height="6"/>
                    <PasswordBox Style="{DynamicResource PasswordBoxValidator}"
                             MaxLength="50"
                             ut:PasswordBoxHelper.Attach="True"
                             ut:PasswordBoxHelper.BindablePassword="{Binding OldPassword}"
                             Background="Transparent"
                             Tag="Please enter your old password"/>
                    <Separator Height="1" Background="{DynamicResource VerticalSeparatorBrush}"/>
                    <StackPanel Height="24"/>

                    <Label Style="{DynamicResource Pretendard-Medium-16}" 
                       Content="New Password" 
                       Foreground="{DynamicResource GrayscaleWhiteBrush}"/>
                    <StackPanel Height="6"/>
                    <PasswordBox Style="{DynamicResource PasswordBoxValidator}"
                             MaxLength="50"
                             ut:PasswordBoxHelper.Attach="True"
                             ut:PasswordBoxHelper.BindablePassword="{Binding NewPassword}"
                             Background="Transparent"
                             Tag="Please enter new password"/>
                    <StackPanel Height="20"/>

                    <Label Style="{DynamicResource Pretendard-Medium-16}" 
                       Content="Confirm Password" 
                       Foreground="{DynamicResource GrayscaleWhiteBrush}"/>
                    <StackPanel Height="6"/>
                    <PasswordBox Style="{DynamicResource PasswordBoxValidator}"
                             MaxLength="50"
                             ut:PasswordBoxHelper.Attach="True"
                             ut:PasswordBoxHelper.BindablePassword="{Binding ConfirmPassword}"
                             Background="Transparent"
                             Tag="Please confirm new password"/>
                    <StackPanel Height="20"/>

                    <TextBlock Foreground="{DynamicResource AdditionalColor3Brush}" 
                           Text="Password must be at least 8 characters long and include uppercase letters, lowercase letters, numbers, and special characters."
                           FontSize="12"
                           TextWrapping="Wrap"/>
                    <StackPanel Height="30"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource OutlinedBtnType3-Large}" 
                                Command="{Binding CancelCommand}" 
                                CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
                                Content="{Binding [Cancel], Source={StaticResource L10N}}"/>
                        <StackPanel Width="8"/>
                        <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" 
                                Command="{Binding OkCommand}" 
                                CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
                                Content="{Binding [OK], Source={StaticResource L10N}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Border>
</UserControl>
