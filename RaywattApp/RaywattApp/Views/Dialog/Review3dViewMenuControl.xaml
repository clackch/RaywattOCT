<UserControl x:Class="RaywattApp.Views.Dialog.Review3dViewMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Views.Dialog"
             xmlns:const="clr-namespace:RaywattApp.Common.Bases"
             mc:Ignorable="d" 
             Width="{Binding DialogWidth}" Height="{Binding DialogHeight}">
    <Border Grid.Row="0" CornerRadius="0,8,8,0" HorizontalAlignment="Left" Width="{x:Static const:Constants.SideBarExpandSize}" Background="{StaticResource SideCardBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <Button Style="{DynamicResource SideMenuTitleLeft}" Content="{Binding [3D Option], Source={StaticResource L10N}}" Command="{Binding CmdClose}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"/>
            </StackPanel>
            <Grid Grid.Row="1" Width="192" HorizontalAlignment="Center" Margin="0,25,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <Label Style="{DynamicResource Pretendard-Medium-12}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Display Modes], Source={StaticResource L10N}}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,2,0,0">
                    <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Tissue], Source={StaticResource L10N}}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right">
                    <ToggleButton Style="{DynamicResource IconToggleBtn-Small}" IsChecked="{Binding IsTissueOn}" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,2,0,0">
                    <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Lumen], Source={StaticResource L10N}}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right">
                    <ToggleButton Style="{DynamicResource IconToggleBtn-Small}" IsChecked="{Binding IsLumenOn}" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,2,0,0">
                    <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Stent], Source={StaticResource L10N}}"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right">
                    <ToggleButton Style="{DynamicResource IconToggleBtn-Small}" IsChecked="{Binding IsStentOn}" HorizontalAlignment="Right" IsEnabled="{Binding IsPostCase}"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
                    <Label Style="{DynamicResource Pretendard-Medium-12}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Guidewires], Source={StaticResource L10N}}"/>
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,2,0,0">
                    <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Guidewire 1], Source={StaticResource L10N}}"/>
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="1" HorizontalAlignment="Right">
                    <ToggleButton Style="{DynamicResource IconToggleBtn-Small}" IsChecked="{Binding IsGuidewireOneOn}" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,2,0,0">
                    <Label Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Guidewire 2], Source={StaticResource L10N}}"/>
                </StackPanel>
                <StackPanel Grid.Row="6" Grid.Column="1" HorizontalAlignment="Right">
                    <ToggleButton Style="{DynamicResource IconToggleBtn-Small}" IsChecked="{Binding IsGuidewireTwoOn}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
