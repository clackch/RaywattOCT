<UserControl x:Class="RaywattApp.Views.Dialog.DicomPacsDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:const="clr-namespace:RaywattApp.Common.Bases"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"                
             xmlns:behaviors="clr-namespace:RaywattApp.Common.Behaviors"
             xmlns:local="clr-namespace:RaywattApp.Views.Dialog"
             mc:Ignorable="d" 
             Width="{Binding DialogWidth}" Height="{Binding DialogHeight}">

    <Border CornerRadius="10" Background="{DynamicResource GrayscaleGray6Brush}" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray7Brush}" Width="{x:Static const:Constants.DicomPacsDialogWidth}" Height="{x:Static const:Constants.DicomPacsDialogHeight}">
        <Grid Margin="32,0,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="68"/>
                <RowDefinition Height="400"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="78"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                <Label Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Select PACS Server], Source={StaticResource L10N}}"/>
            </StackPanel>

            <DataGrid Grid.Row="2" Name="dicomServerList" ItemsSource="{Binding DicomServers}" SelectedItem="{Binding SelectedDicomServer}" Style="{StaticResource DataGridDialog}" RowStyle="{StaticResource DataGridRowDialog}" ColumnHeaderStyle="{StaticResource DataGridColumnHeaderDialog}" SelectionMode="Single" Height="409">
                <i:Interaction.Behaviors>
                    <behaviors:DataGridLoadedBehavior />
                </i:Interaction.Behaviors>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}" CommandParameter="{Binding ElementName=dicomServerList, Path=SelectedItem}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <DataGrid.Columns>
                    <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" Width="*" Binding="{Binding AeTitle}" Header="{Binding [AE Title], Source={StaticResource L10N}}"/>
                    <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" Width="*" Binding="{Binding Hostname}" Header="{Binding [Hostname], Source={StaticResource L10N}}"/>
                    <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" Width="*" Binding="{Binding IpAddress}" Header="{Binding [IP], Source={StaticResource L10N}}"/>
                    <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" Width="0.8*" Binding="{Binding Port}" Header="{Binding [Port], Source={StaticResource L10N}}"/>
                    <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltip}" Width="*" Binding="{Binding Comment}" Header="{Binding [Comment], Source={StaticResource L10N}}" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="4" VerticalAlignment="Top">
                <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding NoCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [Cancel], Source={StaticResource L10N}}" HorizontalAlignment="Left"/>
                <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Command="{Binding SelectCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [OK], Source={StaticResource L10N}}" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
