<UserControl x:Class="RaywattApp.Views.Dialog.LocalHostDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Views.Dialog"
             xmlns:const="clr-namespace:RaywattApp.Common.Bases"
             xmlns:component="clr-namespace:RaywattApp.Views.Component"
             mc:Ignorable="d" 
             Width="{Binding DialogWidth}" Height="{Binding DialogHeight}">

    <Border CornerRadius="10" Background="{DynamicResource GrayscaleGray6Brush}" Width="{x:Static const:Constants.LocalHostDialogWidth}" Height="{x:Static const:Constants.LocalHostDialogHeight}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="531"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="82"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="30,44,30,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="166"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="320"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Label Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Local Host], Source={StaticResource L10N}}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Margin="28,0,0,0">
                                <RadioButton IsChecked="{Binding LocalHost.IsManual}" Content="{Binding [Manual], Source={StaticResource L10N}}"/>
                            </StackPanel>
                            <StackPanel Margin="28,0,0,0">
                                <RadioButton IsChecked="{Binding LocalHost.IsManual, Converter={StaticResource BoolToEnableReverseConverter}}" Content="{Binding [Auto], Source={StaticResource L10N}}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [AE Title], Source={StaticResource L10N}}" Margin="0,28,0,0"/>
                    <TextBox Style="{DynamicResource TextBoxValidator}" MaxLength="50" Text="{Binding AeTitle.Text, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [Enter AE Title], Source={StaticResource L10N}}" ToolTip="{Binding AeTitle.Msg}" Width="390" Margin="0,7,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
                <Separator Grid.Row="1" Background="{DynamicResource GrayscaleGray5Brush}" Height="1"/>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="72"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Hostname], Source={StaticResource L10N}}" Margin="0,20,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="0" Style="{DynamicResource TextBoxWithCorner}" Text="{Binding LocalHost.Hostname}" Width="390" VerticalAlignment="Top"/>
                    <Label Grid.Row="0" Grid.Column="2" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [IP Address], Source={StaticResource L10N}}" Margin="0,20,0,0"/>
                    <Grid Grid.Row="1" Grid.Column="2">
                        <Border Height="54" CornerRadius="8" BorderBrush="{DynamicResource GrayscaleGray5Brush}" BorderThickness="1" VerticalAlignment="Top"/>
                        <component:IpAddressInputControl Visibility="{Binding LocalHost.IsManual, Converter={StaticResource BoolToVisibilityConverter}}" IpAddress="{Binding IpAddress}" ToolTip="{Binding IpAddress.Msg}"/>
                    </Grid>
                    <Label Grid.Row="2" Grid.Column="0" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Subnet Mask], Source={StaticResource L10N}}" Margin="0,2,0,0"/>
                    <Grid Grid.Row="3" Grid.Column="0">
                        <Border Height="54" CornerRadius="8" BorderBrush="{DynamicResource GrayscaleGray5Brush}" BorderThickness="1" VerticalAlignment="Top"/>
                        <component:IpAddressInputControl Visibility="{Binding LocalHost.IsManual, Converter={StaticResource BoolToVisibilityConverter}}" SubnetMask="{Binding SubnetMask}" ToolTip="{Binding SubnetMask.Msg}"/>
                    </Grid>
                    <Label Grid.Row="2" Grid.Column="2" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Default Gateway], Source={StaticResource L10N}}" Margin="0,2,0,0"/>
                    <Grid Grid.Row="3" Grid.Column="2">
                        <Border Height="54" CornerRadius="8" BorderBrush="{DynamicResource GrayscaleGray5Brush}" BorderThickness="1" VerticalAlignment="Top"/>
                        <component:IpAddressInputControl Visibility="{Binding LocalHost.IsManual, Converter={StaticResource BoolToVisibilityConverter}}" IpAddress="{Binding DefaultGateway}" ToolTip="{Binding DefaultGateway.Msg}"/>
                    </Grid>
                    <Label Grid.Row="4" Grid.Column="0" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Preferred DNS Server], Source={StaticResource L10N}}" Margin="0,2,0,0"/>
                    <Grid Grid.Row="5" Grid.Column="0">
                        <Border Height="54" CornerRadius="8" BorderBrush="{DynamicResource GrayscaleGray5Brush}" BorderThickness="1" VerticalAlignment="Top"/>
                        <component:IpAddressInputControl Visibility="{Binding LocalHost.IsManual, Converter={StaticResource BoolToVisibilityConverter}}" IpAddress="{Binding PreferredDnsServer}" ToolTip="{Binding PreferredDnsServer.Msg}"/>
                    </Grid>
                    <Label Grid.Row="4" Grid.Column="2" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Alternate DNS Server], Source={StaticResource L10N}}" Margin="0,2,0,0"/>
                    <Grid Grid.Row="5" Grid.Column="2">
                        <Border Height="54" CornerRadius="8" BorderBrush="{DynamicResource GrayscaleGray5Brush}" BorderThickness="1" VerticalAlignment="Top"/>
                        <component:IpAddressInputControl Visibility="{Binding LocalHost.IsManual, Converter={StaticResource BoolToVisibilityConverter}}" IpAddress="{Binding AlternateDnsServer}" ToolTip="{Binding AlternateDnsServer.Msg}"/>
                    </Grid>
                </Grid>
            </Grid>

            <Separator Grid.Row="1" Background="{DynamicResource GrayscaleGray5Brush}" Height="1"/>

            <Grid Grid.Row="2" Margin="30,0,30,0">
                <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding NoCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [Cancel], Source={StaticResource L10N}}" HorizontalAlignment="Left"/>
                <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Command="{Binding YesCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [Save], Source={StaticResource L10N}}" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
