<UserControl x:Class="RaywattApp.Views.Dialog.PatientInputDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:RaywattApp.Common.Behaviors"
             xmlns:local="clr-namespace:RaywattApp.Views.Dialog"
             xmlns:const="clr-namespace:RaywattApp.Common.Bases"
             mc:Ignorable="d"
             Width="{Binding DialogWidth}" Height="{Binding DialogHeight}">
    <Border Width="{x:Static const:Constants.PatientInputDialogWidth}" Height="{x:Static const:Constants.PatientInputDialogHeight}" CornerRadius="10" BorderThickness="0" Background="{DynamicResource GrayscaleGray6Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="78"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="78"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="78"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="78"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="78"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0">
                <Label Style="{DynamicResource Pretendard-Bold-26}" Content="{Binding [Enter Patient Information], Source={StaticResource L10N}}" Foreground="{DynamicResource GrayscaleWhiteBrush}"/>
            </StackPanel>

            <Label Grid.Row="1" Grid.Column="1" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [ID], Source={StaticResource L10N}}" Padding="0" VerticalAlignment="Center"/>
            <Border Grid.Row="2" Grid.Column="1"  Margin="0 0 0 10" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray5Brush}" Height="54">
                <TextBox Style="{DynamicResource TextBoxReadOnly}" Text="{Binding Patient.Id}" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </Border>

            <Label Grid.Row="3" Grid.Column="1" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [First Name], Source={StaticResource L10N}}" Padding="0" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1" Style="{DynamicResource TextBoxBase}" Text="{Binding Patient.Firstname, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [Enter First Name], Source={StaticResource L10N}}" Width="auto" Margin="0,0,0,8"/>

            <Label Grid.Row="5" Grid.Column="1" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Last Name], Source={StaticResource L10N}}" Padding="0" VerticalAlignment="Center"/>
            <TextBox Grid.Row="6" Grid.Column="1" Style="{DynamicResource TextBoxBase}" Text="{Binding Patient.Lastname, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [Enter Last Name], Source={StaticResource L10N}}" Width="auto" Margin="0,0,0,8"/>

            <Label Grid.Row="7" Grid.Column="1" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Birth Date], Source={StaticResource L10N}}" Padding="0" VerticalAlignment="Center"/>
            <DatePicker Grid.Row="8" Grid.Column="1" Style="{DynamicResource DatePickerStyle}" behaviors:DatePickerPopupOffsetBehavior.AutoVerticalOffset="True" behaviors:DatePickerPopupOffsetBehavior.AutoHorizontalOffset="True" SelectedDate="{Binding Patient.Birthdate, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [Enter Birth Date], Source={StaticResource L10N}}" Width="auto" Margin="0,0,0,24"/>

            <Label Grid.Row="9" Grid.Column="1" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Gender], Source={StaticResource L10N}}" Padding="0" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="10" Grid.Column="1" ItemsSource="{Binding GenderComboBox}" SelectedValue="{Binding SelectedGender, Mode=TwoWay}" SelectedValuePath="Key" DisplayMemberPath="Value" Width="auto" Margin="0,0,0,24" Tag="{Binding [Select Gender], Source={StaticResource L10N}}"/>

            <Separator Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="3" Height="1" Background="{DynamicResource VerticalSeparatorBrush}" VerticalAlignment="Bottom"/>

            <Grid Grid.Row="13" Grid.Column="1">
                <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding NoCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [Cancel], Source={StaticResource L10N}}" HorizontalAlignment="Left"/>
                <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Command="{Binding PatientSaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [OK], Source={StaticResource L10N}}" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
