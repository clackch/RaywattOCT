<UserControl x:Class="RaywattApp.Views.Dialog.EditInstituteDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Views.Dialog"
             xmlns:const="clr-namespace:RaywattApp.Common.Bases"
             mc:Ignorable="d" 
             Width="{Binding DialogWidth}" Height="{Binding DialogHeight}">
    <Border Width="{x:Static const:Constants.EditInstituteDialogWidth}"  Height="{x:Static const:Constants.EditInstituteDialogHeight}" CornerRadius="10,10,10,10" BorderThickness="0" BorderBrush="Transparent" Background="{DynamicResource GrayscaleGray6Brush}">
        <StackPanel Margin="32,35,32,35">
            <Label Style="{DynamicResource Pretendard-Bold-32}" Content="{Binding [Edit Institute Info.], Source={StaticResource L10N}}" Foreground="{StaticResource GrayscaleWhiteBrush}" HorizontalAlignment="Center"/>
            <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Margin="0,20,0,0" Content="{Binding [Name], Source={StaticResource L10N}}"/>
            <TextBox Style="{DynamicResource TextBoxValidator}" Width="408" Text="{Binding Institute.Name, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [Enter Name], Source={StaticResource L10N}}" Margin="0,6,0,0"/>
            <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Margin="0,8,0,0" Content="{Binding [Comment], Source={StaticResource L10N}}"/>
            <TextBox Style="{DynamicResource TextBoxBase}" Width="408" Text="{Binding Institute.Comment, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [Enter Comment], Source={StaticResource L10N}}" Margin="0,6,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding NoCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [Cancel], Source={StaticResource L10N}}"/>
                <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [OK], Source={StaticResource L10N}}" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
