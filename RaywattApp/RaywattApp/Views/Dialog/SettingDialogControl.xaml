<UserControl x:Class="RaywattApp.Views.Dialog.SettingDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:RaywattApp.Common.Behaviors"
             xmlns:local="clr-namespace:RaywattApp.Views.Dialog"
             xmlns:const="clr-namespace:RaywattApp.Common.Bases"
             mc:Ignorable="d" 
             Width="{Binding DialogWidth}" Height="{Binding DialogHeight}"
             Name="settingDialogControl">

    <Border CornerRadius="10" Background="{DynamicResource GrayscaleGray6Brush}" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray7Brush}" Width="{x:Static const:Constants.SettingDialogWidth}" Height="{x:Static const:Constants.SettingDialogHeight}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="29"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="584"/>
                <ColumnDefinition Width="29"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="66"/>
                <RowDefinition Height="520"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="19"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" Grid.Column="1">
                <Label Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Setting], Source={StaticResource L10N}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <Grid Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left">
                <StackPanel>
                    <Button Style="{Binding PopupNavigationSource, Converter={StaticResource SettingSelectedConverter}, ConverterParameter={x:Static const:Constants.SettingDatabasePage}}" Command="{Binding PopupNavigateCommand}" CommandParameter="{x:Static const:Constants.SettingDatabasePage}" Content="{Binding [Storage], Source={StaticResource L10N}}"/>
                    <Button Style="{Binding PopupNavigationSource, Converter={StaticResource SettingSelectedConverter}, ConverterParameter={x:Static const:Constants.SettingLogPage}}" Command="{Binding PopupNavigateCommand}" CommandParameter="{x:Static const:Constants.SettingLogPage}" Content="{Binding [Log], Source={StaticResource L10N}}"/>
                    <Button Style="{Binding PopupNavigationSource, Converter={StaticResource SettingSelectedConverter}, ConverterParameter={x:Static const:Constants.SettingDicomPage}}" Command="{Binding PopupNavigateCommand}" CommandParameter="{x:Static const:Constants.SettingDicomPage}" Content="{Binding [DICOM], Source={StaticResource L10N}}" Visibility="{Binding ., Converter={StaticResource RV200ToVisibilityReverseConverter}}"/>
                    <Button Style="{Binding PopupNavigationSource, Converter={StaticResource SettingSelectedConverter}, ConverterParameter={x:Static const:Constants.SettingMaintenancePage}}" Command="{Binding PopupNavigateCommand}" CommandParameter="{x:Static const:Constants.SettingMaintenancePage}" Content="{Binding [Maintenance], Source={StaticResource L10N}}"/>
                    <Button Style="{Binding PopupNavigationSource, Converter={StaticResource SettingSelectedConverter}, ConverterParameter={x:Static const:Constants.SettingTermsConditionsPage}}" Command="{Binding PopupNavigateCommand}" CommandParameter="{x:Static const:Constants.SettingTermsConditionsPage}" Content="{Binding [Terms and Conditions], Source={StaticResource L10N}}" Visibility="{Binding ., Converter={StaticResource RV200ToVisibilityReverseConverter}}"/>
                    <Button Style="{Binding PopupNavigationSource, Converter={StaticResource SettingSelectedConverter}, ConverterParameter={x:Static const:Constants.SettingTermsConditionsPage_RV200}}" Command="{Binding PopupNavigateCommand}" CommandParameter="{x:Static const:Constants.SettingTermsConditionsPage_RV200}" Content="{Binding [Terms and Conditions], Source={StaticResource L10N}}" Visibility="{Binding ., Converter={StaticResource RV200ToVisibilityConverter}}"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,20">
                    <Button Style="{Binding PopupNavigationSource, Converter={StaticResource SettingSelectedConverter}, ConverterParameter={x:Static const:Constants.SettingPasswordChangePage}}" Command="{Binding PopupNavigateCommand}" CommandParameter="{x:Static const:Constants.SettingPasswordChangePage}" Content="{Binding [Account], Source={StaticResource L10N}}" Visibility="{Binding ., Converter={StaticResource RV200ToVisibilityReverseConverter}}"/>
                    <Button Style="{Binding PopupNavigationSource, Converter={StaticResource SettingSelectedConverter}, ConverterParameter={x:Static const:Constants.SettingAboutPage}}" Command="{Binding PopupNavigateCommand}" CommandParameter="{x:Static const:Constants.SettingAboutPage}" Content="{Binding [About], Source={StaticResource L10N}}"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Grid.Column="2" Grid.RowSpan="4">
                <Frame NavigationUIVisibility="Hidden">
                    <b:Interaction.Behaviors>
                        <behaviors:FrameBehavior Parameter="{Binding PopupNavigationParameter, Mode=TwoWay}" Navigation="{Binding PopupNavigationSource, Mode=TwoWay}" />
                    </b:Interaction.Behaviors>
                </Frame>
            </StackPanel>

            <Separator Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Background="{DynamicResource GrayscaleGray5Brush}" Height="1"/>

            <StackPanel Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left">
                <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [Close], Source={StaticResource L10N}}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
