<UserControl x:Class="RaywattApp.Views.Dialog.FileFolderActionDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Views.Dialog"
             mc:Ignorable="d" 
             Width="300" Height="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Background="Black" Orientation="Horizontal">
            <Label Content="{Binding Title}" Foreground="White"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="Black" BorderThickness="1" Margin="10">
                <StackPanel>
                    <Label Content="{Binding [Current Folder], Source={StaticResource L10N}}"/>
                    <Label Content="{Binding SelectedDir.Path}"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1" Margin="10">
                <StackPanel>
                    <Label Content="{Binding [New Folder Name], Source={StaticResource L10N}}"/>
                    <TextBox Text="{Binding CreateRenameFolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5,5,5,5"/>
                    <TextBlock Text="{Binding [Duplicated Folder Name], Source={StaticResource L10N}}" Visibility="{Binding IsErrorMessage}" Foreground="Red" Margin="5,5,5,5"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource ButtonBasic}" Command="{Binding NoCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [Cancel], Source={StaticResource L10N}}" Width="50"/>
            <Button Style="{StaticResource ButtonImportant}" Command="{Binding YesCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [OK], Source={StaticResource L10N}}" IsEnabled="{Binding CreateRenameFolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NotEmptyStringToEnableConverter}}" Width="50"/>
        </StackPanel>
    </Grid>
</UserControl>
