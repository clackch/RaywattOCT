<UserControl x:Class="RaywattApp.Views.Dialog.UpdateSelectionDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Views.Dialog"
             xmlns:const="clr-namespace:RaywattApp.Common.Bases"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d" 
             Width="{Binding DialogWidth}" Height="{Binding DialogHeight}">

    <Border CornerRadius="10"
            Background="{DynamicResource GrayscaleGray6Brush}"
            BorderBrush="{DynamicResource GrayscaleGray7Brush}"
            Width="{x:Static const:Constants.UpdateSelectionDialogWidth}"
            Height="{x:Static const:Constants.UpdateSelectionDialogHeight}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="78"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Style="{DynamicResource Pretendard-Bold-32}" Content="{Binding Title}" Foreground="{DynamicResource GrayscaleWhiteBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Content -->
            <StackPanel Grid.Row="2" Margin="32,20,32,32">
                <!-- USB Drive Selection -->
                <StackPanel Margin="0,0,0,20">
                    <Label Style="{DynamicResource Pretendard-Medium-16}" Content="{Binding [Select Drive], Source={StaticResource L10N}}" Foreground="{DynamicResource GrayscaleGray3Brush}" Margin="0,0,0,8"/>
                    <ComboBox Style="{DynamicResource ComboBoxDialog}" Width="408" ItemsSource="{Binding ExternalDriveComboBox}" SelectedValue="{Binding SelectedExternalDrive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
					          SelectedValuePath="Key" DisplayMemberPath="Value" IsEnabled="{Binding IsEnableExternalDrive}" Tag="{Binding [No Drive], Source={StaticResource L10N}}" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Available Update Versions -->
                <Grid Visibility="{Binding HasAvailableUpdates, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid ItemsSource="{Binding UpdateItems}" SelectedItem="{Binding SelectedUpdate}" Style="{StaticResource DataGridDialog}" RowStyle="{StaticResource DataGridRowDialog}" ColumnHeaderStyle="{StaticResource DataGridColumnHeaderDialog}"
                                AutoGenerateColumns="False" SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" Height="335">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Binding="{Binding Version}" Header="Version" CellStyle="{StaticResource DataGridCellTooltip}"/>
                            <DataGridTextColumn Width="*" Binding="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Header="Last Modified" CellStyle="{StaticResource DataGridCellTooltip}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                
                <!-- No Updates Available Message -->
                <StackPanel Visibility="{Binding HasAvailableUpdates, Converter={StaticResource BoolToVisibilityReverseConverter}}" HorizontalAlignment="Center" Width="600">
                    <Label Style="{DynamicResource Pretendard-Medium-16}" Content="{Binding StatusMessage}" Foreground="{DynamicResource GrayscaleGray3Brush}" HorizontalAlignment="Center" Margin="120"/>
                </StackPanel>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding NoCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
				        Content="{Binding [Cancel], Source={StaticResource L10N}}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Command="{Binding YesCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
				        Content="{Binding [Update], Source={StaticResource L10N}}" IsEnabled="{Binding CanUpdate}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>