<UserControl x:Class="RaywattApp.Views.Dialog.SoftwareUpdateDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Views.Dialog"
             xmlns:const="clr-namespace:RaywattApp.Common.Bases"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d" 
             Width="{Binding DialogWidth}" Height="{Binding DialogHeight}">

    <Border CornerRadius="10"
            Background="{DynamicResource GrayscaleGray6Brush}"
            BorderBrush="{DynamicResource GrayscaleGray7Brush}"
            Width="{x:Static const:Constants.SoftwareUpdateDialogWidth}"
            Height="{x:Static const:Constants.SoftwareUpdateDialogHeight}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="21"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
                <Label Style="{DynamicResource Pretendard-Medium-22}" 
				       Content="{Binding Title}" 
				       Foreground="{DynamicResource GrayscaleWhiteBrush}" 
				       HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Content -->
            <StackPanel Grid.Row="2" Margin="20">
                <!-- Current Version Info -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                    <Label Style="{DynamicResource Pretendard-Medium-16}" 
					       Content="Current Version: " 
					       Foreground="{DynamicResource GrayscaleGray3Brush}"/>
                    <Label Style="{DynamicResource Pretendard-Medium-16}" 
					       Content="{Binding CurrentVersion}" 
					       Foreground="{DynamicResource GrayscaleWhiteBrush}"/>
                </StackPanel>

                <!-- Available Firmware Versions -->
                <Grid Visibility="{Binding HasAvailableUpdates, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Grid.Row="1" 
                            CornerRadius="5" 
                            BorderBrush="{DynamicResource GrayscaleGray7Brush}" 
                            BorderThickness="1"
                            MinHeight="300"
                            MaxHeight="300">
                        <DataGrid ItemsSource="{Binding FirmwareUpdateItems}" 
                                  SelectedItem="{Binding SelectedFirmware}"
                                  Style="{StaticResource DataGridDialog}" 
                                  RowStyle="{StaticResource DataGridRowDialog}" 
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderDialog}"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Binding="{Binding Version}" Header="Version" CellStyle="{StaticResource DataGridCellTooltip}"/>
                                <DataGridTextColumn Width="*" Binding="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Header="Last Modified" CellStyle="{StaticResource DataGridCellTooltip}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
                
                <!-- No Updates Available Message -->
                <StackPanel Visibility="{Binding HasAvailableUpdates, Converter={StaticResource BoolToVisibilityReverseConverter}}" 
				            HorizontalAlignment="Center" >
                    <Label Style="{DynamicResource Pretendard-Medium-16}" 
					       Content="{Binding StatusMessage}" 
					       Foreground="{DynamicResource GrayscaleGray3Brush}" 
					       HorizontalAlignment="Center" Margin="120"/>
                </StackPanel>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource OutlinedBtnType3-Large}"
				        Command="{Binding NoCommand}"
				        CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
				        Content="{Binding [Cancel], Source={StaticResource L10N}}"
				        Margin="0,0,10,0"/>
                <Button Style="{StaticResource ContainedBtnType1-Large-Wide}"
				        Command="{Binding YesCommand}"
				        CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
				        Content="{Binding [Update], Source={StaticResource L10N}}"
				        IsEnabled="{Binding CanUpdate}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>