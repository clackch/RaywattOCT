<UserControl x:Class="RaywattApp.Views.Dialog.SoftwareUpdateDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Views.Dialog"
             xmlns:const="clr-namespace:RaywattApp.Common.Bases"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d" 
             Width="{Binding DialogWidth}" Height="{Binding DialogHeight}">

	<Border CornerRadius="10"
            Background="{DynamicResource GrayscaleGray6Brush}"
            BorderBrush="{DynamicResource GrayscaleGray7Brush}"
            Width="{x:Static const:Constants.SoftwareUpdateDialogWidth}"
            Height="{x:Static const:Constants.SoftwareUpdateDialogHeight}" >
		
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="21"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="10"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="70"/>
			</Grid.RowDefinitions>

			<!-- Title -->
			<StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10">
				<Label Style="{DynamicResource Pretendard-Medium-16}" Content="{Binding Title}" Foreground="{DynamicResource GrayscaleGray3Brush}" HorizontalAlignment="Center"/>
			</StackPanel>

			<!-- Content -->
			<StackPanel Grid.Row="3" Margin="20">
				<!-- Status Message -->
				<StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
					<Label Style="{DynamicResource Pretendard-Medium-14}" Content="{Binding StatusMessage}" Foreground="{DynamicResource GrayscaleWhiteBrush}" HorizontalAlignment="Center"/>
				</StackPanel>

				<!-- Files List -->
				<Grid Visibility="{Binding HasUsbFiles, Converter={StaticResource BoolToVisibilityConverter}}">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<Label Grid.Row="0" Style="{DynamicResource Pretendard-Medium-12}" Content="발견된 파일:" Foreground="{DynamicResource GrayscaleGray3Brush}" Margin="0,0,0,10"/>

                    <Border Grid.Row="1" CornerRadius="5" MaxHeight="250">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox ItemsSource="{Binding UpdateItems}" Background="Transparent" BorderThickness="0" SelectionMode="Single" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding Name}"
                                                       Foreground="{DynamicResource GrayscaleWhiteBrush}"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding LastModified}"
                                                       Foreground="{DynamicResource GrayscaleGray3Brush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>
                </Grid>

				<!-- No USB Message -->
				<StackPanel Visibility="{Binding HasUsbFiles, Converter={StaticResource BoolToVisibilityReverseConverter}}" HorizontalAlignment="Center">
					<Image Source="{svgc:SvgImage Source=/res/icon/alertError.svg}" Width="60" Height="60" Margin="0,20,0,20"/>
				</StackPanel>
			</StackPanel>

			<!-- Buttons -->
			<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
				<Button Style="{StaticResource OutlinedBtnType3-Large}"
                        Command="{Binding NoCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
                        Content="{Binding [Cancel], Source={StaticResource L10N}}"
                        Margin="0,0,10,0"/>
				<Button Style="{StaticResource ContainedBtnType1-Large-Wide}"
                        Command="{Binding YesCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
                        Content="{Binding [Software Update], Source={StaticResource L10N}}"
                        IsEnabled="{Binding HasUsbFiles}"/>
			</StackPanel>
		</Grid>
	</Border>
</UserControl>