<UserControl x:Class="RaywattApp.Views.Dialog.MwlSearchDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:const="clr-namespace:RaywattApp.Common.Bases"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:RaywattApp.Common.Behaviors"
             xmlns:component="clr-namespace:RaywattApp.Views.Component"
             xmlns:local="clr-namespace:RaywattApp.Views.Dialog"
             mc:Ignorable="d" 
             Width="{Binding DialogWidth}" Height="{Binding DialogHeight}">

    <Border CornerRadius="10" Background="{DynamicResource GrayscaleGray6Brush}" Width="{x:Static const:Constants.MwlSearchDialogWidth}" Height="{x:Static const:Constants.MwlSearchDialogHeight}">
        <Grid IsEnabled="{Binding IsChecking, Converter={StaticResource BoolToEnableReverseConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="153"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="454"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="74"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="50 0 50 0">
                <StackPanel Orientation="Vertical">
                    <Label Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [DICOM Worklist (MWL)], Source={StaticResource L10N}}" Margin="0,60,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Server], Source={StaticResource L10N}}" />
                        <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding DicomServer.AeTitle}" Margin="25,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Separator Grid.Row="1" Background="{DynamicResource GrayscaleGray5Brush}" Height="1" Margin="50 0 50 0"/>

            <Grid Grid.Row="2" Margin="50 0 50 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="49"/>
                    <RowDefinition Height="74"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="68"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="84"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Patient Name], Source={StaticResource L10N}}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{DynamicResource TextBoxBase}" Text="{Binding PatientName}" Tag="{Binding [Enter Patient Name], Source={StaticResource L10N}}" VerticalAlignment="Top" Width="422" Height="54"/>

                <Label Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Requested Procedure ID], Source={StaticResource L10N}}" VerticalAlignment="Bottom" Margin="16,0,0,6"/>
                <TextBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Style="{DynamicResource TextBoxBase}" Text="{Binding ProcedureId}" Tag="{Binding [Enter Procedure ID], Source={StaticResource L10N}}" VerticalAlignment="Top" Width="422" Height="54" Margin="16,0,0,0"/>

                <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Patient ID], Source={StaticResource L10N}}"/>
                <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{DynamicResource TextBoxBase}" Text="{Binding PatientId}" Tag="{Binding [Enter Patient ID], Source={StaticResource L10N}}" VerticalAlignment="Top" Width="422" Height="54"/>

                <Label Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Accession Number], Source={StaticResource L10N}}" Margin="16,0,0,0"/>
                <TextBox Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Style="{DynamicResource TextBoxBase}" Text="{Binding AccessionNumber}" Tag="{Binding [Enter Accession Number], Source={StaticResource L10N}}" VerticalAlignment="Top" Width="422" Height="54" Margin="16,0,0,0"/>

                <Label Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Scheduled Station AE], Source={StaticResource L10N}}"/>
                <TextBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Style="{DynamicResource TextBoxBase}" Text="{Binding ScheduledStationAe}" Tag="{Binding [Enter Station AE], Source={StaticResource L10N}}" Width="422" Height="54" VerticalAlignment="Top"/>

                <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4" Content="{Binding [Scheduled Procedure Step Start Date], Source={StaticResource L10N}}" IsChecked="{Binding UseSpsStartDate}"  Margin="0,-5,0,0" VerticalAlignment="Top"/>

                <Label Grid.Row="7" Grid.Column="0"  Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [From], Source={StaticResource L10N}}" Margin="0,18,0,0"/>
                <DatePicker Grid.Row="7" Grid.Column="1" Style="{DynamicResource DatePickerStyle}" behaviors:DatePickerPopupOffsetBehavior.AutoVerticalOffset="True" Tag="{Binding [Enter Birth Date], Source={StaticResource L10N}}" SelectedDate="{Binding SpsStartDateFrom}" IsEnabled="{Binding UseSpsStartDate}" Width="360" Height="54" VerticalAlignment="Top"/>

                <Label Grid.Row="7" Grid.Column="2"  Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [To], Source={StaticResource L10N}}" Margin="30,18,0,0"/>
                <DatePicker Grid.Row="7" Grid.Column="3" Style="{DynamicResource DatePickerStyle}" behaviors:DatePickerPopupOffsetBehavior.AutoVerticalOffset="True" Tag="{Binding [Enter Birth Date], Source={StaticResource L10N}}" SelectedDate="{Binding SpsStartDateTo}" IsEnabled="{Binding UseSpsStartDate}" Width="360" Height="54" VerticalAlignment="Top"/>
            </Grid>

            <Separator Grid.Row="3" Background="{DynamicResource GrayscaleGray5Brush}" Height="1"/>

            <Grid Grid.Row="5" Margin="21,0,16,0">
                <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding NoCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [Cancel], Source={StaticResource L10N}}" HorizontalAlignment="Left"/>
                <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Command="{Binding YesCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [Next], Source={StaticResource L10N}}" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
