                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="238"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="{Binding [Total Angle], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Semibold-28}" Foreground="{DynamicResource ValueInfoLabelBrush}" HorizontalAlignment="Left"/>
                                <StackPanel Height="10"/>
                                <StackPanel Height="88" Orientation="Horizontal">
                                    <TextBlock Text="{Binding TotalAngle}" Style="{DynamicResource TextBlock_Pretendard-Bold-64}" Foreground="{DynamicResource SubPointColor1Brush}"/>
                                    <Label Content="{Binding [º], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Bold-64}" Foreground="{DynamicResource SubPointColor1Brush}"/>
                                </StackPanel>
                            </StackPanel>
