<UserControl x:Class="RaywattApp.Views.Dialog.FileExportDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Views.Dialog"
             xmlns:const="clr-namespace:RaywattApp.Common.Bases"
             xmlns:annotation="clr-namespace:RaywattApp.Common.Annotation"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d" 
             x:Name="ReviewExport"
             Background="{DynamicResource GrayscaleBlackBrush}"
             Height="1080" d:DesignWidth="1920">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- Image -->
        <Grid Grid.Column="0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <!-- Angio -->
                <Grid Width="{x:Static const:Constants.ExportAngioSize}" Height="{x:Static const:Constants.ExportAngioSize}" Visibility="{Binding FileExport.AngioView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Image Source="/res/png/angioImage.png" Stretch="Fill"/>
                </Grid>
                <!-- Cross-Section -->
                <Grid Width="{Binding CrossSectionPartWidth}">
                    <Grid Width="{Binding CrossSectionSize}" Height="{Binding CrossSectionSize}">
                        <Grid Width="{Binding CrossSectionImageSize}" Height="{Binding CrossSectionImageSize}">
                            <!-- Cross Seciton Image -->
                            <Image x:Name="crossSectionImage" Source="{Binding CrossSectionImage}" Width="{Binding CrossSectionImageSize}" Height="{Binding CrossSectionImageSize}"/>
                            <!-- Cross Section Info. -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                                <Label Content="F : " Style="{DynamicResource Pretendard-Medium-20}" Foreground="{DynamicResource SideMenuTitleBrush}"/>
                                <Label Content="{Binding DisplayFrameNumber}" Style="{DynamicResource Pretendard-Medium-20}" Foreground="{DynamicResource SideMenuTitleBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                <Separator Width="{Binding CrossSectionScale}" Height="1"/>
                                <StackPanel Height="4"/>
                                <Label Content="1 mm" Style="{DynamicResource Pretendard-Medium-20}" Foreground="{DynamicResource SideMenuTitleBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- Lumen Contour-->
                            <annotation:DrawLumenContourUtil LumenContours="{Binding LumenContours}" CurrentLumenContour="{Binding CurrentLumenContour, Mode=TwoWay}"  FrameNumber="{Binding MeasureAutoFrameNumber}" IsEditOn="False" IsDrawOn="{Binding FileExport.MeasureAuto}" Zoom="{Binding Zoom}"/>
                            <!-- Measurement -->
                            <annotation:DrawUtil Measurements="{Binding Measurements}" FrameNumber="{Binding MeasureManualFrameNumber}" Zoom="{Binding Zoom}" IsEditOn="False" IsDrawOn="{Binding FileExport.MeasureManual}"/>
                        </Grid>
                        <!-- Indicator -->
                        <Image Source="{svgc:SvgImage Source=/res/indicator/crossSectionExport.svg}" Width="619" Height="16" Visibility="{Binding FileExport.Longitude, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Image.RenderTransform>
                                <RotateTransform CenterX="309.5" CenterY="8" Angle="{Binding Degree}"/>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </Grid>
            </StackPanel>
            <!-- Longitude -->
            <Grid Grid.Row="1" Width="{x:Static const:Constants.ExportLongitudeWidth}" Height="{x:Static const:Constants.ExportLongitudeHeight}" Background="{DynamicResource GrayscaleGray8Brush}" Visibility="{Binding FileExport.Longitude, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="77"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="55"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Label Content="P" Style="{DynamicResource Pretendard-Semibold-32}" HorizontalAlignment="Center" Foreground="{DynamicResource GrayscaleGray3Brush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,75">
                    <Image Width="12" Height="139" Source="{svgc:SvgImage Source=/res/icon/indicatorExport.svg}" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center">
                    <Label Content="D" Style="{DynamicResource Pretendard-Semibold-32}" HorizontalAlignment="Center" Foreground="{DynamicResource GrayscaleGray3Brush}"/>
                </StackPanel>

                <Grid Grid.Column="1" Width="{x:Static const:Constants.ExportLongitudeImageWidth}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="280"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="47"/>
                    </Grid.RowDefinitions>

                    <!-- Longitude Image -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <!-- Lumen Profile -->
                        <Grid Grid.Row="0" Width="{x:Static const:Constants.ExportLongitudeImageWidth}" Height="{x:Static const:Constants.ExportLongitudeImageHeight}">
                            <Image Source="{Binding LumenProfileImage}" Stretch="Fill">
                                <Image.Clip>
                                    <RectangleGeometry RadiusX="8" RadiusY="8">
                                        <RectangleGeometry.Rect>
                                            <Rect X="0" Y="0" Width="{x:Static const:Constants.ExportLongitudeImageWidth}" Height="160"/>
                                        </RectangleGeometry.Rect>
                                    </RectangleGeometry>
                                </Image.Clip>
                            </Image>
                        </Grid>
                        <!-- L-Mode -->
                        <Grid Grid.Row="1" Width="{x:Static const:Constants.ExportLongitudeImageWidth}" Height="{x:Static const:Constants.ExportLongitudeImageHeight}">
                            <Image Source="{Binding LongitudeImage}" Stretch="Fill"/>
                            <!-- Measurement -->
                            <annotation:DrawLmodeUtil Zoom="{Binding LongitudeZoom}" LModeLengthGeometries="{Binding LModeLengthGeometries}" LModeTextGeometries="{Binding LModeTextGeometries}" InCommand="{Binding MeasurementCommand}" Width="{x:Static const:Constants.LongitudeWidth}" Height="{x:Static const:Constants.LongitudeHeight}" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        </Grid>
                        <!-- L-Mode Indicator -->
                        <Canvas>
                            <Image Source="{svgc:SvgImage Source=/res/indicator/longitudeExport.svg}" Width="12" Height="286.5" Stretch="None" Canvas.Left="{Binding IndicatorLongitude.X}" Margin="0,-6,0,0"/>
                        </Canvas>
                    </Grid>
                    <!-- Bookmark Scale -->
                    <ContentControl Grid.Row="2" Template="{DynamicResource LongitudeScaleBarExport}" Width="{x:Static const:Constants.ExportLongitudeImageWidth}" Tag="{Binding PatientCase.PullbackType}"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Text -->
        <Grid Grid.Column="1" Height="1080" Background="{DynamicResource GrayscaleGray7Brush}">
            <StackPanel Width="{Binding TextPartWidth}" VerticalAlignment="Center">
                <Grid Margin="30" Visibility="{Binding FileExport.MeasureAuto, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="320"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="225"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <Label Content="{Binding [Lumen], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Bold-38}" Foreground="{DynamicResource ValueInfoLabelBrush}" HorizontalAlignment="Left"/>
                        <StackPanel Height="20"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="238"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="{Binding [Diameter], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Semibold-28}" Foreground="{DynamicResource ValueInfoLabelBrush}" HorizontalAlignment="Left"/>
                                <StackPanel Height="10"/>
                                <StackPanel Height="88" Orientation="Horizontal">
                                    <TextBlock Text="{Binding CurrentLumenContour.MeanDiameter, StringFormat={}{0:N2}, Converter={StaticResource UnitConverter}, ConverterParameter={x:Static const:Constants.ScaleLength}}" Style="{DynamicResource TextBlock_Pretendard-Bold-74}" Foreground="{DynamicResource ValueInfoValueBrush}" MinWidth="160"/>
                                    <Label Content="{Binding [mm], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Medium-28}" Foreground="{DynamicResource ValueInfoLabelBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                                </StackPanel>
                                <StackPanel Height="4"/>
                                <StackPanel Height="29" Orientation="Horizontal">
                                    <Label Content="{Binding [Min], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Bold-24}" Foreground="{DynamicResource ValueInfoLabelBrush}" MinWidth="73"/>
                                    <TextBlock Text="{Binding CurrentLumenContour.MinDiameter.value, StringFormat={}{0:N2}, Converter={StaticResource UnitConverter}, ConverterParameter={x:Static const:Constants.ScaleLength}}" Style="{DynamicResource TextBlock_Pretendard-Bold-24}" Foreground="{DynamicResource ValueInfoValueBrush}" MinWidth="80"/>
                                    <Label Content="{Binding [mm], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Medium-24}" Foreground="{DynamicResource ValueInfoLabelBrush}"/>
                                </StackPanel>
                                <StackPanel Height="2"/>
                                <StackPanel Height="29" Orientation="Horizontal">
                                    <Label Content="{Binding [Max], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Bold-24}" Foreground="{DynamicResource ValueInfoLabelBrush}" MinWidth="73"/>
                                    <TextBlock Text="{Binding CurrentLumenContour.MaxDiameter.value, StringFormat={}{0:N2}, Converter={StaticResource UnitConverter}, ConverterParameter={x:Static const:Constants.ScaleLength}}" Style="{DynamicResource TextBlock_Pretendard-Bold-24}" Foreground="{DynamicResource ValueInfoValueBrush}" MinWidth="80"/>
                                    <Label Content="{Binding [mm], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Medium-24}" Foreground="{DynamicResource ValueInfoLabelBrush}"/>
                                </StackPanel>
                                <StackPanel Height="2"/>
                                <StackPanel Height="29" Orientation="Horizontal">
                                    <Label Content="{Binding [%DS], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Bold-24}" Foreground="{DynamicResource ValueInfoLabelBrush}" MinWidth="73"/>
                                    <TextBlock Text="00.0" Style="{DynamicResource TextBlock_Pretendard-Bold-24}" Foreground="{DynamicResource ValueInfoValueBrush}" MinWidth="80"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="{Binding [Area], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Semibold-28}" Foreground="{DynamicResource ValueInfoLabelBrush}" HorizontalAlignment="Left"/>
                                <StackPanel Height="10"/>
                                <StackPanel Height="88" Orientation="Horizontal">
                                    <TextBlock Text="{Binding CurrentLumenContour.Area, StringFormat={}{0:N2}, Converter={StaticResource UnitConverter}, ConverterParameter={x:Static const:Constants.ScaleArea}}" Style="{DynamicResource TextBlock_Pretendard-Bold-74}" Foreground="{DynamicResource ValueInfoValueBrush}" MinWidth="160"/>
                                    <Label Content="{Binding [㎟], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Medium-28}" Foreground="{DynamicResource ValueInfoLabelBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                                </StackPanel>
                                <StackPanel Height="4"/>
                                <StackPanel Height="29" Orientation="Horizontal">
                                    <Label Content="{Binding [%AS], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Bold-24}" Foreground="{DynamicResource ValueInfoLabelBrush}" MinWidth="73"/>
                                    <TextBlock Text="00.0" Style="{DynamicResource TextBlock_Pretendard-Bold-24}" Foreground="{DynamicResource ValueInfoValueBrush}" MinWidth="80"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <Separator Grid.Row="1" Background="{DynamicResource SeparatorBrush}"/>
                    <StackPanel Grid.Row="2">
                        <StackPanel Height="28"/>
                        <Label Content="{Binding [Calcium], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Bold-38}" Foreground="{DynamicResource ValueInfoLabelBrush}" HorizontalAlignment="Left"/>
                        <StackPanel Height="20"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="238"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="{Binding [Total Angle], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Semibold-28}" Foreground="{DynamicResource ValueInfoLabelBrush}" HorizontalAlignment="Left"/>
                                <StackPanel Height="10"/>
                                <StackPanel Height="88" Orientation="Horizontal">
                                    <TextBlock Text="200" Style="{DynamicResource TextBlock_Pretendard-Bold-74}" Foreground="{DynamicResource ValueInfoValueBrush}"/>
                                    <Label Content="{Binding [º], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Bold-74}" Foreground="{DynamicResource ValueInfoValueBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="{Binding [Max Thickness], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Semibold-28}" Foreground="{DynamicResource ValueInfoLabelBrush}" HorizontalAlignment="Left"/>
                                <StackPanel Height="10"/>
                                <StackPanel Height="88" Orientation="Horizontal">
                                    <TextBlock Text="0.00" Style="{DynamicResource TextBlock_Pretendard-Bold-74}" Foreground="{DynamicResource ValueInfoValueBrush}" MinWidth="160"/>
                                    <Label Content="{Binding [mm], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Medium-28}" Foreground="{DynamicResource ValueInfoLabelBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
                <Separator Width="506" Background="{DynamicResource SeparatorBrush}" Visibility="{Binding MeasureSeparator}"/>
                <StackPanel Margin="30" Visibility="{Binding FileExport.MeasureManual, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Label Content="{Binding [Area], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Semibold-28}" Foreground="{DynamicResource ValueInfoLabelBrush}" HorizontalAlignment="Left"/>
                    <StackPanel Height="11"/>
                    <DataGrid ItemsSource="{Binding CurrAreaGeometries}" Height="327" Style="{StaticResource DataGridMeasurementExport}" RowStyle="{StaticResource DataGridRowMeasurementExport}" ColumnHeaderStyle="{StaticResource DataGridColumnHeaderMeasurementAreaExport}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="60" CellStyle="{StaticResource DataGridCellTooltip}" Binding="{Binding Group, Converter={StaticResource GroupNameConverter}}" Header="{Binding [No.], Source={StaticResource L10N}}"/>
                            <DataGridTextColumn Width="110" CellStyle="{StaticResource DataGridCellTooltip}" Binding="{Binding Area, StringFormat={}{0:N2}, Converter={StaticResource UnitConverter}, ConverterParameter={x:Static const:Constants.ScaleArea}}" Header="{Binding [Area(㎟)], Source={StaticResource L10N}}"/>
                            <DataGridTextColumn Width="110" CellStyle="{StaticResource DataGridCellTooltip}" Binding="{Binding MeanDiameter, StringFormat={}{0:N2}, Converter={StaticResource UnitConverter}, ConverterParameter={x:Static const:Constants.ScaleLength}}" Header="{Binding [Mean Diam.(㎜)], Source={StaticResource L10N}}"/>
                            <DataGridTextColumn Width="110" CellStyle="{StaticResource DataGridCellTooltip}" Binding="{Binding MinDiameter.value, StringFormat={}{0:N2}, Converter={StaticResource UnitConverter}, ConverterParameter={x:Static const:Constants.ScaleLength}}" Header="{Binding [Min Diam.(㎜)], Source={StaticResource L10N}}"/>
                            <DataGridTextColumn Width="110" CellStyle="{StaticResource DataGridCellTooltip}" Binding="{Binding MaxDiameter.value, StringFormat={}{0:N2}, Converter={StaticResource UnitConverter}, ConverterParameter={x:Static const:Constants.ScaleLength}}" Header="{Binding [Max Diam.(㎜)], Source={StaticResource L10N}}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
