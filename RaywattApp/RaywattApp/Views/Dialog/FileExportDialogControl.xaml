<UserControl x:Class="RaywattApp.Views.Dialog.FileExportDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Views.Dialog"
             xmlns:const="clr-namespace:RaywattApp.Common.Bases"
             xmlns:annotation="clr-namespace:RaywattApp.Common.Annotation"
             xmlns:component="clr-namespace:RaywattApp.Views.Component"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d" 
             x:Name="ReviewExport"
             Background="{DynamicResource GrayscaleBlackBrush}"
             Height="1080" d:DesignWidth="1920">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- Image -->
        <Grid Grid.Column="0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Width="{Binding ImagePartWidth}" Height="{Binding ImagePartHeight}">
                <!-- Angio -->
                <Grid Visibility="{Binding FileExport.AngioView, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Left">
                    <Image x:Name="angioImage" Source="{Binding AngioImage}" Width="{Binding CrossSectionImageSize}"/>
                </Grid>
                <!-- Cross-Section -->
                <Grid Width="{Binding CrossSectionPartWidth}" HorizontalAlignment="Right">
                    <Grid Width="{Binding CrossSectionSize}" Height="{Binding CrossSectionSize}">
                        <Grid Width="{Binding CrossSectionImageSize}" Height="{Binding CrossSectionImageSize}">
                            <Grid Width="{Binding CrossSectionImageSize}" Height="{Binding CrossSectionImageSize}">
                                <Grid.Clip>
                                    <EllipseGeometry Center="{Binding CrossSectionClipCenter}" RadiusX="{Binding CrossSectionClipRadius}" RadiusY="{Binding CrossSectionClipRadius}"/>
                                </Grid.Clip>
                                <Grid>
                                    <Grid>
                                        <!-- Cross Seciton Image -->
                                        <Image x:Name="crossSectionImage" Source="{Binding CrossSectionImage}" Width="{Binding CrossSectionImageSize}" Height="{Binding CrossSectionImageSize}"/>
                                        <!-- Sheath Indicator -->
                                        <Image x:Name="SheathIndicator" Source="{Binding SheathIndicator}" Width="{Binding CrossSectionImageSize}" Height="{Binding CrossSectionImageSize}"/>
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform>
                                                    <ScaleTransform.ScaleX>
                                                        <MultiBinding Converter="{StaticResource CrossSectionScaleMultiConverter}">
                                                            <Binding Path="Zoom.ScaleX"/>
                                                            <Binding Path="CrossSectionImageSize"/>
                                                        </MultiBinding>
                                                    </ScaleTransform.ScaleX>
                                                    <ScaleTransform.ScaleY>
                                                        <MultiBinding Converter="{StaticResource CrossSectionScaleMultiConverter}">
                                                            <Binding Path="Zoom.ScaleY"/>
                                                            <Binding Path="CrossSectionImageSize"/>
                                                        </MultiBinding>
                                                    </ScaleTransform.ScaleY>
                                                </ScaleTransform>
                                                <TranslateTransform>
                                                    <TranslateTransform.X>
                                                        <MultiBinding Converter="{StaticResource CrossSectionScaleMultiConverter}">
                                                            <Binding Path="Zoom.TranslateX"/>
                                                            <Binding Path="CrossSectionImageSize"/>
                                                        </MultiBinding>
                                                    </TranslateTransform.X>
                                                    <TranslateTransform.Y>
                                                        <MultiBinding Converter="{StaticResource CrossSectionScaleMultiConverter}">
                                                            <Binding Path="Zoom.TranslateY"/>
                                                            <Binding Path="CrossSectionImageSize"/>
                                                        </MultiBinding>
                                                    </TranslateTransform.Y>
                                                </TranslateTransform>
                                            </TransformGroup>
                                        </Grid.RenderTransform>
                                    </Grid>
                                    <!-- Lumen Contour-->
                                    <annotation:DrawLumenContourUtil LumenContours="{Binding LumenContours}" CurrentLumenContour="{Binding CurrentLumenContour, Mode=TwoWay}" LumenStents="{Binding LumenStents}" LumenSidebranches="{Binding LumenSidebranches}" IsDrawLumenSideBranch="{Binding IsDrawLumenSideBranch}" AppositionThreshold="{Binding PatientCase.AppositionThreshold}"  FrameNumber="{Binding MeasureAutoFrameNumber}" IsEditOn="False" IsDrawOn="{Binding FileExport.MeasureAuto}" Zoom="{Binding Zoom}" ScreenSize="{Binding CrossSectionImageSize}"/>
                                    <!-- Measurement -->
                                    <annotation:DrawUtil Measurements="{Binding Measurements}" FrameNumber="{Binding MeasureManualFrameNumber}" Zoom="{Binding Zoom}" IsEditOn="False" IsDrawOn="{Binding FileExport.MeasureManual}" ScreenSize="{Binding CrossSectionImageSize}"/>
                                </Grid>

                            </Grid>
                            <!-- Cross Section Info. -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                                <Label Content="F" Style="{DynamicResource Pretendard-ExtraBold-20}" Foreground="{DynamicResource GrayscaleGray3Brush}"/>
                                <StackPanel Width="6"/>
                                <Label Content="{Binding DisplayFrameNumber}" Style="{DynamicResource Pretendard-Medium-20}" Foreground="{DynamicResource GrayscaleGray3Brush}" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                <Label Content="1 ㎜" Style="{DynamicResource Pretendard-Medium-20}" Foreground="{DynamicResource SideMenuTitleBrush}" HorizontalAlignment="Center"/>
                                <StackPanel Height="4"/>
                                <Grid>
                                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Height="5" Width="1" Margin="0" HorizontalAlignment="Left">
                                        <Separator.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform>
                                                    <TranslateTransform.X>
                                                        <MultiBinding Converter="{StaticResource ScaleBarScaleMultiConverter}">
                                                            <Binding Path="Zoom.ScaleX"/>
                                                            <Binding Path="CrossSectionImageSize"/>
                                                        </MultiBinding>
                                                    </TranslateTransform.X>
                                                </TranslateTransform>
                                            </TransformGroup>
                                        </Separator.RenderTransform>
                                    </Separator>
                                    <Separator Width="{Binding CrossSectionScale}" Height="1" Margin="0">
                                        <Separator.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform>
                                                    <ScaleTransform.ScaleX>
                                                        <MultiBinding Converter="{StaticResource CrossSectionScaleMultiConverter}">
                                                            <Binding Path="Zoom.ScaleX"/>
                                                            <Binding Path="CrossSectionImageSize"/>
                                                        </MultiBinding>
                                                    </ScaleTransform.ScaleX>
                                                </ScaleTransform>
                                                <TranslateTransform>
                                                    <TranslateTransform.X>
                                                        <MultiBinding Converter="{StaticResource ScaleBarScaleMultiConverter}">
                                                            <Binding Path="Zoom.ScaleX"/>
                                                            <Binding Path="CrossSectionImageSize"/>
                                                        </MultiBinding>
                                                    </TranslateTransform.X>
                                                </TranslateTransform>
                                            </TransformGroup>
                                        </Separator.RenderTransform>
                                    </Separator>
                                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Height="5" Width="1" Margin="0" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <!-- Calcium Indicator -->
                        <Grid Visibility="{Binding PatientCase.Procedure, Converter={StaticResource ProcedureVisibilityConverter}, ConverterParameter=$001}">
                            <Image x:Name="CalciumIndicatorAngio" Width="{Binding CalciumIndicatorSize}" Height="{Binding CalciumIndicatorSize}" Source="{Binding CalciumIndicator}"/>
                            <!--<Grid Width="{Binding CalciumThicknessIndicatorSize}" Height="{Binding CalciumThicknessIndicatorSize}" Background="Transparent" Visibility="{Binding MaxCalciumDegree, Converter={StaticResource MaxThicknessVisibilityConverter}}">
                                <Grid.Clip>
                                    <EllipseGeometry Center="{Binding CalciumThicknessIndicatorPointCenter}" RadiusX="{Binding CalciumThicknessIndicatorCenter}" RadiusY="{Binding CalciumThicknessIndicatorCenter}"/>
                                </Grid.Clip>
                                <Image Width="8" Height="10" Source="{svgc:SvgImage Source=/res/icon/thicknessIndicator.svg}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <Grid.RenderTransform>
                                    <RotateTransform CenterX="{Binding CalciumThicknessIndicatorCenter}" CenterY="{Binding CalciumThicknessIndicatorCenter}" Angle="{Binding MaxCalciumDegree}"/>
                                </Grid.RenderTransform>
                            </Grid>-->
                        </Grid>
                        <!-- Indicator -->
                        <Image Source="{svgc:SvgImage Source=/res/indicator/crossSectionExport.svg}" Width="619" Height="16" Visibility="{Binding FileExport.Longitude, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Image.RenderTransform>
                                <RotateTransform CenterX="309.5" CenterY="8" Angle="{Binding Degree}"/>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>

                    <Label  Content="{Binding CrossSectionlabel}"
                            FontSize="30"
                            FontWeight="Bold"
                            Foreground="{StaticResource CaseInfoSecondBrush}"
                            HorizontalAlignment="left"
                            VerticalAlignment="Top"
                            Margin="20"
                            IsHitTestVisible="False"/>
                    
                </Grid>
            </Grid>
            <!-- Longitude -->
            <Grid Grid.Row="1" Width="{x:Static const:Constants.ExportLongitudeWidth}" Height="{x:Static const:Constants.ExportLongitudeHeight}" Background="{DynamicResource GrayscaleGray8Brush}" Visibility="{Binding FileExport.Longitude, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="77"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="55"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Label Content="{Binding DistalOrientationLabel}" Style="{DynamicResource Pretendard-Semibold-32}" HorizontalAlignment="Center" Foreground="{DynamicResource GrayscaleGray3Brush}"/>

                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,75">
                    <Image Width="12" Height="139" Source="{svgc:SvgImage Source=/res/icon/indicatorExport.svg}" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center">
                    <Label Content="{Binding ProximalOrientationLabel}" Style="{DynamicResource Pretendard-Semibold-32}" HorizontalAlignment="Center" Foreground="{DynamicResource GrayscaleGray3Brush}"/>
                </StackPanel>
                <Grid Grid.Column="1" Width="{x:Static const:Constants.ExportLongitudeImageWidth}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="280"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="47"/>
                    </Grid.RowDefinitions>

                    <!-- Calcium/Expansion/Apposition -->
                    <StackPanel Grid.Row="0" Margin="0,2,-67,0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding PatientCase.Procedure, Converter={StaticResource ProcedureVisibilityConverter}, ConverterParameter=$001}">
                            <Border CornerRadius="4" Background="{StaticResource GrayscaleGray7Brush}">
                                <StackPanel Orientation="Horizontal" Margin="2,1,2,1">
                                    <Image Source="{svgc:SvgImage Source=/res/icon/calciumIcon.svg}" Width="14" Height="14"/>
                                    <StackPanel Width="6"/>
                                    <Label Style="{DynamicResource Pretendard-Medium-12}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Calcium], Source={StaticResource L10N}}"/>
                                    <StackPanel Width="4"/>
                                    <Label Style="{DynamicResource Pretendard-Medium-12}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [≥], Source={StaticResource L10N}}"/>
                                    <StackPanel Width="4"/>
                                    <Label Style="{DynamicResource Pretendard-Medium-12}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding PatientCase.CalciumThreshold}"/>
                                    <Label Style="{DynamicResource Pretendard-Medium-12}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [º], Source={StaticResource L10N}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding PatientCase.Procedure, Converter={StaticResource ProcedureVisibilityConverter}, ConverterParameter=$002|$003}">
                            <Border CornerRadius="4" Background="{StaticResource GrayscaleGray7Brush}">
                                <StackPanel Orientation="Horizontal" Margin="2,1,2,1">
                                    <Image Source="{svgc:SvgImage Source=/res/icon/expansionIcon.svg}" Width="14" Height="14"/>
                                    <StackPanel Width="6"/>
                                    <Label Style="{DynamicResource Pretendard-Medium-12}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Expansion], Source={StaticResource L10N}}"/>
                                    <StackPanel Width="4"/>
                                    <Label Style="{DynamicResource Pretendard-Medium-12}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [≤], Source={StaticResource L10N}}"/>
                                    <StackPanel Width="4"/>
                                    <Label Style="{DynamicResource Pretendard-Medium-12}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding PatientCase.ExpansionThreshold}"/>
                                    <Label Style="{DynamicResource Pretendard-Medium-12}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [%], Source={StaticResource L10N}}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Width="6"/>
                            <Border CornerRadius="4" Background="{StaticResource GrayscaleGray7Brush}">
                                <StackPanel Orientation="Horizontal" Margin="2,1,2,1">
                                    <Image Source="{svgc:SvgImage Source=/res/icon/appositionIcon.svg}" Width="14" Height="14"/>
                                    <StackPanel Width="6"/>
                                    <Label Style="{DynamicResource Pretendard-Medium-12}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Apposition], Source={StaticResource L10N}}"/>
                                    <StackPanel Width="4"/>
                                    <Label Style="{DynamicResource Pretendard-Medium-12}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [≥], Source={StaticResource L10N}}"/>
                                    <StackPanel Width="4"/>
                                    <Label Style="{DynamicResource Pretendard-Medium-12}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding PatientCase.AppositionThreshold}"/>
                                    <Label Style="{DynamicResource Pretendard-Medium-12}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [㎜], Source={StaticResource L10N}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Longitude Image -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <!-- Lumen Profile -->
                        <Grid Grid.Row="0" Width="{x:Static const:Constants.ExportLongitudeImageWidth}" Height="{x:Static const:Constants.ExportLongitudeImageHeight}">
                            <Image Source="{Binding LumenProfileImage}" Stretch="Fill">
                                <Image.Clip>
                                    <RectangleGeometry RadiusX="8" RadiusY="8">
                                        <RectangleGeometry.Rect>
                                            <Rect X="0" Y="0" Width="{x:Static const:Constants.ExportLongitudeImageWidth}" Height="160"/>
                                        </RectangleGeometry.Rect>
                                    </RectangleGeometry>
                                </Image.Clip>
                            </Image>
                        </Grid>
                        <!-- L-Mode -->
                        <Grid Grid.Row="1" Width="{x:Static const:Constants.ExportLongitudeImageWidth}" Height="{x:Static const:Constants.ExportLongitudeImageHeight}">
                            <Grid.Clip>
                                <RectangleGeometry RadiusX="0" RadiusY="0">
                                    <RectangleGeometry.Rect>
                                        <Rect X="0" Y="0" Width="{x:Static const:Constants.ExportLongitudeImageWidth}" Height="{x:Static const:Constants.ExportLongitudeImageHeight}"/>
                                    </RectangleGeometry.Rect>
                                </RectangleGeometry>
                            </Grid.Clip>
                            <Image Source="{Binding LongitudeImage}" Stretch="Fill">
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleY="{Binding PatientCase.FieldOfView, Converter={StaticResource LongitudeScaleConverter}}"/>
                                        <TranslateTransform Y="{Binding PatientCase.FieldOfView, Converter={StaticResource LongitudeTranslateConverter}, ConverterParameter={x:Static const:Constants.ExportLongitudeImageHeight}}"/>
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                            <!-- Measurement -->
                            <annotation:DrawLmodeUtil Zoom="{Binding LongitudeZoom}" LModeLengthGeometries="{Binding LModeLengthGeometries}" LModeTextGeometries="{Binding LModeTextGeometries}" PullbackLength="{Binding PatientCase.PullbackLength}" InCommand="{Binding MeasurementCommand}" Width="{x:Static const:Constants.LongitudeWidth}" Height="{x:Static const:Constants.LongitudeHeight}" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        </Grid>
                        <!-- L-Mode Indicator -->
                        <Canvas>
                            <!-- Section MLA -->
                            <Image Style="{DynamicResource SectionExportLeftRight}" Canvas.Left="{Binding Section.Mla.X}" Visibility="{Binding Section.Mla.IsVisible}" Tag="{Binding Section.Mla.StrValue}"/>
                            <Border Margin="0,-27,0,9" Canvas.Left="{Binding Section.MlaValue.X}" Visibility="{Binding Section.MlaValue.IsVisible}" CornerRadius="4" BorderBrush="{StaticResource GrayscaleGray2Brush}" BorderThickness="0.5">
                                <StackPanel Orientation="Horizontal" Margin="9,0,9,0" VerticalAlignment="Center">
                                    <Label Style="{DynamicResource Pretendard-Semibold-12}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [MLA], Source={StaticResource L10N}}"/>
                                    <StackPanel Width="2"/>
                                    <TextBlock Style="{DynamicResource TextBlock_Pretendard-Semibold-12}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Text="{Binding Section.MlaValue.DValue, StringFormat={}{0:N2}, Converter={StaticResource UnitConverter}, ConverterParameter={x:Static const:Constants.ScaleArea}}"/>
                                    <Label Style="{DynamicResource Pretendard-Semibold-12}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [㎟], Source={StaticResource L10N}}"/>
                                </StackPanel>
                            </Border>
                            <!-- Section MLD -->
                            <Image Style="{DynamicResource SectionExportLeftRight}" Canvas.Left="{Binding Section.Mld.X}" Visibility="{Binding Section.Mld.IsVisible}" Tag="{Binding Section.Mld.StrValue}"/>
                            <Border Margin="0,-27,0,9" Canvas.Left="{Binding Section.MldValue.X}" Visibility="{Binding Section.MldValue.IsVisible}" CornerRadius="4" BorderBrush="{StaticResource GrayscaleGray2Brush}" BorderThickness="0.5">
                                <StackPanel Orientation="Horizontal" Margin="9,0,9,0" VerticalAlignment="Center">
                                    <Label Style="{DynamicResource Pretendard-Semibold-12}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [MLD], Source={StaticResource L10N}}"/>
                                    <StackPanel Width="2"/>
                                    <TextBlock Style="{DynamicResource TextBlock_Pretendard-Semibold-12}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Text="{Binding Section.MldValue.DValue, StringFormat={}{0:N2}, Converter={StaticResource UnitConverter}, ConverterParameter={x:Static const:Constants.ScaleLength}}"/>
                                    <Label Style="{DynamicResource Pretendard-Semibold-12}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [㎜], Source={StaticResource L10N}}"/>
                                </StackPanel>
                            </Border>
                            <!-- Section MSA -->
                            <Image Style="{DynamicResource SectionExportLeftRight}" Canvas.Left="{Binding Section.Msa.X}" Visibility="{Binding Section.Msa.IsVisible}" Tag="{Binding Section.Msa.StrValue}"/>
                            <Border Margin="0,-27,0,9" Canvas.Left="{Binding Section.MsaValue.X}" Visibility="{Binding Section.MsaValue.IsVisible}" CornerRadius="4" BorderBrush="{StaticResource GrayscaleGray2Brush}" BorderThickness="0.5">
                                <StackPanel Orientation="Horizontal" Margin="9,0,9,0" VerticalAlignment="Center">
                                    <Label Style="{DynamicResource Pretendard-Semibold-12}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [MSA], Source={StaticResource L10N}}"/>
                                    <StackPanel Width="2"/>
                                    <TextBlock Style="{DynamicResource TextBlock_Pretendard-Semibold-12}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Text="{Binding Section.MsaValue.DValue, StringFormat={}{0:N2}, Converter={StaticResource UnitConverter}, ConverterParameter={x:Static const:Constants.ScaleArea}}"/>
                                    <Label Style="{DynamicResource Pretendard-Semibold-12}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [㎟], Source={StaticResource L10N}}"/>
                                </StackPanel>
                            </Border>
                            <!-- Section Min Exp -->
                            <Image Style="{DynamicResource SectionExportLeftRight}" Canvas.Left="{Binding Section.MinExp.X}" Visibility="{Binding Section.MinExp.IsVisible}" Tag="{Binding Section.MinExp.StrValue}"/>
                            <Border Margin="0,-27,0,9" Canvas.Left="{Binding Section.MinExpValue.X}" Visibility="{Binding Section.MinExpValue.IsVisible}" CornerRadius="4" BorderBrush="{StaticResource GrayscaleGray2Brush}" BorderThickness="0.5">
                                <StackPanel Orientation="Horizontal" Margin="9,0,9,0" VerticalAlignment="Center">
                                    <Label Style="{DynamicResource Pretendard-Semibold-12}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Min Exp.], Source={StaticResource L10N}}"/>
                                    <StackPanel Width="2"/>
                                    <component:PercentValueComponent Style="{DynamicResource TextBlock_Pretendard-Semibold-12}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Value="{Binding Section.MinExpValue.DValue}" Overall="{Binding Section.RefArea}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource ExpansionConverter}">
                                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="Value"/>
                                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="Overall"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </component:PercentValueComponent>
                                    <Label Style="{DynamicResource Pretendard-Semibold-12}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [%], Source={StaticResource L10N}}"/>
                                </StackPanel>
                            </Border>
                            <!-- Section Lesion Length -->
                            <Line Canvas.Left="{Binding Section.LesionProximal}" HorizontalAlignment="Stretch" Stroke="{StaticResource GrayscaleGray2Brush}" StrokeDashArray="2 3" StrokeThickness="1" X1="{Binding Section.LesionLengthWidth}" Margin="0,135,0,0"/>
                            <Line Canvas.Left="{Binding Section.LesionDistal}" HorizontalAlignment="Stretch" Stroke="{StaticResource GrayscaleGray2Brush}" StrokeDashArray="2 3" StrokeThickness="1" X1="{Binding Section.LesionLengthWidth}" Margin="0,135,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,128,0,0" Canvas.Left="{Binding Section.LesionLength.X}" Visibility="{Binding Section.LesionLength.IsVisible}">
                                <TextBlock Style="{DynamicResource TextBlock_Pretendard-Semibold-10}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Text="{Binding Section.LesionLength.DValue, StringFormat={}{0:N1}}"/>
                                <StackPanel Width="1"/>
                                <Label Style="{DynamicResource Pretendard-Medium-10}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [㎜], Source={StaticResource L10N}}"/>
                            </StackPanel>
                            <!-- Section Proximal -->
                            <Image Height="140" Source="{svgc:SvgImage Source=/res/indicator/sectionProximalExport.svg}" Canvas.Left="{Binding Section.Proximal.X}" Visibility="{Binding Section.Proximal.IsVisible}"/>
                            <!-- Section Distal -->
                            <Image Height="140" Source="{svgc:SvgImage Source=/res/indicator/sectionDistalExport.svg}" Canvas.Left="{Binding Section.Distal.X}" Visibility="{Binding Section.Distal.IsVisible}"/>
                            <Image Source="{svgc:SvgImage Source=/res/indicator/longitudeExport.svg}" Width="12" Height="286.5" Stretch="None" Canvas.Left="{Binding IndicatorLongitude.X}" Margin="0,-6,0,0"/>
                        </Canvas>
                    </Grid>
                    <!-- Bookmark Scale -->
                    <ContentControl Grid.Row="2" Template="{DynamicResource LongitudeScaleBarExport}" Width="{x:Static const:Constants.ExportLongitudeImageWidth}" Tag="{Binding PatientCase.PullbackLength}"/>

                    <!-- Lumen Profile Extra : Expansion -->
                    <Image Grid.Row="3" VerticalAlignment="Top" Margin="0,13,0,0" Source="{Binding LumenProfileImageExtra}" Width="{x:Static const:Constants.ExportLongitudeImageWidth}" Height="{x:Static const:Constants.LumenProfileExtraCompareHeight}" Stretch="Fill"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Text -->
        <Grid Grid.Column="1" Height="1080" Background="{DynamicResource GrayscaleGray7Brush}">
            <StackPanel Width="{Binding TextPartWidth}" VerticalAlignment="Center">
                <Grid Margin="30" Visibility="{Binding FileExport.MeasureAuto, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="320"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="225"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <Label Content="{Binding [Lumen], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Bold-38}" Foreground="{DynamicResource ValueInfoLabelBrush}" HorizontalAlignment="Left"/>
                        <StackPanel Height="20"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="238"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="{Binding [Diameter], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Semibold-28}" Foreground="{DynamicResource ValueInfoLabelBrush}" HorizontalAlignment="Left"/>
                                <StackPanel Height="10"/>
                                <StackPanel Height="88" Orientation="Horizontal">
                                    <TextBlock Text="{Binding CurrentLumenContour.MeanDiameter, StringFormat={}{0:N2}, Converter={StaticResource UnitConverter}, ConverterParameter={x:Static const:Constants.ScaleLength}}" Style="{DynamicResource TextBlock_Pretendard-Bold-74}" Foreground="{DynamicResource ValueInfoValueBrush}" MinWidth="160"/>
                                    <Label Content="{Binding [㎜], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Medium-28}" Foreground="{DynamicResource ValueInfoLabelBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                                </StackPanel>
                                <StackPanel Height="4"/>
                                <StackPanel Height="29" Orientation="Horizontal">
                                    <Label Content="{Binding [Min], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Bold-24}" Foreground="{DynamicResource ValueInfoLabelBrush}" MinWidth="73"/>
                                    <TextBlock Text="{Binding CurrentLumenContour.MinDiameter.value, StringFormat={}{0:N2}, Converter={StaticResource UnitConverter}, ConverterParameter={x:Static const:Constants.ScaleLength}}" Style="{DynamicResource TextBlock_Pretendard-Bold-24}" Foreground="{DynamicResource ValueInfoValueBrush}" MinWidth="80"/>
                                    <Label Content="{Binding [㎜], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Medium-24}" Foreground="{DynamicResource ValueInfoLabelBrush}"/>
                                </StackPanel>
                                <StackPanel Height="2"/>
                                <StackPanel Height="29" Orientation="Horizontal">
                                    <Label Content="{Binding [Max], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Bold-24}" Foreground="{DynamicResource ValueInfoLabelBrush}" MinWidth="73"/>
                                    <TextBlock Text="{Binding CurrentLumenContour.MaxDiameter.value, StringFormat={}{0:N2}, Converter={StaticResource UnitConverter}, ConverterParameter={x:Static const:Constants.ScaleLength}}" Style="{DynamicResource TextBlock_Pretendard-Bold-24}" Foreground="{DynamicResource ValueInfoValueBrush}" MinWidth="80"/>
                                    <Label Content="{Binding [㎜], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Medium-24}" Foreground="{DynamicResource ValueInfoLabelBrush}"/>
                                </StackPanel>
                                <StackPanel Height="2"/>
                                <StackPanel Height="29" Orientation="Horizontal">
                                    <Label Content="{Binding [%DS], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Bold-24}" Foreground="{DynamicResource ValueInfoLabelBrush}" MinWidth="73"/>
                                    <component:PercentValueComponent Style="{DynamicResource TextBlock_Pretendard-Bold-24}" Foreground="{DynamicResource ValueInfoValueBrush}" MinWidth="80" Value="{Binding CurrentLumenContour.MeanDiameter}" Overall="{Binding Section.MeanDiameter}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource AsDsConverter}">
                                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="Value"/>
                                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="Overall"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </component:PercentValueComponent>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="{Binding [Area], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Semibold-28}" Foreground="{DynamicResource ValueInfoLabelBrush}" HorizontalAlignment="Left"/>
                                <StackPanel Height="10"/>
                                <StackPanel Height="88" Orientation="Horizontal">
                                    <TextBlock Text="{Binding CurrentLumenContour.Area, StringFormat={}{0:N2}, Converter={StaticResource UnitConverter}, ConverterParameter={x:Static const:Constants.ScaleArea}}" Style="{DynamicResource TextBlock_Pretendard-Bold-74}" Foreground="{DynamicResource ValueInfoValueBrush}" MinWidth="160"/>
                                    <Label Content="{Binding [㎟], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Medium-28}" Foreground="{DynamicResource ValueInfoLabelBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                                </StackPanel>
                                <StackPanel Height="4"/>
                                <StackPanel Height="29" Orientation="Horizontal">
                                    <Label Content="{Binding [%AS], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Bold-24}" Foreground="{DynamicResource ValueInfoLabelBrush}" MinWidth="73"/>
                                    <component:PercentValueComponent Style="{DynamicResource TextBlock_Pretendard-Bold-24}" Foreground="{DynamicResource ValueInfoValueBrush}" MinWidth="80" Value="{Binding CurrentLumenContour.Area}" Overall="{Binding Section.MeanArea}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource AsDsConverter}">
                                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="Value"/>
                                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="Overall"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </component:PercentValueComponent>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <Separator Grid.Row="1" Background="{DynamicResource SeparatorBrush}"/>
                    <StackPanel Grid.Row="2" Visibility="{Binding PatientCase.Procedure, Converter={StaticResource ProcedureVisibilityConverter}, ConverterParameter=$001}">
