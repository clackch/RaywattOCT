                                <Label Content="{Binding [Max Thickness], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Semibold-28}" Foreground="{DynamicResource ValueInfoLabelBrush}" HorizontalAlignment="Left"/>
                                <StackPanel Height="10"/>
                                <StackPanel Height="88" Orientation="Horizontal">
                                    <TextBlock Text="{Binding MaxThickness}" Style="{DynamicResource TextBlock_Pretendard-Bold-64}" Foreground="{DynamicResource ValueInfoValueBrush}" MinWidth="140"/>
                                    <Label Content="{Binding [㎜], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Medium-28}" Foreground="{DynamicResource ValueInfoLabelBrush}" VerticalAlignment="Bottom" Margin="0,0,0,20"/>
                                </StackPanel>
                            </StackPanel>-->
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Visibility="{Binding PatientCase.Procedure, Converter={StaticResource ProcedureVisibilityConverter}, ConverterParameter=$002|$003}">
                        <StackPanel Height="28"/>
                        <Label Content="{Binding [Stent], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Bold-38}" Foreground="{DynamicResource ValueInfoLabelBrush}" HorizontalAlignment="Left"/>
                        <StackPanel Height="20"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="238"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="{Binding [Expansion], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Semibold-28}" Foreground="{DynamicResource ValueInfoLabelBrush}" HorizontalAlignment="Left"/>
                                <StackPanel Height="10"/>
                                <StackPanel Height="88" Orientation="Horizontal">
                                    <component:PercentValueComponent Style="{DynamicResource TextBlock_Pretendard-Bold-64}" Foreground="{DynamicResource SubPointColor2Brush}" Value="{Binding CurrentLumenContour.Area}" Overall="{Binding Section.RefArea}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource ExpansionConverter}">
                                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="Value"/>
                                                <Binding RelativeSource="{RelativeSource Mode=Self}" Path="Overall"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </component:PercentValueComponent>
                                    <Label Content="{Binding [%], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Bold-64}" Foreground="{DynamicResource SubPointColor2Brush}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="{Binding [Reference Lumen], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-Semibold-28}" Foreground="{DynamicResource ValueInfoLabelBrush}" HorizontalAlignment="Left"/>
