<UserControl x:Class="RaywattApp.Views.Dialog.FilePasswordDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:w="clr-namespace:RaywattApp.Common.Util" 
             xmlns:local="clr-namespace:RaywattApp.Views.Dialog"
             mc:Ignorable="d" 
             Width="300" Height="200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Background="Black" Orientation="Horizontal">
            <Label Content="{Binding [Password Protected], Source={StaticResource L10N}}" Foreground="White"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <CheckBox Grid.Row="0" Grid.ColumnSpan="2" IsChecked="{Binding FileExport.PasswordProtected}" Content="{Binding [Password Protected], Source={StaticResource L10N}}" VerticalAlignment="Center" Margin="5,0,0,0"/>
            <TextBlock Grid.Row="1" Text="{Binding [Password], Source={StaticResource L10N}}" Margin="5,5,5,5"/>
            <PasswordBox  Grid.Row="1" Grid.Column="1" w:PasswordHelper.Attach="True" w:PasswordHelper.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding FileExport.PasswordProtected}" Margin="5,5,5,5"/>
            <TextBlock Grid.Row="2" Text="{Binding [Confirm Password], Source={StaticResource L10N}}" Margin="5,5,5,5"/>
            <PasswordBox  Grid.Row="2" Grid.Column="1" w:PasswordHelper.Attach="True" w:PasswordHelper.Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding FileExport.PasswordProtected}" Margin="5,5,5,5"/>
            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding [Input Password], Source={StaticResource L10N}}" Visibility="{Binding IsInfoMessage}" Foreground="Red" Margin="5,5,5,5"/>
            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding [The password you entered is not valid], Source={StaticResource L10N}}" Visibility="{Binding IsErrorMessage}" Foreground="Red" Margin="5,5,5,5"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Command="{Binding NoCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [Cancel], Source={StaticResource L10N}}" Grid.Row="1" Width="50" Margin="5"/>
            <Button Command="{Binding YesCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [OK], Source={StaticResource L10N}}" Grid.Row="1" Width="50" Margin="5" Background="Black" Foreground="White"/>
        </StackPanel>
    </Grid>
</UserControl>
