<UserControl x:Class="RaywattApp.Views.Dialog.SettingEditPhysicianDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Views.Dialog"
             xmlns:const="clr-namespace:RaywattApp.Common.Bases"
             mc:Ignorable="d" 
             Width="{Binding DialogWidth}" Height="{Binding DialogHeight}">

    <Border CornerRadius="10" Background="{DynamicResource GrayscaleGray6Brush}" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray7Brush}" Width="{x:Static const:Constants.SettingEditPhysicianDialogWidth}" Height="{x:Static const:Constants.SettingEditPhysicianDialogHeight}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="31"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="31"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="58"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="82"/>
                <RowDefinition Height="78"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center">
                <Label Style="{DynamicResource Pretendard-Bold-32}" Content="{Binding [Edit Physician], Source={StaticResource L10N}}" Foreground="{DynamicResource GrayscaleWhiteBrush}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1">
                <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Name], Source={StaticResource L10N}}"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="1">
                <TextBox Style="{DynamicResource TextBoxValidator}" Text="{Binding Physician.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [Enter Physician Name], Source={StaticResource L10N}}" ToolTip="{Binding Physician.ValidateName}"/>
            </StackPanel>
            
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding NoCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [No], Source={StaticResource L10N}}"/>
                <StackPanel Width="8"/>
                <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Command="{Binding YesCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [Yes], Source={StaticResource L10N}}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
