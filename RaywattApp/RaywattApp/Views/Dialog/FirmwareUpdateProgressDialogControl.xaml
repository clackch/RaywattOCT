<UserControl x:Class="RaywattApp.Views.Dialog.FirmwareUpdateProgressDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Views.Dialog"
             xmlns:const="clr-namespace:RaywattApp.Common.Bases"
             mc:Ignorable="d" 
             Width="{Binding DialogWidth}" Height="{Binding DialogHeight}">

    <Border CornerRadius="10"
            Background="{DynamicResource GrayscaleGray6Brush}"
            BorderBrush="{DynamicResource GrayscaleGray7Brush}"
            Width="460"
            Height="244">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="66"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,10,0,0">
                <Label Style="{DynamicResource Pretendard-Medium-12}" Content="{Binding Title}" Foreground="{DynamicResource GrayscaleGray3Brush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Status Message -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                <Label Style="{DynamicResource Pretendard-Medium-22}" Foreground="{DynamicResource GrayscaleWhiteBrush}" HorizontalContentAlignment="Center" Width="338">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center"/>
                </Label>
            </StackPanel>

            <!-- Progress Bar -->
            <StackPanel Grid.Row="4" VerticalAlignment="Center">
                <ProgressBar Value="{Binding Progress}" Width="412" Height="24"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Button Style="{StaticResource ContainedBtnType1-Large-Short}" Command="{Binding CancelCommand}" Content="{Binding [Cancel], Source={StaticResource L10N}}" Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Style="{StaticResource ContainedBtnType1-Large-Short}" Command="{Binding OKCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Content="{Binding [Done], Source={StaticResource L10N}}" Visibility="{Binding ShowCloseButton, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
