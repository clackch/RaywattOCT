<UserControl x:Class="RaywattApp.Views.Dialog.FirmwareUpdateProgressDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Views.Dialog"
             xmlns:const="clr-namespace:RaywattApp.Common.Bases"
             mc:Ignorable="d" 
             Width="{Binding DialogWidth}" Height="{Binding DialogHeight}">

    <Border CornerRadius="10"
            Background="{DynamicResource GrayscaleGray6Brush}"
            BorderBrush="{DynamicResource GrayscaleGray7Brush}"
            Width="600"
            Height="300">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="21"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
                <Label Style="{DynamicResource Pretendard-Medium-22}" 
                       Content="{Binding Title}" 
                       Foreground="{DynamicResource GrayscaleWhiteBrush}" 
                       HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Content -->
            <StackPanel Grid.Row="2" Margin="40,20" VerticalAlignment="Center">
                <!-- Status Message -->
                <Label Style="{DynamicResource Pretendard-Medium-16}" 
                       Content="{Binding StatusMessage}" 
                       Foreground="{DynamicResource GrayscaleWhiteBrush}" 
                       HorizontalContentAlignment="Center"
                       Margin="0,0,0,20"/>

                <!-- Progress Bar -->
                <ProgressBar Value="{Binding Progress}" 
                            Minimum="0" 
                            Maximum="100" 
                            Height="30"
                            Margin="0,0,0,10"/>

                <!-- Progress Percentage -->
                <Label Style="{DynamicResource Pretendard-Medium-14}" 
                       Foreground="{DynamicResource GrayscaleGray3Brush}" 
                       HorizontalContentAlignment="Center"
                       Margin="0,0,0,0">
                    <Label.Content>
                        <TextBlock>
                            <Run Text="{Binding Progress, Mode=OneWay}"/>
                            <Run Text="%"/>
                        </TextBlock>
                    </Label.Content>
                </Label>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Cancel Button (visible during download) -->
                <Button Style="{StaticResource OutlinedBtnType3-Large}"
                        Command="{Binding CancelCommand}"
                        Content="{Binding [Cancel], Source={StaticResource L10N}}"
                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Close Button (visible after completion) -->
                <Button Style="{StaticResource ContainedBtnType1-Large-Wide}"
                        Command="{Binding NoCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
                        Content="{Binding [Close], Source={StaticResource L10N}}"
                        Visibility="{Binding ShowCloseButton, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
