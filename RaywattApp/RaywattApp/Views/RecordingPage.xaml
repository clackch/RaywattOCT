<Page x:Class="RaywattApp.Views.RecordingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RaywattApp.Views"
      xmlns:const="clr-namespace:RaywattApp.Common.Bases"
      xmlns:System="clr-namespace:System;assembly=mscorlib"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      mc:Ignorable="d" 
      d:DesignHeight="1024" d:DesignWidth="1280"
      Background="{DynamicResource GrayscaleGray8Brush}"
      Title="RecordingPage">
    <Page.Resources>
        <System:Boolean x:Key="TrueValue">True</System:Boolean>
        <System:Boolean x:Key="FalseValue">False</System:Boolean>
        <System:Double x:Key="CrossSectionSize">474</System:Double>
    </Page.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="60" Background="{DynamicResource GrayscaleGray7Brush}">
            <Label Style="{DynamicResource Pretendard-Medium-18}" Foreground="{DynamicResource GrayscaleGray3Brush}" Margin="75,20,0,19" Content="{Binding [New Recording], Source={StaticResource L10N}}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="160,62,160,62">
            <Grid.RowDefinitions>
                <RowDefinition Height="725"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="74"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" CornerRadius="10,10,0,0" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray7Brush}" Background="{DynamicResource GrayscaleGray6Brush}">
                <Grid Margin="49,35,49,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="115"/>
                        <RowDefinition Height="474"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="162,0,162,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <Image Source="{svgc:SvgImage Source=/res/icon/recordingStep1.svg}" Width="47.8" Height="37"/>
                            <Image Source="{svgc:SvgImage Source=/res/icon/recordingStep1_active.svg}" Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Image Source="{svgc:SvgImage Source=/res/icon/recordingBar.svg}" Width="138" Height="3"/>
                        </StackPanel>
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Image Source="{svgc:SvgImage Source=/res/icon/recordingStep2.svg}" Width="30.9" Height="36"/>
                            <Image Source="{svgc:SvgImage Source=/res/icon/recordingStep2_active.svg}" Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                        </Grid>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <Image Source="{svgc:SvgImage Source=/res/icon/recordingBar.svg}" Width="138" Height="3"/>
                        </StackPanel>
                        <Grid Grid.Column="4" VerticalAlignment="Center">
                            <Image Source="{svgc:SvgImage Source=/res/icon/recordingStep3.svg}" Width="32" Height="32"/>
                            <Image Source="{svgc:SvgImage Source=/res/icon/recordingStep3_active.svg}" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Label Style="{DynamicResource Pretendard-Bold-24}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Verify guide catheter is positioned for adequate flush], Source={StaticResource L10N}}"/>
                        <Label Style="{DynamicResource Pretendard-Bold-24}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Prepare for pullback], Source={StaticResource L10N}}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                        <Label Style="{DynamicResource Pretendard-Bold-24}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Inject flush media within], Source={StaticResource L10N}}"/>
                        <StackPanel Width="10"/>
                        <Label Style="{DynamicResource Pretendard-Bold-24}" Foreground="{DynamicResource MainPrimaryColorBrush}" Content="{Binding StartTime}"/>
                        <StackPanel Width="10"/>
                        <Label Style="{DynamicResource Pretendard-Bold-24}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [seconds], Source={StaticResource L10N}}"/>
                    </StackPanel>
                    <Border Grid.Row="2" CornerRadius="10" Background="{DynamicResource AdditionalColor5Brush}">
                        <Image x:Name="crossSectionImage" Source="{Binding CrossSectionImage}" Width="{StaticResource CrossSectionSize}" Height="{StaticResource CrossSectionSize}" Stretch="Fill"/>
                    </Border>
                </Grid>
            </Border>
            <Separator Grid.Row="1" Foreground="{DynamicResource GrayscaleGray5Brush}"/>
            <Border Grid.Row="2" CornerRadius="0,0,10,10" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray7Brush}" Background="{DynamicResource GrayscaleGray6Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Left" Margin="16,16,0,0">
                        <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding CancelCommand}" Content="{Binding [Cancel], Source={StaticResource L10N}}"/>
                    </StackPanel>
                    <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0">
                        <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Command="{Binding ReadyCommand}" Content="{Binding [Ready], Source={StaticResource L10N}}" Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Command="{Binding StartCommand}" Content="{Binding [Start], Source={StaticResource L10N}}" Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Height="40" Background="{DynamicResource GrayscaleBlackBrush}"/>
    </Grid>
</Page>
