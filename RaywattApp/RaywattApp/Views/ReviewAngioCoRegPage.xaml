<Page x:Class="RaywattApp.Views.ReviewAngioCoRegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:const="clr-namespace:RaywattApp.Common.Bases"
      xmlns:CoRegistration="clr-namespace:RaywattApp.Common.Angio.CoRegRelatedFiles"
      xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
      mc:Ignorable="d" 
      d:DesignHeight="1024" d:DesignWidth="1280"
      Background="{DynamicResource GrayscaleGray8Brush}"
      Title="ReviewAngioCoRegPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="60" Background="{DynamicResource GrayscaleGray7Brush}">
            <Label Style="{DynamicResource Pretendard-Medium-18}" Foreground="{DynamicResource GrayscaleGray3Brush}" Margin="75,20,0,19" Content="{Binding [Review], Source={StaticResource L10N}}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="60,40,60,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="769"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="74"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" CornerRadius="10,10,0,0" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray7Brush}" Background="{DynamicResource GrayscaleGray7Brush}">
                <Grid Margin="49,54,49,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="636"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Label Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Co-Registration], Source={StaticResource L10N}}"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="580"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="448"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="580"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="46"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.Clip>
                                    <RectangleGeometry RadiusX="10" RadiusY="10">
                                        <RectangleGeometry.Rect>
                                            <Rect X="0" Y="0" Width="{x:Static const:Constants.AngioSize}" Height="{x:Static const:Constants.AngioSize}"/>
                                        </RectangleGeometry.Rect>
                                    </RectangleGeometry>
                                </Grid.Clip>
                                <Image x:Name="crossSectionAngioImage" Source="{Binding CurrentAngioImage}"  Width="{x:Static const:Constants.AngioSize}" Height="{x:Static const:Constants.AngioSize}" Stretch="Uniform"></Image>
                                <CoRegistration:DrawAngioPathUtil Grid.Column="0" Width="{Binding ElementName=crossSectionAngioImage, Path=ActualWidth}" Height ="{Binding ElementName=crossSectionAngioImage, Path=ActualHeight}"
                            						      DijkstraHeap="{Binding DijkstraHeap}" AngioImages ="{Binding CrossSectionAngioImages}" AngioFrameNumber ="{Binding AngioFrameNumber}" 
                                                          MousePosition ="{Binding CrossSectionMousePosition, Mode=TwoWay}" AngioTrackPoints ="{Binding AngioTrackPoints, Mode=TwoWay}"
                                                          IsAngioTrackCompleted ="{Binding IsAngioTrackCompleted, Mode=TwoWay}" IsReset ="{Binding IsReset, Mode=TwoWay}"
                                                          IsResetOn ="{Binding IsResetOn, Mode=TwoWay}" IsRendering ="{Binding IsRendering, Mode=TwoWay}"
                                                          IsOk ="{Binding IsOk}" IsEditOn = "True"/>
                                <Border>
                                    <!-- Loading -->
                                    <ContentControl Template="{DynamicResource Loading}" Visibility="{Binding IsRendering, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Border>
                            </Grid>
                            <Border Grid.Row="2" CornerRadius="8" Background="{DynamicResource GrayscaleGray6Brush}" HorizontalAlignment="Left" Width="580">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="480"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Height="16" Content="{Binding [F], Source={StaticResource L10N}}" Style="{DynamicResource Pretendard-ExtraBold-14}" Foreground="{DynamicResource ValueInfoLabelBrush}" Margin="32,0,0,0"/>
                                    <Label Grid.Column="1" Height="16" Content="{Binding AngioDisplayNumber}" Style="{DynamicResource Pretendard-Medium-14}" Foreground="{DynamicResource ValueInfoLabelBrush}" Margin="10,0"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="5,0,0,0">
                                        <Slider Minimum="0" Maximum="{Binding AngioFrameLength}" Value="{Binding AngioFrameNumber, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource GrayscaleGray6Brush}">
                            <Grid Margin="30,36,30,0" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="54"/>
                                    <RowDefinition Height="72"/>
                                    <RowDefinition Height="388"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Label Style="{DynamicResource Pretendard-Bold-32}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding [Clarify a lesion], Source={StaticResource L10N}}"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Label Style="{DynamicResource Pretendard-Medium-18}" Foreground="{DynamicResource GrayscaleGray3Brush}">
                                        <Label.Content>
                                            <AccessText TextWrapping="Wrap" Text="{Binding [$MSG010], Source={StaticResource L10N}}"/>
                                        </Label.Content>
                                    </Label>
                                </Grid>
                                <Border Grid.Row="2" BorderBrush="{DynamicResource GrayscaleGray1Brush}" BorderThickness="3" CornerRadius="10">
                                    <Grid Width="{x:Static const:Constants.CoRegZoomAngioSize}" Height="{x:Static const:Constants.CoRegZoomAngioSize}">
                                        <Grid.Clip>
                                            <RectangleGeometry RadiusX="10" RadiusY="10">
                                                <RectangleGeometry.Rect>
                                                    <Rect X="0" Y="0" Width="{x:Static const:Constants.CoRegZoomAngioSize}" Height="{x:Static const:Constants.CoRegZoomAngioSize}"/>
                                                </RectangleGeometry.Rect>
                                            </RectangleGeometry>
                                        </Grid.Clip>
                                        <Image x:Name="zoomSectionAngioImage" Source="{Binding CurrentAngioImage}">
                                            <Image.Clip>
                                                <RectangleGeometry>
                                                    <RectangleGeometry.Rect>
                                                        <Rect X="0" Y="0" Width="{x:Static const:Constants.CoRegZoomAngioSize}" Height="{x:Static const:Constants.CoRegZoomAngioSize}"/>
                                                    </RectangleGeometry.Rect>
                                                </RectangleGeometry>
                                            </Image.Clip>
                                            <Image.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="{x:Static const:Constants.CoRegZoomScale}"
                                                                            ScaleY="{x:Static const:Constants.CoRegZoomScale}"/>
                                                    <TranslateTransform X="{Binding CrossSectionMousePosition, Converter={StaticResource CoRegistrationTranslateConverter}, ConverterParameter=X}"
                                                                                Y="{Binding CrossSectionMousePosition, Converter={StaticResource CoRegistrationTranslateConverter}, ConverterParameter=Y}"/>
                                                </TransformGroup>
                                            </Image.RenderTransform>
                                        </Image>
                                        <Image Source="{svgc:SvgImage Source=/res/icon/angioZoomCenter.svg}" Width="39" Height="39"/>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="4">
                                    <Button HorizontalAlignment="Left" Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding ResetCommand}" Content="{Binding [Reset], Source={StaticResource L10N}}" IsEnabled="{Binding IsResetOn}" Width="200" Height="42"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="580"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </Grid>
            </Border>
            <Separator Grid.Row="1" Background="{DynamicResource GrayscaleGray5Brush}"/>
            <Border Grid.Row="2" CornerRadius="0,0,10,10" BorderBrush="{DynamicResource GrayscaleGray7Brush}" Background="{DynamicResource GrayscaleGray6Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Left" Margin="16,16,0,0">
                        <Grid>
                            <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding CancelCommand}" Content="{Binding [Cancel], Source={StaticResource L10N}}"/>
                        </Grid>
                    </StackPanel>
                    <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0">
                        <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Command="{Binding OkCommand}" Content="{Binding [OK], Source={StaticResource L10N}}"
                                IsEnabled="{Binding IsAngioTrackCompleted}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Height="40" Background="{DynamicResource GrayscaleBlackBrush}"/>
    </Grid>
</Page>
