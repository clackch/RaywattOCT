<UserControl x:Class="RaywattApp.Views.Controls.EditCasePopupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border CornerRadius="5" BorderBrush="Blue" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="5">
                <TextBlock Text="{Binding LayerPopupTitle}" FontSize="25" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"  Text="{Binding [Physician], Source={StaticResource L10N}}" Margin="5,5,5,5"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Width="265" ItemsSource="{Binding PhysicianComboBox}" SelectedValue="{Binding PatientCase.PhysicianName, Mode=TwoWay}" SelectedValuePath="Key" DisplayMemberPath="Value" Margin="5,5,5,5"/>
                <TextBlock Grid.Row="1"  Text="{Binding [Accession Number], Source={StaticResource L10N}}" Margin="5,5,5,5"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PatientCase.AccessionNumber, UpdateSourceTrigger=PropertyChanged}" Margin="5,5,5,5"/>
                <TextBlock Grid.Row="2"  Text="{Binding [Comment], Source={StaticResource L10N}}" Margin="5,5,5,5"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PatientCase.Comment, UpdateSourceTrigger=PropertyChanged}" Margin="5,5,5,5"/>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding PopupResponseCommand}" CommandParameter="N" Content="{Binding [Cancel], Source={StaticResource L10N}}" Grid.Row="1" Width="50" Margin="5"/>
                <Button Command="{Binding PopupResponseCommand}" CommandParameter="Y" Content="{Binding [OK], Source={StaticResource L10N}}" Grid.Row="1" Width="50" Margin="5" Background="Black" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
