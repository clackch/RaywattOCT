<UserControl x:Class="RaywattApp.Views.Controls.FolderBrowserPopupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Views.Controls"
             xmlns:model="clr-namespace:RaywattApp.Common.Util"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:RaywattApp.Common.Behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border CornerRadius="5" BorderBrush="Blue" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="5">
                <TextBlock Text="{Binding LayerPopupTitle}" FontSize="25" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="80" Command="{Binding FolderActionCommand}" CommandParameter="C" Content="{Binding [New Folder], Source={StaticResource L10N}}" IsEnabled="{Binding SelectedDir, Converter={StaticResource NotNullToEnableConverter}}" Margin="5,5,5,5"/>
                <Button Width="80" Command="{Binding FolderActionCommand}" CommandParameter="R" Content="{Binding [Rename], Source={StaticResource L10N}}" IsEnabled="{Binding SelectedDir, Converter={StaticResource NotNullToEnableConverter}}" Margin="5,5,5,5"/>
            </StackPanel>

            <TreeView Grid.Row="2" ItemsSource="{Binding DirItems}" Height="300">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type model:DirectoryItem}" ItemsSource="{Binding Path=Items, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock Text="{Binding Path=Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="2,2,2,2"/>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
                <i:Interaction.Behaviors>
                    <behaviors:BindableSelectedItemBehavior SelectedItem="{Binding SelectedDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </i:Interaction.Behaviors>
            </TreeView>

            <StackPanel Grid.Row="3" Orientation="Horizontal">
                <Label Content="{Binding [Folder], Source={StaticResource L10N}}"/>
                <Label>:</Label>
                <Label Content="{Binding SelectedDir.Path}"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding PopupResponseCommand}" CommandParameter="N" Content="{Binding [Cancel], Source={StaticResource L10N}}" Grid.Row="1" Width="50" Margin="5"/>
                <Button Command="{Binding PopupResponseCommand}" CommandParameter="Y" Content="{Binding [OK], Source={StaticResource L10N}}" Grid.Row="1" Width="50" Margin="5" Background="Black" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
