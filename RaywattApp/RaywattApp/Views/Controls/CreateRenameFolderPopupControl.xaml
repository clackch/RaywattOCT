<UserControl x:Class="RaywattApp.Views.Controls.CreateRenameFolderPopupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border CornerRadius="5" BorderBrush="Blue" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="5">
                <TextBlock Text="{Binding LayerExtraPopupTitle}" FontSize="25" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="Black" BorderThickness="1" Margin="10">
                    <StackPanel>
                        <Label Content="{Binding [Current Folder], Source={StaticResource L10N}}"/>
                        <Label Content="{Binding SelectedDir.Path}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1" Margin="10">
                    <StackPanel>
                        <Label Content="{Binding [New Folder Name], Source={StaticResource L10N}}"/>
                        <TextBox Text="{Binding CreateRenameFolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5,5,5,5"/>
                        <TextBlock Text="{Binding [Duplicated Folder Name], Source={StaticResource L10N}}" Visibility="{Binding IsErrorMessage}" Foreground="Red" Margin="5,5,5,5"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding CreateRenameFolderCommand}" CommandParameter="N" Content="{Binding [Cancel], Source={StaticResource L10N}}" Grid.Row="1" Width="50" Margin="5"/>
                <Button Command="{Binding CreateRenameFolderCommand}" CommandParameter="Y" Content="{Binding [OK], Source={StaticResource L10N}}" IsEnabled="{Binding CreateRenameFolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NotEmptyStringToEnableConverter}}" Grid.Row="1" Width="50" Margin="5" Background="Black" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
