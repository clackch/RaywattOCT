<UserControl x:Class="RaywattApp.Views.Controls.QuestionPopupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border CornerRadius="5" BorderBrush="Blue" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="5">
                <TextBlock Text="{Binding [Information], Source={StaticResource L10N}}" FontSize="25" TextWrapping="Wrap"/>
                <Label Content="{Binding QuestionPopupContent}"></Label>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding PopupResponseCommand}" CommandParameter="N" Content="{Binding [No], Source={StaticResource L10N}}" Grid.Row="1" Width="50" Margin="5"/>
                <Button Command="{Binding PopupResponseCommand}" CommandParameter="Y" Content="{Binding [Yes], Source={StaticResource L10N}}" Grid.Row="1" Width="50" Margin="5" Background="Black" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
