<UserControl x:Class="RaywattApp.Views.Controls.SettingPopupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:RaywattApp.Common.Behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Background="Black" Orientation="Horizontal">
            <Label Content="{Binding [Setting], Source={StaticResource L10N}}" Foreground="White"></Label>
            <Button Content="Message popup Test" Grid.Row="1" HorizontalAlignment="Right" Margin="5" Click="Button_Click"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Button Width="100" Command="{Binding PopupNavigateCommand}" CommandParameter="Views/Setting/SettingAcquisitionPage.xaml" Content="{Binding [Acquisition], Source={StaticResource L10N}}" Margin="5,5,5,5"/>
                <Button Width="100" Command="{Binding PopupNavigateCommand}" CommandParameter="Views/Setting/SettingLocalizationPage.xaml" Content="{Binding [Localization], Source={StaticResource L10N}}" Margin="5,5,5,5"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Height="800">
                <Frame NavigationUIVisibility="Hidden">
                    <b:Interaction.Behaviors>
                        <behaviors:FrameBehavior Parameter="{Binding PopupNavigationParameter, Mode=TwoWay}" Navigation="{Binding PopupNavigationSource, Mode=TwoWay}" />
                    </b:Interaction.Behaviors>
                </Frame>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
