<UserControl x:Class="RaywattApp.Views.Controls.EditVessProcPopupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border CornerRadius="5" BorderBrush="Blue" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="5">
                <TextBlock Text="{Binding LayerPopupTitle}" FontSize="25" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Row="1">
                <TextBlock Text="{Binding LayerPopupTitle}" Margin="5,5,5,5"/>
                <TextBox Text="{Binding EditPopupText}" Margin="5,5,5,5"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding PopupResponseCommand}" CommandParameter="N" Content="{Binding [Cancel], Source={StaticResource L10N}}" Grid.Row="1" Width="50" Margin="5"/>
                <Button Command="{Binding PopupResponseCommand}" CommandParameter="Y" Content="{Binding [OK], Source={StaticResource L10N}}" Grid.Row="1" Width="50" Margin="5" Background="Black" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
