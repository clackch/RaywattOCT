<Page x:Class="RaywattApp.Views.Setting.SettingAboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RaywattApp.Views.Setting"
      xmlns:const="clr-namespace:RaywattApp.Common.Bases"
      mc:Ignorable="d" 
      Width="{x:Static const:Constants.SettingInsideDialogWidth}" Height="{x:Static const:Constants.SettingInsideDialogHeight}"
      Title="SettingAboutPage">

    <Grid>
        <Border Grid.Row="0" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource GrayscaleGray7Brush}" Background="{DynamicResource GrayscaleGray8Brush}">
            <StackPanel Margin="20">
                <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Software Name], Source={StaticResource L10N}}"/>
                <StackPanel Height="5"/>
                <Label Style="{DynamicResource Pretendard-Medium-20}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding SoftwareName}"/>

                <StackPanel Height="25"/>

                <Grid>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [Software Version], Source={StaticResource L10N}}"/>
                        <StackPanel Height="5"/>
                        <Label Style="{DynamicResource Pretendard-Medium-20}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding SoftwareVersion}"/>
                    </StackPanel>
                    <Button Style="{StaticResource OutlinedBtnType3-Medium}" Height="40" Command="{Binding SoftwareUpdateCommand}" Content="{Binding [Software Update], Source={StaticResource L10N}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Height="25"/>

                <Grid>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [RJ Version], Source={StaticResource L10N}}"/>
                        <StackPanel Height="5"/>
                        <Label Style="{DynamicResource Pretendard-Medium-20}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding RjVersion}"/>
                    </StackPanel>
                    <Button Style="{StaticResource OutlinedBtnType3-Medium}" Height="40" Command="{Binding RJUpdateCommand}" Content="{Binding [RJ Update], Source={StaticResource L10N}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Height="25"/>

                <Grid>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}" Content="{Binding [CM Version], Source={StaticResource L10N}}"/>
                        <StackPanel Height="5"/>
                        <Label Style="{DynamicResource Pretendard-Medium-20}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="{Binding CmVersion}"/>
                    </StackPanel>
                    <Button Style="{StaticResource OutlinedBtnType3-Medium}" Height="40" Command="{Binding CMUpdateCommand}" Content="{Binding [CM Update], Source={StaticResource L10N}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
