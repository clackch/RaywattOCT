<Page x:Class="RaywattApp.Views.Setting.SettingPhysicianPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RaywattApp.Views.Setting"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      mc:Ignorable="d" 
      d:DesignHeight="820" d:DesignWidth="1000"
      Title="SettingPhysicianPage">

    <Grid Height="800">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Background="Gray">
            <Label Content="{Binding [Physician], Source={StaticResource L10N}}"></Label>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource ButtonBasic}" Width="20" Command="{Binding RowAddCommand}" CommandParameter="{Binding ElementName=physicianList}" Content="+"/>
            <Button Style="{StaticResource ButtonBasic}" Width="20" Command="{Binding RowDeleteCommand}" CommandParameter="{Binding ElementName=physicianList, Path=SelectedItem}" Content="-"/>
        </StackPanel>

        <DataGrid Grid.Row="2" Name="physicianList" ItemsSource="{Binding PhysicianList, Mode=TwoWay, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=True}"  Style="{StaticResource DataGridBasic}" SelectionMode="Single" IsReadOnly="False">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="BeginningEdit">
                    <i:InvokeCommandAction Command="{Binding BeginningEditCommand}" CommandParameter="{Binding ElementName=physicianList}"/>
                </i:EventTrigger>
                <i:EventTrigger EventName="RowEditEnding">
                    <i:InvokeCommandAction Command="{Binding RowEditEndingCommand}" CommandParameter="{Binding ElementName=physicianList}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <DataGrid.Columns>
                <DataGridTextColumn Width="*" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="{Binding [Name], Source={StaticResource L10N}}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" >
            <Button Style="{StaticResource ButtonBasic}" Width="50" Command="{Binding RefreshCommand}" Content="{Binding [Refresh], Source={StaticResource L10N}}"/>
            <Button Style="{StaticResource ButtonBasic}" Width="50" Command="{Binding CancelCommand}" Content="{Binding [Cancel], Source={StaticResource L10N}}"/>
            <Button Style="{StaticResource ButtonBasic}" Width="50" Command="{Binding OkayCommand}" Content="{Binding [OK], Source={StaticResource L10N}}"/>
            <Button Style="{StaticResource ButtonImportant}" Width="50" Command="{Binding ApplyCommand}" Content="{Binding [Apply], Source={StaticResource L10N}}"/>
        </StackPanel>
    </Grid>
</Page>
