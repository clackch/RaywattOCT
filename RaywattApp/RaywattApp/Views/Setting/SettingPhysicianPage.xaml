<Page x:Class="RaywattApp.Views.Setting.SettingPhysicianPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RaywattApp.Views.Setting"
      xmlns:const="clr-namespace:RaywattApp.Common.Bases"
      mc:Ignorable="d" 
      Width="{x:Static const:Constants.SettingInsideDialogWidth}" Height="{x:Static const:Constants.SettingInsideDialogHeight}"
      Title="SettingPhysicianPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="413"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="113"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <FrameworkElement x:Name="ProxyElement" Visibility="Collapsed"/>

        <DataGrid Grid.Row="0" Name="physicianList" ItemsSource="{Binding PhysicianList}" Style="{StaticResource DataGridDialog}" RowStyle="{StaticResource DataGridRowDialog}" ColumnHeaderStyle="{StaticResource DataGridColumnHeaderDialogLeft}" SelectionMode="Single">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding GridDoubleClickCommand}" CommandParameter="{Binding ElementName=physicianList, Path=CurrentItem}"/>
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn CellStyle="{StaticResource DataGridCellTooltipLeft}" Width="*" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="{Binding [Name], Source={StaticResource L10N}}" />
                <DataGridTemplateColumn CellStyle="{StaticResource DataGridCellDelete}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource DataGridDelete}" Command="{Binding DataContext.RowDeleteCommand, Source={x:Reference ProxyElement}}" CommandParameter="{Binding ElementName=physicianList, Path=CurrentItem}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                <Label Style="{DynamicResource Pretendard-Medium-16}" Foreground="{DynamicResource GrayscaleGray3Brush}">
                    <Label.Content>
                        <AccessText TextWrapping="Wrap" Text="{Binding [Add Physician], Source={StaticResource L10N}}"/>
                    </Label.Content>
                </Label>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBox Style="{DynamicResource TextBoxValidator}" Width="360" Text="{Binding NewPhysician.Name, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding [Enter Physician Name], Source={StaticResource L10N}}" ToolTip="{Binding NewPhysician.ValidateName}"/>
                <StackPanel Width="10"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2">
                <Button Style="{StaticResource OutlinedBtnType3-Large}" Width="72" Height="54" Command="{Binding RowAddCommand}" Content="{Binding [Add], Source={StaticResource L10N}}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource OutlinedBtnType3-Large}" Command="{Binding ApplyCommand}" Content="{Binding [Apply], Source={StaticResource L10N}}"/>
            <StackPanel Width="16"/>
            <Button Style="{StaticResource ContainedBtnType1-Large-Wide}" Command="{Binding OkayCommand}" Content="{Binding [OK], Source={StaticResource L10N}}"/>
        </StackPanel>
    </Grid>
</Page>
