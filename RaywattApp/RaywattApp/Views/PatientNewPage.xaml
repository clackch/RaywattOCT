<Page x:Class="RaywattApp.Views.PatientNewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RaywattApp.Views"
      xmlns:const="clr-namespace:RaywattApp.Common.Bases"
      mc:Ignorable="d" 
      d:DesignHeight="1024" d:DesignWidth="1280"
      Title="PatientNewPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="60" Background="#232323">
            <Label Style="{DynamicResource Pretendard-Medium-18}" Foreground="#b1b1b1" Margin="75,20,0,19" Content="{Binding [Add Patient], Source={StaticResource L10N}}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="436"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="436"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="237"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Grid.Column="1" Style="{DynamicResource Pretendard-Bold-32}" Foreground="#ffffff" Content="{Binding [Add Patient], Source={StaticResource L10N}}"/>
            <Label Grid.Row="2" Grid.Column="1" Style="{DynamicResource Pretendard-Medium-16}" Foreground="#ffffff" Content="{Binding [ID], Source={StaticResource L10N}}"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Patient.Id, UpdateSourceTrigger=PropertyChanged}" Margin="5,5,5,5"/>
            <Label Grid.Row="4" Grid.Column="1" Style="{DynamicResource Pretendard-Medium-16}" Foreground="#ffffff" Content="{Binding [Last Name], Source={StaticResource L10N}}"/>
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Patient.Lastname, UpdateSourceTrigger=PropertyChanged}" Margin="5,5,5,5"/>
            <Label Grid.Row="6" Grid.Column="1" Style="{DynamicResource Pretendard-Medium-16}" Foreground="#ffffff" Content="{Binding [First Name], Source={StaticResource L10N}}"/>
            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Patient.Firstname, UpdateSourceTrigger=PropertyChanged}" Margin="5,5,5,5"/>
            <Label Grid.Row="8" Grid.Column="1" Style="{DynamicResource Pretendard-Medium-16}" Foreground="#ffffff" Content="{Binding [Birth Date], Source={StaticResource L10N}}"/>
            <DatePicker Grid.Row="9" Grid.Column="1" SelectedDate="{Binding Patient.Birthdate, UpdateSourceTrigger=PropertyChanged}" Margin="5,5,5,5"/>
            <Label Grid.Row="10" Grid.Column="1" Style="{DynamicResource Pretendard-Medium-16}" Foreground="#ffffff" Content="{Binding [Gender], Source={StaticResource L10N}}"/>
            <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal" Margin="5,5,5,5">
                <RadioButton IsChecked="{Binding GenderCode, Converter={StaticResource RadioButtonConverter}, ConverterParameter={x:Static const:Constants.GenderMale}}" Content="{Binding [Male], Source={StaticResource L10N}}"></RadioButton>
                <RadioButton IsChecked="{Binding GenderCode, Converter={StaticResource RadioButtonConverter}, ConverterParameter={x:Static const:Constants.GenderFemale}}" Content="{Binding [Female], Source={StaticResource L10N}}"></RadioButton>
            </StackPanel>
            <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource OutlinedBtnType1-Large}" Command="{Binding CancelCommand}" Content="{Binding [Cancel], Source={StaticResource L10N}}"/>
                <Button Style="{StaticResource ButtonImportant}" Command="{Binding NewRecordingCommand}" Content="{Binding [New Recording], Source={StaticResource L10N}}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Height="40" Background="#0d0d0d"/>

    </Grid>
</Page>
