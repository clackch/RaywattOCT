<UserControl x:Class="RaywattApp.Views.Component.IpAddressInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaywattApp.Views.Component"
             mc:Ignorable="d" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Border x:Name="IpAddressBorder" Height="54" CornerRadius="8" BorderBrush="{DynamicResource GrayscaleGray5Brush}" BorderThickness="1" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Top">
                <TextBox x:Name="Octet1TextBox" Style="{DynamicResource TextBoxIpAddress}" VerticalContentAlignment="Bottom" GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus" TextChanged="OnTextChanged" PreviewTextInput="TextBox_PreviewTextInput"/>
                <Label Style="{DynamicResource Pretendard-Medium-18}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="." Height="38" VerticalAlignment="Top" VerticalContentAlignment="Bottom"/>
                <TextBox x:Name="Octet2TextBox" Style="{DynamicResource TextBoxIpAddress}" VerticalContentAlignment="Bottom" GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus" TextChanged="OnTextChanged" PreviewTextInput="TextBox_PreviewTextInput"/>
                <Label Style="{DynamicResource Pretendard-Medium-18}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="." Height="38" VerticalAlignment="Top" VerticalContentAlignment="Bottom"/>
                <TextBox x:Name="Octet3TextBox" Style="{DynamicResource TextBoxIpAddress}" VerticalContentAlignment="Bottom" GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus" TextChanged="OnTextChanged" PreviewTextInput="TextBox_PreviewTextInput"/>
                <Label Style="{DynamicResource Pretendard-Medium-18}" Foreground="{DynamicResource GrayscaleWhiteBrush}" Content="." Height="38" VerticalAlignment="Top" VerticalContentAlignment="Bottom"/>
                <TextBox x:Name="Octet4TextBox" Style="{DynamicResource TextBoxIpAddress}" VerticalContentAlignment="Bottom" GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus" TextChanged="OnTextChanged" PreviewTextInput="TextBox_PreviewTextInput"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" x:Name="Validator" Orientation="Horizontal" Visibility="Collapsed" Margin="0,4,0,0">
            <Label Content="* " Foreground="{DynamicResource AdditionalColor3Brush}" FontSize="12"/>
            <Label Content="{Binding ToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource AdditionalColor3Brush}" FontSize="12"/>
        </StackPanel>
    </Grid>
</UserControl>
